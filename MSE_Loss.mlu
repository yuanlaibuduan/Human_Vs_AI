#include <bang.h>
#include <cnrt.h>
#include <torch/extension.h>

#define CHUNK_SIZE 4096
#define TASK_NUM 4

__mlu_entry__ void mse_partial_sum_kernel(
    const float *predictions,
    const float *targets,
    float *partial_sums,
    int total) {

    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;
    uint32_t per_core = total / core_num;
    uint32_t remainder = total % core_num;
    uint32_t start = core_id * per_core + (core_id < remainder ? core_id : remainder);
    uint32_t count = per_core + (core_id < remainder ? 1 : 0);

    __nram__ float nram_pred[CHUNK_SIZE];
    __nram__ float nram_target[CHUNK_SIZE];
    __nram__ float nram_diff[CHUNK_SIZE];

    float local_sum = 0.0f;
    for (uint32_t offset = 0; offset < count; offset += CHUNK_SIZE) {
        uint32_t len = (offset + CHUNK_SIZE <= count) ? CHUNK_SIZE : (count - offset);
        uint32_t aligned_len = (len + 63) & ~63;

        __memcpy(nram_pred,
                 predictions + start + offset,
                 len * sizeof(float),
                 GDRAM2NRAM);
        __memcpy(nram_target,
                 targets + start + offset,
                 len * sizeof(float),
                 GDRAM2NRAM);

        __bang_sub(nram_diff, nram_pred, nram_target, aligned_len);
        __bang_mul(nram_diff, nram_diff, nram_diff, aligned_len);

        for (uint32_t i = 0; i < len; ++i) {
            local_sum += nram_diff[i];
        }
    }

    partial_sums[core_id] = local_sum;
}

__mlu_entry__ void mse_final_kernel(
    const float *partial_sums,
    float *loss,
    int total,
    int partial_count) {

    float sum = 0.0f;
    for (int i = 0; i < partial_count; ++i) {
        sum += partial_sums[i];
    }
    loss[0] = sum / static_cast<float>(total);
}

torch::Tensor bang_func(torch::Tensor predictions, torch::Tensor targets) {
    TORCH_CHECK(predictions.is_contiguous(), "predictions must be contiguous");
    TORCH_CHECK(targets.is_contiguous(), "targets must be contiguous");
    TORCH_CHECK(predictions.dim() == 2, "predictions must be 2D [batch, dim]");
    TORCH_CHECK(targets.sizes() == predictions.sizes(), "targets must have same shape as predictions");

    auto pred_fp32 = predictions.to(torch::kFloat);
    auto target_fp32 = targets.to(torch::kFloat);
    auto partial_sums = torch::empty({TASK_NUM}, pred_fp32.options());
    auto loss = torch::empty({}, pred_fp32.options());

    int total = static_cast<int>(pred_fp32.numel());
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    cnrtDim3_t partial_dim = {TASK_NUM, 1, 1};
    mse_partial_sum_kernel<<<partial_dim, ktype, queue>>>(
        pred_fp32.data_ptr<float>(),
        target_fp32.data_ptr<float>(),
        partial_sums.data_ptr<float>(),
        total);

    cnrtDim3_t final_dim = {1, 1, 1};
    mse_final_kernel<<<final_dim, ktype, queue>>>(
        partial_sums.data_ptr<float>(),
        loss.data_ptr<float>(),
        total,
        TASK_NUM);

    return loss;
}