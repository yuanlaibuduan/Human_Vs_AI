// 提示：4096 作为 CHUNK_SIZE 偏小（仅占用 16KB NRAM），可以适当调大至 16384 提升访存吞吐
#define CHUNK_SIZE 4096 
// 适当调大了分块大小以提升 NRAM 访存吞吐
#define CHUNK_SIZE 16384 

__mlu_entry__ void mse_kernel(
    float* predictions,
@@ -17,67 +17,61 @@ __mlu_entry__ void mse_kernel(
    uint32_t per_core = total / core_num;
    uint32_t remainder = total % core_num;

    uint32_t start =
        core_id * per_core +
        (core_id < remainder ? core_id : remainder);

    uint32_t count =
        per_core +
        (core_id < remainder ? 1 : 0);
    uint32_t start = core_id * per_core + (core_id < remainder ? core_id : remainder);
    uint32_t count = per_core + (core_id < remainder ? 1 : 0);

    __nram__ float nram_pred[CHUNK_SIZE];
    __nram__ float nram_target[CHUNK_SIZE];
    __nram__ float nram_diff[CHUNK_SIZE];

    for(uint32_t offset = 0;
        offset < count;
        offset += CHUNK_SIZE) {

        uint32_t len =
            (offset + CHUNK_SIZE <= count)
                ? CHUNK_SIZE
                : (count - offset);
    for(uint32_t offset = 0; offset < count; offset += CHUNK_SIZE) {

        uint32_t aligned_len =
            (len + 63) & ~63;
        uint32_t len = (offset + CHUNK_SIZE <= count) ? CHUNK_SIZE : (count - offset);
        uint32_t aligned_len = (len + 63) & ~63;

        __memcpy(
            nram_pred,
            predictions + start + offset,
            len * sizeof(float),
            GDRAM2NRAM);
            GDRAM2NRAM
        );

        __memcpy(
            nram_target,
            targets + start + offset,
            len * sizeof(float),
            GDRAM2NRAM);
            GDRAM2NRAM
        );

        // diff = pred - target
        __bang_sub(
            nram_diff,
            nram_pred,
            nram_target,
            aligned_len);
            aligned_len
        );

        // diff^2
        __bang_mul(
            nram_diff,
            nram_diff,
            nram_diff,
            aligned_len);
            aligned_len
        );

        // 只写回实际有效的数据长度 (len)，避免把 padding 的脏数据写回全局内存
        // 只写回实际有效的数据长度 (len)，规避脏数据越界
        __memcpy(
            output + start + offset,
            nram_diff,
            len * sizeof(float),
            NRAM2GDRAM);
            NRAM2GDRAM
        );
    }
}

