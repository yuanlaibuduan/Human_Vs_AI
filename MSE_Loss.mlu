    // 执行归约求均值，将矩阵形状压缩为框架要求的标量 ()
    auto loss_mean = output_fp32.mean();

    // 恢复原始数据类型返回
    if (original_dtype != torch::kFloat) {
        return output_fp32.to(original_dtype);
        return loss_mean.to(original_dtype);
