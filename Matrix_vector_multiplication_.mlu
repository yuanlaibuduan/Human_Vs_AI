#include <bang.h>
#include <cnrt.h>
#include <torch/extension.h>

#define CHUNK_SIZE 4096   // 每次处理向量的分块大小
#define ALIGN_SIZE 64     // 对齐字节数 (64 * sizeof(float))

// 核函数：矩阵 (M, K) 乘向量 (K, 1) -> 向量 (M, 1)
__mlu_entry__ void gemv_kernel(float* A, float* B, float* C, int M, int K) {
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;

    // 分配每个 core 处理的行范围
    int rows_per_core = M / core_num;
    int remainder = M % core_num;
    int start_row = core_id * rows_per_core + (core_id < remainder ? core_id : remainder);
    int end_row = start_row + rows_per_core + (core_id < remainder ? 1 : 0);

    // NRAM 缓冲区
    __nram__ float nram_A[CHUNK_SIZE];
    __nram__ float nram_B[CHUNK_SIZE];
    __nram__ float nram_prod[CHUNK_SIZE];

    for (int row = start_row; row < end_row; ++row) {
        float sum = 0.0f;
        float* A_row = A + row * K;

        // 分块计算点积
        for (int k = 0; k < K; k += CHUNK_SIZE) {
            int len = CHUNK_SIZE;
            if (k + len > K) len = K - k;
            int aligned_len = (len + ALIGN_SIZE - 1) & ~(ALIGN_SIZE - 1);

            // 从全局内存加载 A 的当前块
            __memcpy(nram_A, A_row + k, len * sizeof(float), GDRAM2NRAM);
            // 从全局内存加载 B 的当前块
            __memcpy(nram_B, B + k, len * sizeof(float), GDRAM2NRAM);

            // 将多余部分清零，避免 reduce sum 时引入垃圾值
            if (aligned_len > len) {
                __bang_write_zero(nram_A + len, aligned_len - len);
                __bang_write_zero(nram_B + len, aligned_len - len);
            }

            // 逐元素相乘：prod = A * B
            __bang_mul(nram_prod, nram_A, nram_B, aligned_len);

            // 将乘积向量求和得到块内部分和
            float block_sum = 0.0f;
            __bang_reduce_sum(&block_sum, nram_prod, aligned_len);
            sum += block_sum;
        }
        C[row] = sum;   // 输出向量 C 形状 [M, 1]
    }
}

// 对外接口函数
torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
    // 输入检查
    TORCH_CHECK(A.is_contiguous(), "A must be contiguous");
    TORCH_CHECK(B.is_contiguous(), "B must be contiguous");
    TORCH_CHECK(A.dim() == 2, "A must be 2D matrix [M, K]");
    TORCH_CHECK(B.dim() == 2 && B.size(1) == 1, "B must be 2D vector [K, 1]");
    TORCH_CHECK(A.size(1) == B.size(0), "Inner dimensions must match: A.shape[1] == B.shape[0]");

    // 获取形状
    int M = A.size(0);
    int K = A.size(1);

    // 转换为 float32 进行内部计算 (根据题目要求)
    auto original_dtype = A.scalar_type();
    torch::Tensor A_fp32 = (original_dtype == torch::kFloat) ? A : A.to(torch::kFloat);
    torch::Tensor B_fp32 = (original_dtype == torch::kFloat) ? B : B.to(torch::kFloat);

    // 分配输出张量 [M, 1]
    torch::Tensor C_fp32 = torch::empty({M, 1}, A_fp32.options());

    // 获取 MLU 队列
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    // 设置核函数启动维度（这里使用 4 个 Union1 核，可根据实际硬件调整）
    cnrtDim3_t dim = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    // 启动核函数
    gemv_kernel<<<dim, ktype, queue>>>(
        A_fp32.data_ptr<float>(),
        B_fp32.data_ptr<float>(),
        C_fp32.data_ptr<float>(),
        M, K
    );

    // 将结果转回原始数据类型
    if (original_dtype != torch::kFloat) {
        return C_fp32.to(original_dtype);
    }
    return C_fp32;
}