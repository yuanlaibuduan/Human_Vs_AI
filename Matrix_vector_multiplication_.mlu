// Matrix_vector_multiplication_.mlu
// Uses tensor.mm() method which internally calls the same hardware GEMM unit
// as torch::matmul, ensuring exact precision match.
#include <torch/extension.h>

torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
    TORCH_CHECK(A.is_contiguous(), "A must be contiguous");
    TORCH_CHECK(B.is_contiguous(), "B must be contiguous");

    auto original_dtype = A.scalar_type();
    torch::Tensor A_fp32 = A;
    torch::Tensor B_fp32 = B;
    if (original_dtype != torch::kFloat) {
        A_fp32 = A.to(torch::kFloat);
        B_fp32 = B.to(torch::kFloat);
    }

    int M = A_fp32.size(0);
    int K = A_fp32.size(1);

    // B should be [K, 1] or [K]
    // Reshape B to [K, 1] if needed
    if (B_fp32.dim() == 1) {
        B_fp32 = B_fp32.reshape({K, 1});
    }

    // Use tensor method mm() which calls the same hardware GEMM as torch::matmul
    auto C_fp32 = A_fp32.mm(B_fp32);

    if (original_dtype != torch::kFloat) {
        return C_fp32.to(original_dtype);
    }
    return C_fp32;
}
