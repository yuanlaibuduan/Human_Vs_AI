// 023_Matrix_vector_multiplication_.mlu
#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

#define CHUNK_SIZE 4096   // 分块大小，必须是64的倍数以利用向量指令

// ------------------------------------------------------------
// 核函数：矩阵向量乘法 C = A * B
// A: [M, K] 行优先存储
// B: [K, 1] 连续存储
// C: [M, 1] 输出
// ------------------------------------------------------------
__mlu_entry__ void gemv_kernel(float* A, float* B, float* C, int M, int K) {
    // 获取当前 core 的 ID 和总 core 数量
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;

    // 将 M 行分配给各个 core
    uint32_t per_core = M / core_num;
    uint32_t remainder = M % core_num;
    uint32_t start_row = core_id * per_core + (core_id < remainder ? core_id : remainder);
    uint32_t num_rows = per_core + (core_id < remainder ? 1 : 0);

    if (num_rows == 0) return;

    // NRAM 缓冲区：
    //   B_chunk  / A_chunk : 从全局内存加载的数据块
    //   mul_temp          : 向量乘法的临时结果
    __nram__ float B_chunk[CHUNK_SIZE];
    __nram__ float A_chunk[CHUNK_SIZE];
    __nram__ float mul_temp[CHUNK_SIZE];

    // 对当前 core 负责的每一行进行计算
    for (uint32_t i = 0; i < num_rows; ++i) {
        uint32_t row = start_row + i;
        float acc = 0.0f;

        // 按块处理列维度
        for (uint32_t k_start = 0; k_start < K; k_start += CHUNK_SIZE) {
            uint32_t cur_len = (k_start + CHUNK_SIZE <= K) ? CHUNK_SIZE : (K - k_start);
            // 对齐到 64 的倍数，以满足 __bang_mul 的向量化要求
            uint32_t aligned_len = (cur_len + 63) & ~63;

            // 从全局内存加载 B 和 A 的当前块
            __memcpy(B_chunk, B + k_start, cur_len * sizeof(float), GDRAM2NRAM);
            __memcpy(A_chunk, A + row * K + k_start, cur_len * sizeof(float), GDRAM2NRAM);

            // 向量化乘法：一次完成 aligned_len 个元素的逐元素乘
            // 注意：aligned_len 可能比 cur_len 大，多出的元素在 mul_temp 中为垃圾值，
            //       但后续标量循环只累加前 cur_len 个元素，因此不影响正确性。
            __bang_mul(mul_temp, A_chunk, B_chunk, aligned_len);

            // 标量归约：累加当前块的所有有效元素
            for (uint32_t j = 0; j < cur_len; ++j) {
                acc += mul_temp[j];
            }
        }

        // 将结果写回全局内存
        C[row] = acc;
    }
}

// ------------------------------------------------------------
// 外部调用接口
// 输入：A (M, K), B (K, 1)
// 输出：C (M, 1)
// ------------------------------------------------------------
torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
    // 检查张量是否连续
    TORCH_CHECK(A.is_contiguous(), "A must be contiguous");
    TORCH_CHECK(B.is_contiguous(), "B must be contiguous");

    // 转换为 float32 类型
    torch::Tensor A_fp32 = A;
    torch::Tensor B_fp32 = B;
    if (A.scalar_type() != torch::kFloat) {
        A_fp32 = A.to(torch::kFloat);
    }
    if (B.scalar_type() != torch::kFloat) {
        B_fp32 = B.to(torch::kFloat);
    }

    // 获取矩阵尺寸
    int M = A_fp32.size(0);
    int K = A_fp32.size(1);
    TORCH_CHECK(B_fp32.size(0) == K && B_fp32.size(1) == 1,
                "B shape must be (K, 1)");

    // 分配输出张量，形状 (M, 1)
    torch::Tensor C_fp32 = torch::empty({M, 1}, torch::dtype(torch::kFloat).device(A.device()));

    // 获取当前 MLU 流（队列）
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    // 配置核函数启动参数，使用 16 个 core
    cnrtDim3_t dim = {16, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    // 启动核函数
    gemv_kernel<<<dim, ktype, queue>>>(
        A_fp32.data_ptr<float>(),
        B_fp32.data_ptr<float>(),
        C_fp32.data_ptr<float>(),
        M, K
    );

    // 返回结果
    return C_fp32;
}
