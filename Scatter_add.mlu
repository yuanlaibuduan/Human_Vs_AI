#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <stdint.h>

#define MAX_D 256
#define ALIGN_UP_64(x) (((x) + 63) & ~63)

__mlu_entry__ void scatter_add_dim0_kernel(
    float *src,
    int64_t *index,
    float *output,
    int n_rows,
    int d_cols,
    int dim_size) {

    __nram__ float acc[MAX_D + 64];
    __nram__ float tmp[MAX_D + 64];

    int aligned_d = ALIGN_UP_64(d_cols);

    for (int dst = taskId; dst < dim_size; dst += taskDim) {
        __bang_write_zero(acc, aligned_d);

        for (int row = 0; row < n_rows; ++row) {
            if ((int)index[row] == dst) {
                __bang_write_zero(tmp, aligned_d);
                __memcpy(
                    tmp,
                    src + row * d_cols,
                    d_cols * sizeof(float),
                    GDRAM2NRAM);
                __bang_add(acc, acc, tmp, aligned_d);
            }
        }

        __memcpy(
            output + dst * d_cols,
            acc,
            d_cols * sizeof(float),
            NRAM2GDRAM);
    }
}

torch::Tensor bang_func(torch::Tensor src, torch::Tensor index, int dim_size) {
    TORCH_CHECK(src.dim() == 2, "src must be a 2D tensor");
    TORCH_CHECK(index.dim() == 1, "index must be a 1D tensor");
    TORCH_CHECK(src.size(0) == index.size(0), "src and index row mismatch");
    TORCH_CHECK(src.size(1) <= MAX_D, "src.shape[1] exceeds MAX_D");
    TORCH_CHECK(dim_size > 0, "dim_size must be positive");

    auto original_dtype = src.scalar_type();
    torch::Tensor src_fp32 =
        original_dtype == torch::kFloat ? src.contiguous()
                                        : src.to(torch::kFloat).contiguous();
    torch::Tensor index_i64 =
        index.scalar_type() == torch::kLong ? index.contiguous()
                                            : index.to(torch::kLong).contiguous();

    int n_rows = src_fp32.size(0);
    int d_cols = src_fp32.size(1);
    torch::Tensor output_fp32 =
        torch::empty({dim_size, d_cols}, src_fp32.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t kdim = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    scatter_add_dim0_kernel<<<kdim, ktype, queue>>>(
        src_fp32.data_ptr<float>(),
        index_i64.data_ptr<int64_t>(),
        output_fp32.data_ptr<float>(),
        n_rows,
        d_cols,
        dim_size);

    if (original_dtype != torch::kFloat) {
        return output_fp32.to(original_dtype);
    }

    return output_fp32;
}
