#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

// 核函数：执行二维转置卷积（FP32）
__mlu_entry__ void conv_transpose2d_kernel(
    const float* input,          // 输入张量 [N, C_in, H_in, W_in]
    const float* weight,         // 权重张量 [C_in, C_out_g, K, K]
    const float* bias,           // 偏置张量 [C_out] (可为NULL)
    int N, int C_in, int H_in, int W_in,
    int C_out, int K,
    int stride, int padding, int output_padding, int groups,
    float* output,               // 输出张量 [N, C_out, H_out, W_out]
    int H_out, int W_out) {

    // 计算每组输入/输出通道数
    int C_out_per_group = C_out / groups;
    int C_in_per_group  = C_in / groups;

    // 输出总元素个数
    int total_out = N * C_out * H_out * W_out;

    // 多核任务拆分
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;
    uint32_t per_core = total_out / core_num;
    uint32_t remainder = total_out % core_num;
    uint32_t start = core_id * per_core + (core_id < remainder ? core_id : remainder);
    uint32_t count = per_core + (core_id < remainder ? 1 : 0);

    // 处理本core负责的连续输出元素
    for (uint32_t idx = start; idx < start + count; ++idx) {
        // 将一维索引解析为 (n, c_out, h_out, w_out)
        int n = idx / (C_out * H_out * W_out);
        int t = idx % (C_out * H_out * W_out);
        int c_out = t / (H_out * W_out);
        int t2 = t % (H_out * W_out);
        int h_out = t2 / W_out;
        int w_out = t2 % W_out;

        // 确定分组
        int group_id = c_out / C_out_per_group;
        int c_out_group = c_out % C_out_per_group;
        int c_in_start = group_id * C_in_per_group;
        int c_in_end   = c_in_start + C_in_per_group;

        float sum = 0.0f;

        // 遍历输入通道和卷积核
        for (int c_in = c_in_start; c_in < c_in_end; ++c_in) {
            for (int kh = 0; kh < K; ++kh) {
                for (int kw = 0; kw < K; ++kw) {
                    // 计算对应的输入空间位置 (h_in, w_in)
                    int h_in_num = h_out + padding - kh;
                    int w_in_num = w_out + padding - kw;
                    if (h_in_num % stride != 0 || w_in_num % stride != 0)
                        continue;
                    int h_in = h_in_num / stride;
                    int w_in = w_in_num / stride;
                    if (h_in >= 0 && h_in < H_in && w_in >= 0 && w_in < W_in) {
                        // 输入索引
                        int input_idx = ((n * C_in + c_in) * H_in + h_in) * W_in + w_in;
                        // 权重索引: [c_in, c_out_group, kh, kw]
                        int weight_idx = ((c_in * C_out_per_group + c_out_group) * K + kh) * K + kw;
                        sum += input[input_idx] * weight[weight_idx];
                    }
                }
            }
        }

        // 添加偏置（如果存在）
        if (bias != NULL) {
            sum += bias[c_out];
        }

        // 写回输出
        output[idx] = sum;
    }
}

// 对外接口函数
torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor kernel,
    int in_channels,
    int out_channels,
    int kernel_size,
    int stride,
    int padding,
    int output_padding,
    int groups,
    bool bias) {

    // 输入检查与类型转换（统一转为 FP32）
    auto original_dtype = x.scalar_type();
    x = x.contiguous();
    kernel = kernel.contiguous();

    torch::Tensor x_fp32 = (original_dtype == torch::kFloat) ? x : x.to(torch::kFloat);
    torch::Tensor kernel_fp32 = (kernel.scalar_type() == torch::kFloat) ? kernel : kernel.to(torch::kFloat);

    // 确保输入位于 MLU 设备上
    if (!x_fp32.device().is_mlu()) x_fp32 = x_fp32.to(torch::kMLU);
    if (!kernel_fp32.device().is_mlu()) kernel_fp32 = kernel_fp32.to(torch::kMLU);

    // 提取形状信息
    int N = x_fp32.size(0);
    int C_in = x_fp32.size(1);
    int H_in = x_fp32.size(2);
    int W_in = x_fp32.size(3);
    int C_out = out_channels;
    int K = kernel_size;

    // 计算输出空间尺寸
    int H_out = (H_in - 1) * stride - 2 * padding + K + output_padding;
    int W_out = (W_in - 1) * stride - 2 * padding + K + output_padding;

    // 分配输出张量 (MLU, FP32)
    torch::Tensor output_fp32 = torch::empty({N, C_out, H_out, W_out}, x_fp32.options().dtype(torch::kFloat));
    output_fp32 = output_fp32.to(torch::kMLU);

    // 准备偏置张量（如果需要）
    torch::Tensor bias_tensor;
    float* bias_ptr = nullptr;
    if (bias) {
        bias_tensor = torch::zeros({C_out}, x_fp32.options().dtype(torch::kFloat)).to(torch::kMLU);
        bias_ptr = bias_tensor.data_ptr<float>();
    }

    // 获取 MLU 队列
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    // 配置核函数启动参数（使用 4 个核心，可根据实际调整）
    cnrtDim3_t dim = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    // 启动核函数
    conv_transpose2d_kernel<<<dim, ktype, queue>>>(
        x_fp32.data_ptr<float>(),
        kernel_fp32.data_ptr<float>(),
        bias_ptr,
        N, C_in, H_in, W_in,
        C_out, K,
        stride, padding, output_padding, groups,
        output_fp32.data_ptr<float>(),
        H_out, W_out
    );

    // 将结果转回原始数据类型（如果输入不是 FP32）
    if (original_dtype != torch::kFloat) {
        return output_fp32.to(original_dtype);
    }
    return output_fp32;
}