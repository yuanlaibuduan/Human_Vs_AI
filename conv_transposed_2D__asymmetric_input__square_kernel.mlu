// conv_transposed_2D__asymmetric_input__square_kernel.cpp
#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

// Transposed 2D conv: stride=1, padding=0, kernel=[32,64,3,3], input=[16,32,128,256]
// Output: [16,64,130,258] (Hout=(Hin-1)*S+K=130, Wout=(Win-1)*S+K=258)
// Strategy: NRAM-tiled with zero-padded input + flipped kernel = standard conv
#define CIN_TILE  8
#define COUT_TILE 8
#define H_TILE    32
#define W_TILE    32
#define K         3
#define H_EXT     (H_TILE + K - 1)
#define W_EXT     (W_TILE + K - 1)
__mlu_entry__ void convtransp2d_kernel(float* input, float* kernel_gdr, float* output, int batch_size, int C_in, int C_out, int H_in, int W_in, int H_out, int W_out){ uint32_t core_id=taskId; uint32_t core_num=taskDim; uint32_t batches_per_core=batch_size/core_num; uint32_t batch_rem=batch_size%core_num; uint32_t start_batch=core_id*batches_per_core+(core_id<batch_rem?core_id:batch_rem); uint32_t my_batches=batches_per_core+(core_id<batch_rem?1:0); __nram__ float nram_in[CIN_TILE][H_EXT][W_EXT]; __nram__ float nram_acc[COUT_TILE][H_TILE][W_TILE]; __nram__ float nram_ktemp[CIN_TILE][K][K]; for(uint32_t b=0;b<my_batches;b++){ uint32_t batch=start_batch+b; float* batch_input=input+batch*C_in*H_in*W_in; float* batch_output=output+batch*C_out*H_out*W_out; for(uint32_t co_grp=0;co_grp<C_out;co_grp+=COUT_TILE){ uint32_t co_tile=(co_grp+COUT_TILE<=C_out)?COUT_TILE:(C_out-co_grp); for(uint32_t h_off=0;h_off<H_out;h_off+=H_TILE){ uint32_t h_tile=(h_off+H_TILE<=H_out)?H_TILE:(H_out-h_off); uint32_t h_ext=h_tile+K-1; for(uint32_t w_off=0;w_off<W_out;w_off+=W_TILE){ uint32_t w_tile=(w_off+W_TILE<=W_out)?W_TILE:(W_out-w_off); uint32_t w_ext=w_tile+K-1; for(uint32_t co=0;co<co_tile;co++)for(uint32_t i=0;i<h_tile;i++)for(uint32_t j=0;j<w_tile;j++)nram_acc[co][i][j]=0.0f; for(uint32_t ci_grp=0;ci_grp<C_in;ci_grp+=CIN_TILE){ uint32_t ci_tile=(ci_grp+CIN_TILE<=C_in)?CIN_TILE:(C_in-ci_grp); for(uint32_t ci=0;ci<ci_tile;ci++){ uint32_t gci=ci_grp+ci; for(uint32_t co=0;co<co_tile;co++){ uint32_t gco=co_grp+co; for(uint32_t kh=0;kh<K;kh++)for(uint32_t kw=0;kw<K;kw++)nram_ktemp[ci][kh][kw]=kernel_gdr[(gci*C_out+gco)*K*K+(K-1-kh)*K+(K-1-kw)];} for(uint32_t i=0;i<h_ext;i++)for(uint32_t j=0;j<w_ext;j++)nram_in[ci][i][j]=0.0f; int p_rs=(int)h_off,p_re=(int)(h_off+h_ext-1),v_s=K-1,v_e=K-1+H_in-1,cs=(p_rs>v_s?p_rs:v_s),ce=(p_re<v_e?p_re:v_e); for(int r=cs;r<=ce;r++){ int in_r=r-(K-1),p_cs=(int)w_off,p_ce=(int)(w_off+w_ext-1),w_vs=K-1,w_ve=K-1+W_in-1,wcs=(p_cs>w_vs?p_cs:w_vs),wce=(p_ce<w_ve?p_ce:w_ve); if(wcs<=wce)__memcpy(&nram_in[ci][r-(int)h_off][wcs-(int)w_off],batch_input+gci*H_in*W_in+in_r*W_in+(wcs-(K-1)),(wce-wcs+1)*sizeof(float),GDRAM2NRAM);}} for(uint32_t co=0;co<co_tile;co++)for(uint32_t ci=0;ci<ci_tile;ci++)for(uint32_t kh=0;kh<K;kh++)for(uint32_t kw=0;kw<K;kw++){ float wk=nram_ktemp[ci][kh][kw]; for(uint32_t hi=0;hi<h_tile;hi++)for(uint32_t wi=0;wi<w_tile;wi++)nram_acc[co][hi][wi]+=wk*nram_in[ci][hi+kh][wi+kw];}} for(uint32_t co=0;co<co_tile;co++){ uint32_t gco=co_grp+co; for(uint32_t hi=0;hi<h_tile;hi++)__memcpy(batch_output+gco*H_out*W_out+(h_off+hi)*W_out+w_off,nram_acc[co][hi],w_tile*sizeof(float),NRAM2GDRAM);}}}}}
torch::Tensor bang_func(torch::Tensor x, torch::Tensor kernel, int in_channels, int out_channels, int kernel_size){ TORCH_CHECK(x.is_contiguous(),"Input must be contiguous"); TORCH_CHECK(kernel.is_contiguous(),"Kernel must be contiguous"); auto odt=x.scalar_type(); torch::Tensor ifp=x,kfp=kernel; if(odt!=torch::kFloat){ifp=x.to(torch::kFloat);kfp=kernel.to(torch::kFloat);} int B=ifp.size(0),CI=ifp.size(1),HI=ifp.size(2),WI=ifp.size(3),CO=out_channels,K=kernel_size; int HO=(HI-1)+K,WO=(WI-1)+K; auto ofp=torch::empty({B,CO,HO,WO},ifp.options()); cnrtQueue_t queue=torch_mlu::getCurMLUStream(); cnrtDim3_t dim={4,1,1}; convtransp2d_kernel<<<dim,cnrtFuncTypeUnion1,queue>>>(ifp.data_ptr<float>(),kfp.data_ptr<float>(),ofp.data_ptr<float>(),B,CI,CO,HI,WI,HO,WO); if(odt!=torch::kFloat)return ofp.to(odt); return ofp; }rt)?p_row_start:valid_start; int copy_end=(p_row_end<valid_end)?p_row_end:valid_end; for(int r=copy_start;r<=copy_end;r++){ int in_r=r-(K-1); int p_col_start=(int)w_off; int p_col_end=(int)(w_off+w_ext-1); int w_valid_start=K-1; int w_valid_end=K-1+W_in-1; int w_copy_start=(p_col_start>w_valid_start)?p_col_start:w_valid_start; int w_copy_end=(p_col_end<w_valid_end)?p_col_end:w_valid_end; if(w_copy_start<=w_copy_end){ int in_c=w_copy_start-(K-1); int copy_len=w_copy_end-w_copy_start+1; __memcpy(&nram_in[ci][r-(int)h_off][w_copy_start-(int)w_off],batch_input+gci*H_in*W_in+in_r*W_in+in_c,copy_len*sizeof(float),GDRAM2NRAM);}}}for(uint32_t co=0;co<co_tile;co++)for(uint32_t ci=0;ci<ci_tile;ci++)for(uint32_t kh=0;kh<K;kh++)for(uint32_t kw=0;kw<K;kw++){float wk=nram_ktemp[ci][kh][kw];for(uint32_t hi=0;hi<h_tile;hi++)for(uint32_t wi=0;wi<w_tile;wi++)nram_acc[co][hi][wi]+=wk*nram_in[ci][hi+kh][wi+kw];}}}for(uint32_t co=0;co<co_tile;co++){uint32_t gco=co_grp+co;for(uint32_t hi=0;hi<h_tile;hi++)__memcpy(batch_output+gco*H_out*W_out+(h_off+hi)*W_out+w_off,nram_acc[co][hi],w_tile*sizeof(float),NRAM2GDRAM);}}}}}}}
