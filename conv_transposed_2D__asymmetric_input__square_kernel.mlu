#include <bang.h>
#include <cnrt.h>
#include <torch/extension.h>

__mlu_entry__ void conv_transpose2d_kernel(const float* input,
                                           const float* weight,
                                           float* output,
                                           int batch,
                                           int in_channels,
                                           int h_in,
                                           int w_in,
                                           int out_channels,
                                           int kernel_size,
                                           int stride,
                                           int padding,
                                           int output_padding,
                                           int groups,
                                           int h_out,
                                           int w_out) {
    int total = batch * out_channels * h_out * w_out;
    int core_id = taskId;
    int core_num = taskDim;

    int out_channels_per_group = out_channels / groups;
    int in_channels_per_group = in_channels / groups;

    for (int idx = core_id; idx < total; idx += core_num) {
        int tmp = idx;
        int ow = tmp % w_out;
        tmp /= w_out;
        int oh = tmp % h_out;
        tmp /= h_out;
        int oc = tmp % out_channels;
        int n = tmp / out_channels;

        int group_id = oc / out_channels_per_group;
        int oc_in_group = oc - group_id * out_channels_per_group;
        int ic_begin = group_id * in_channels_per_group;
        int ic_end = ic_begin + in_channels_per_group;

        float sum = 0.0f;
        for (int ic = ic_begin; ic < ic_end; ++ic) {
            for (int kh = 0; kh < kernel_size; ++kh) {
                int ih_num = oh + padding - kh;
                if (ih_num % stride != 0) {
                    continue;
                }
                int ih = ih_num / stride;
                if (ih < 0 || ih >= h_in) {
                    continue;
                }

                for (int kw = 0; kw < kernel_size; ++kw) {
                    int iw_num = ow + padding - kw;
                    if (iw_num % stride != 0) {
                        continue;
                    }
                    int iw = iw_num / stride;
                    if (iw < 0 || iw >= w_in) {
                        continue;
                    }

                    int input_idx = ((n * in_channels + ic) * h_in + ih) * w_in + iw;
                    int weight_idx = ((ic * out_channels_per_group + oc_in_group) * kernel_size + kh) * kernel_size + kw;
                    sum += input[input_idx] * weight[weight_idx];
                }
            }
        }

        output[idx] = sum;
    }
}

torch::Tensor bang_func(torch::Tensor x,
                        torch::Tensor kernel,
                        int in_channels,
                        int out_channels,
                        int kernel_size,
                        int stride,
                        int padding,
                        int output_padding,
                        int groups,
                        bool bias) {
    TORCH_CHECK(x.dim() == 4, "x must be 4D [batch, in_channels, h_in, w_in]");
    TORCH_CHECK(kernel.dim() == 4, "kernel must be 4D [in_channels, out_channels // groups, k, k]");
    TORCH_CHECK(stride > 0, "stride must be positive");
    TORCH_CHECK(padding >= 0, "padding must be non-negative");
    TORCH_CHECK(output_padding >= 0 && output_padding < stride,
                "output_padding must satisfy 0 <= output_padding < stride");
    TORCH_CHECK(groups > 0, "groups must be positive");
    TORCH_CHECK(in_channels == x.size(1), "in_channels must match x.size(1)");
    TORCH_CHECK(kernel.size(0) == in_channels, "kernel.size(0) must match in_channels");
    TORCH_CHECK(kernel.size(2) == kernel_size && kernel.size(3) == kernel_size,
                "kernel spatial size must match kernel_size");
    TORCH_CHECK(in_channels % groups == 0, "in_channels must be divisible by groups");
    TORCH_CHECK(out_channels % groups == 0, "out_channels must be divisible by groups");
    TORCH_CHECK(kernel.size(1) == out_channels / groups,
                "kernel.size(1) must equal out_channels // groups");
    TORCH_CHECK(x.scalar_type() == torch::kFloat || x.scalar_type() == torch::kHalf,
                "x must be float32 or float16");

    (void)bias;

    auto original_dtype = x.scalar_type();
    auto x_fp32 = x.contiguous().to(torch::kFloat);
    auto kernel_fp32 = kernel.contiguous().to(torch::kFloat);

    int batch = static_cast<int>(x_fp32.size(0));
    int h_in = static_cast<int>(x_fp32.size(2));
    int w_in = static_cast<int>(x_fp32.size(3));
    int h_out = (h_in - 1) * stride - 2 * padding + kernel_size + output_padding;
    int w_out = (w_in - 1) * stride - 2 * padding + kernel_size + output_padding;
    TORCH_CHECK(h_out > 0 && w_out > 0, "calculated output size must be positive");

    auto output_fp32 = torch::empty({batch, out_channels, h_out, w_out}, x_fp32.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    conv_transpose2d_kernel<<<dim, ktype, queue>>>(
        x_fp32.data_ptr<float>(),
        kernel_fp32.data_ptr<float>(),
        output_fp32.data_ptr<float>(),
        batch,
        in_channels,
        h_in,
        w_in,
        out_channels,
        kernel_size,
        stride,
        padding,
        output_padding,
        groups,
        h_out,
        w_out);

    if (original_dtype == torch::kHalf) {
        return output_fp32.to(torch::kHalf);
    }
    return output_fp32;
}