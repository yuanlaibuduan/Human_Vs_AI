#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

#define CHUNK_SIZE 2048

// 转置卷积输出尺寸计算公式
static inline int calc_out_dim(int in_dim, int k, int s, int p, int op) {
    return (in_dim - 1) * s - 2 * p + k + op;
}

// BangC MLU核函数：2D转置卷积，fp32计算
__mlu_entry__ void conv_transpose2d_kernel(
    float* g_in,               // input [B,IC,Hin,Win]
    float* g_kernel,           // weight [IC, OC/groups, K, K]
    float* g_bias,             // bias [OC], 空指针则无bias
    float* g_out,              // output [B,OC,Hout,Wout]
    int B, int IC, int OC, int Hin, int Win,
    int K, int stride, int pad, int out_pad, int groups
) {
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim.x;

    int OC_per_group = OC / groups;
    int IC_per_group = IC / groups;
    int Hout = calc_out_dim(Hin, K, stride, pad, out_pad);
    int Wout = calc_out_dim(Win, K, stride, pad, out_pad);
    int out_elem = B * OC * Hout * Wout;

    // 多核均分输出元素
    uint32_t per_core = out_elem / core_num;
    uint32_t rem = out_elem % core_num;
    uint32_t start = core_id * per_core + (core_id < rem ? core_id : rem);
    uint32_t cnt = per_core + (core_id < rem ? 1 : 0);

    // NRAM缓冲区
    __nram__ float n_in[CHUNK_SIZE];
    __nram__ float n_ker[CHUNK_SIZE];
    __nram__ float n_acc[CHUNK_SIZE];
    __nram__ float n_bias_buf[CHUNK_SIZE];

    // 遍历当前core负责的输出位置
    for (uint32_t off = 0; off < cnt; off += CHUNK_SIZE) {
        uint32_t chunk_len = ((off + CHUNK_SIZE) <= cnt) ? CHUNK_SIZE : (cnt - off);
        uint32_t glob_out_idx = start + off;

        // 清零累加缓冲区
        __bang_memset(n_acc, 0, chunk_len * sizeof(float));

        // 拆解输出多维索引: out_idx = b*OC*Hout*Wout + oc*Hout*Wout + ho*Wout + wo
        int b = glob_out_idx / (OC * Hout * Wout);
        int rem1 = glob_out_idx % (OC * Hout * Wout);
        int oc = rem1 / (Hout * Wout);
        int ho = (rem1 % (Hout * Wout)) / Wout;
        int wo = (rem1 % (Hout * Wout)) % Wout;

        int g_idx = oc / OC_per_group; // 当前输出通道所属分组
        int ocg = oc % OC_per_group;   // 组内输出通道id

        // 遍历分组内所有输入通道
        for (int icg = 0; icg < IC_per_group; icg++) {
            int ic = g_idx * IC_per_group + icg; // 全局输入通道id

            // 转置卷积逆推对应输入坐标与核坐标
            int h_in_base = ho + pad;
            int w_in_base = wo + pad;

            // 遍历卷积核kh, kw
            for (int kh = 0; kh < K; kh++) {
                int h_in = h_in_base - kh * stride;
                if (h_in < 0 || h_in >= Hin) continue;
                for (int kw = 0; kw < K; kw++) {
                    int w_in = w_in_base - kw * stride;
                    if (w_in < 0 || w_in >= Win) continue;

                    // 读取输入值 input[b, ic, h_in, w_in]
                    size_t in_addr = b * IC * Hin * Win + ic * Hin * Win + h_in * Win + w_in;
                    __memcpy(n_in, g_in + in_addr, sizeof(float), GDRAM2NRAM);

                    // 读取权重 weight[ic, ocg, kh, kw]
                    size_t ker_addr = ic * OC_per_group * K * K + ocg * K * K + kh * K + kw;
                    __memcpy(n_ker, g_kernel + ker_addr, sizeof(float), GDRAM2NRAM);

                    // 乘累加
                    __bang_mul(n_in, n_in, n_ker, 1);
                    __bang_add(n_acc, n_acc, n_in, chunk_len);
                }
            }
        }

        // 加bias（如果开启bias）
        if (g_bias != nullptr) {
            __memcpy(n_bias_buf, g_bias + oc, sizeof(float), GDRAM2NRAM);
            __bang_add_scalar(n_acc, n_acc, n_bias_buf[0], chunk_len);
        }

        // 写回GDRAM输出
        __memcpy(g_out + glob_out_idx, n_acc, chunk_len * sizeof(float), NRAM2GDRAM);
    }
}

// 对外调用入口函数，固定名bang_func
torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor kernel,
    int in_channels,
    int out_channels,
    int kernel_size,
    int stride,
    int padding,
    int output_padding,
    int groups,
    bool bias
) {
    // 输入连续性校验
    TORCH_CHECK(x.is_contiguous(), "input x must be contiguous");
    TORCH_CHECK(kernel.is_contiguous(), "kernel weight must be contiguous");
    TORCH_CHECK(x.dim() == 4, "input x shape must be [batch, in_c, hin, win]");

    auto orig_dtype = x.scalar_type();
    // 统一转fp32计算
    torch::Tensor x_fp32 = (orig_dtype == torch::kFloat) ? x : x.to(torch::kFloat);
    torch::Tensor ker_fp32 = (kernel.scalar_type() == torch::kFloat) ? kernel : kernel.to(torch::kFloat);

    int B = x_fp32.size(0);
    int Hin = x_fp32.size(2);
    int Win = x_fp32.size(3);
    int K = kernel_size;
    int OC = out_channels;

    // 计算输出高宽
    int Hout = calc_out_dim(Hin, K, stride, padding, output_padding);
    int Wout = calc_out_dim(Win, K, stride, padding, output_padding);

    // 分配输出张量 [B, OC, Hout, Wout]
    auto out_shape = torch::IntArrayRef({B, OC, Hout, Wout});
    torch::Tensor out_fp32 = torch::empty(out_shape, x_fp32.options());

    // bias处理
    float* bias_ptr = nullptr;
    torch::Tensor bias_fp32;
    if (bias) {
        bias_fp32 = torch::empty({OC}, x_fp32.options()).randn_like();
        bias_ptr = bias_fp32.data_ptr<float>();
    }

    // 获取MLU当前流
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t grid_dim = {8, 1, 1};
    cnrtFunctionType_t func_type = cnrtFuncTypeUnion1;

    // 启动BangC核
    conv_transpose2d_kernel<<<grid_dim, func_type, queue>>>(
        x_fp32.data_ptr<float>(),
        ker_fp32.data_ptr<float>(),
        bias_ptr,
        out_fp32.data_ptr<float>(),
        B, in_channels, OC, Hin, Win,
        K, stride, padding, output_padding, groups
    );

    // 还原原始数据类型
    if (orig_dtype != torch::kFloat) {
        return out_fp32.to(orig_dtype);
    }
    return out_fp32;
}

// Pybind绑定
PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
    m.def("bang_func", &bang_func, "MLU BangC 2D Transposed Conv");
}