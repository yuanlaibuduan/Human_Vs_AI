// conv_transposed_2D__asymmetric_input__square_kernel.cpp
#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

#define CIN_TILE 8
#define COUT_TILE 8
#define H_TILE 32
#define W_TILE 32
#define K 3
#define H_EXT (H_TILE+K-1)
#define W_EXT (W_TILE+K-1)

__mlu_entry__ void convtransp2d_kernel( float* input, float* kernel_gdr, float* output, int B, int CI, int CO, int HI, int WI, int HO, int WO){ uint32_t cid=taskId,cn=taskDim; uint32_t bpc=B/cn,brem=B%cn,sb=cid*bpc+(cid<brem?cid:brem),mb=bpc+(cid<brem?1:0); __nram__ float ni[CIN_TILE][H_EXT][W_EXT],na[COUT_TILE][H_TILE][W_TILE],nk[CIN_TILE][K][K]; for(uint32_t b=0;b<mb;b++){ uint32_t bi=sb+b; float* bin=input+bi*CI*HI*WI,*bout=output+bi*CO*HO*WO; for(uint32_t co_g=0;co_g<CO;co_g+=COUT_TILE){ uint32_t cot=(co_g+COUT_TILE<=CO)?COUT_TILE:(CO-co_g); for(uint32_t ho=0;ho<HO;ho+=H_TILE){ uint32_t ht=(ho+H_TILE<=HO)?H_TILE:(HO-ho),he=ht+K-1; for(uint32_t wo=0;wo<WO;wo+=W_TILE){ uint32_t wt=(wo+W_TILE<=WO)?W_TILE:(WO-wo),we=wt+K-1;for(uint32_t co=0;co<cot;co++)for(uint32_t i=0;i<ht;i++)for(uint32_t j=0;j<wt;j++)na[co][i][j]=0.0f; for(uint32_t ci_g=0;ci_g<CI;ci_g+=CIN_TILE){ uint32_t cit=(ci_g+CIN_TILE<=CI)?CIN_TILE:(CI-ci_g); for(uint32_t ci=0;ci<cit;ci++){ uint32_t gci=ci_g+ci; for(uint32_t co=0;co<cot;co++){ uint32_t gco=co_g+co; for(uint32_t kh=0;kh<K;kh++)for(uint32_t kw=0;kw<K;kw++)nk[ci][kh][kw]=kernel_gdr[(gci*CO+gco)*K*K+(K-1-kh)*K+(K-1-kw)]; } for(uint32_t i=0;i<he;i++)for(uint32_t j=0;j<we;j++)ni[ci][i][j]=0.0f;int prs=(int)ho,pre=(int)(ho+he-1),vs=K-1,ve=K-1+HI-1,cs=(prs>vs?prs:vs),ce=(pre<ve?pre:ve); for(int r=cs;r<=ce;r++){ int ir=r-(K-1),pcs=(int)wo,pce=(int)(wo+we-1),wvs=K-1,wve=K-1+WI-1,wcs=(pcs>wvs?pcs:wvs),wce=(pce<wve?pce:wve); if(wcs<=wce)__memcpy(&ni[ci][r-(int)ho][wcs-(int)wo],bin+gci*HI*WI+ir*WI+(wcs-(K-1)),(wce-wcs+1)*sizeof(float),GDRAM2NRAM); } } for(uint32_t co=0;co<cot;co++)for(uint32_t ci=0;ci<cit;ci++)for(uint32_t kh=0;kh<K;kh++)for(uint32_t kw=0;kw<K;kw++){ float wk=nk[ci][kh][kw]; for(uint32_t hi=0;hi<ht;hi++)for(uint32_t wi=0;wi<wt;wi++)na[co][hi][wi]+=wk*ni[ci][hi+kh][wi+kw]; } }for(uint32_t co=0;co<cot;co++){ uint32_t gco=co_g+co; for(uint32_t hi=0;hi<ht;hi++)__memcpy(bout+gco*HO*WO+(ho+hi)*WO+wo,na[co][hi],wt*sizeof(float),NRAM2GDRAM); }}}}}}

torch::Tensor bang_func(torch::Tensor x, torch::Tensor kernel, int in_channels, int out_channels, int kernel_size, int stride, int padding, int output_padding, int groups, bool bias){ TORCH_CHECK(x.is_contiguous(),"Input must be contiguous"); TORCH_CHECK(kernel.is_contiguous(),"Kernel must be contiguous"); auto odt=x.scalar_type(); torch::Tensor ifp=x,kfp=kernel; if(odt!=torch::kFloat){ifp=x.to(torch::kFloat);kfp=kernel.to(torch::kFloat);} int B=ifp.size(0),CI=ifp.size(1),HI=ifp.size(2),WI=ifp.size(3),CO=out_channels,KS=kernel_size,HO=(HI-1)*stride-2*padding+KS+output_padding,WO=(WI-1)*stride-2*padding+KS+output_padding; auto ofp=torch::empty({B,CO,HO,WO},ifp.options()); cnrtQueue_t q=torch_mlu::getCurMLUStream(); cnrtDim3_t d={4,1,1}; convtransp2d_kernel<<<d,cnrtFuncTypeUnion1,q>>>(ifp.data_ptr<float>(),kfp.data_ptr<float>(),ofp.data_ptr<float>(),B,CI,CO,HI,WI,HO,WO); if(odt!=torch::kFloat)return ofp.to(odt); return ofp; }