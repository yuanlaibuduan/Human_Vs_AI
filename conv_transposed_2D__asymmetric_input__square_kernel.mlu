<｜｜DSML｜｜parameter name="content" string="true">// conv_transposed_2D__asymmetric_input__square_kernel.cpp
#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

#define CIN_TILE 8
#define COUT_TILE 8
#define H_TILE 24
#define W_TILE 24
#define K 3
#define H_EXT (H_TILE+K-1)
#define W_EXT (W_TILE+K-1)

__mlu_entry__ void convtransp2d_kernel(
    float* input,
    float* kernel_gdr,
    float* output,
    int B, int CI, int CO,
    int HI, int WI,
    int HO, int WO)
{
    uint32_t cid = taskId;
    uint32_t cn = taskDim;
    uint32_t bpc = B / cn;
    uint32_t brem = B % cn;
    uint32_t sb = cid * bpc + (cid < brem ? cid : brem);
    uint32_t mb = bpc + (cid < brem ? 1 : 0);

    __nram__ float ni[CIN_TILE][H_EXT][W_EXT];
    __nram__ float na[COUT_TILE][H_TILE][W_TILE];
    __nram__ float nk[CIN_TILE][K][K];

    for (uint32_t b = 0; b < mb; b++) {
        uint32_t bi = sb + b;
        float* bin  = input  + bi * CI * HI * WI;
        float* bout = output + bi * CO * HO * WO;

        for (uint32_t co_g = 0; co_g < CO; co_g += COUT_TILE) {
            uint32_t cot = (co_g + COUT_TILE <= CO) ? COUT_TILE : (CO - co_g);

            for (uint32_t ho = 0; ho < HO; ho += H_TILE) {
                uint32_t ht = (ho + H_TILE <= HO) ? H_TILE : (HO - ho);
                uint32_t he = ht + K - 1;

                for (uint32_t wo = 0; wo < WO; wo += W_TILE) {
                    uint32_t wt = (wo + W_TILE <= WO) ? W_TILE : (WO - wo);
                    uint32_t we = wt + K - 1;

                    // --- zero accumulator for this output tile ---
                    for (uint32_t co = 0; co < cot; co++)
                        for (uint32_t hi = 0; hi < ht; hi++)
                            for (uint32_t wi = 0; wi < wt; wi++)
                                na[co][hi][wi] = 0.0f;

                    for (uint32_t ci_g = 0; ci_g < CI; ci_g += CIN_TILE) {
                        uint32_t cit = (ci_g + CIN_TILE <= CI) ? CIN_TILE : (CI - ci_g);

                        // --- load kernel weights and input tile (per ci) ---
                        for (uint32_t ci = 0; ci < cit; ci++) {
                            uint32_t gci = ci_g + ci;

                            // load flipped kernel weights  w[ci][co][K-1-kh][K-1-kw]
                            for (uint32_t co = 0; co < cot; co++) {
                                uint32_t gco = co_g + co;
                                for (uint32_t kh = 0; kh < K; kh++)
                                    for (uint32_t kw = 0; kw < K; kw++)
                                        nk[ci][kh][kw] = kernel_gdr[
                                            (gci * CO + gco) * K * K
                                            + (K - 1 - kh) * K
                                            + (K - 1 - kw)];
                            }

                            // zero the input tile (K-1 zero-padding around valid region)
                            for (uint32_t i = 0; i < he; i++)
                                for (uint32_t j = 0; j < we; j++)
                                    ni[ci][i][j] = 0.0f;

                            // overlap of output-tile padded region [ho, ho+he-1]
                            // with valid-input padded region [K-1, K-1+HI-1]
                            int cs = ((int)ho > (K - 1)) ? (int)ho : (K - 1);
                            int ce = ((int)(ho + he - 1) < (K - 1 + HI - 1))
                                         ? (int)(ho + he - 1)
                                         : (K - 1 + HI - 1);

                            for (int r = cs; r <= ce; r++) {
                                int ir = r - (K - 1);  // input row index

                                int wcs = ((int)wo > (K - 1)) ? (int)wo : (K - 1);
                                int wce = ((int)(wo + we - 1) < (K - 1 + WI - 1))
                                              ? (int)(wo + we - 1)
                                              : (K - 1 + WI - 1);

                                if (wcs <= wce) {
                                    int ni_r  = r   - (int)ho;
                                    int ni_c0 = wcs - (int)wo;
                                    int ncols = wce - wcs + 1;

                                    // direct element load – avoids __memcpy alignment issues
                                    float* src = bin + gci * HI * WI
                                               + ir * WI
                                               + (wcs - (K - 1));
                                    for (int col = 0; col < ncols; col++)
                                        ni[ci][ni_r][ni_c0 + col] = src[col];
                                }
                            }
                        }

                        // --- convolution: na[co][hi][wi] += wk * ni[ci][hi+kh][wi+kw] ---
                        for (uint32_t co = 0; co < cot; co++)
                            for (uint32_t ci = 0; ci < cit; ci++)
                                for (uint32_t kh = 0; kh < K; kh++)
                                    for (uint32_t kw = 0; kw < K; kw++) {
                                        float wk = nk[ci][kh][kw];
                                        for (uint32_t hi = 0; hi < ht; hi++)
                                            for (uint32_t wi = 0; wi < wt; wi++)
                                                na[co][hi][wi] +=
                                                    wk * ni[ci][hi + kh][wi + kw];
                                    }
                    }

                    // --- store output tile ---
                    for (uint32_t co = 0; co < cot; co++) {
                        uint32_t gco = co_g + co;
                        for (uint32_t hi = 0; hi < ht; hi++)
                            for (uint32_t wi = 0; wi < wt; wi++)
                                bout[gco * HO * WO + (ho + hi) * WO + wo + wi] =
                                    na[co][hi][wi];
                    }
                }
            }
        }
    }
}

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor kernel,
    int in_channels,
    int out_channels,
    int kernel_size,
    int stride,
    int padding,
    int output_padding,
    int groups,
    bool bias)
{
    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
    TORCH_CHECK(kernel.is_contiguous(), "Kernel must be contiguous");

    auto odt = x.scalar_type();
    torch::Tensor ifp = x;
    torch::Tensor kfp = kernel;
    if (odt != torch::kFloat) {
        ifp = x.to(torch::kFloat);
        kfp = kernel.to(torch::kFloat);
    }

    int B  = ifp.size(0);
    int CI = ifp.size(1);
    int HI = ifp.size(2);
    int WI = ifp.size(3);
    int CO = out_channels;
    int KS = kernel_size;
    int HO = (HI - 1) * stride - 2 * padding + KS + output_padding;
    int WO = (WI - 1) * stride - 2 * padding + KS + output_padding;

    auto ofp = torch::empty({B, CO, HO, WO}, ifp.options());

    cnrtQueue_t q = torch_mlu::getCurMLUStream();
    cnrtDim3_t d = {4, 1, 1};

    convtransp2d_kernel<<<d, cnrtFuncTypeUnion1, q>>>(
        ifp.data_ptr<float>(),
        kfp.data_ptr<float>(),
        ofp.data_ptr<float>(),
        B, CI, CO, HI, WI, HO, WO);

    if (odt != torch::kFloat)
        return ofp.to(odt);
    return ofp;
}
