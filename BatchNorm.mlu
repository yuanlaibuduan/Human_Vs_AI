#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <math.h>

#define BN_PARTS 256
#define BN_EPS 0.00001f

__mlu_entry__ void batchnorm_reduce_kernel(
    float *x,
    float *partial_sum,
    float *partial_sumsq,
    int batch,
    int channel,
    int height,
    int width) {

    int spatial = height * width;
    int count_per_channel = batch * spatial;
    int total_tasks = channel * BN_PARTS;

    for (int task = taskId; task < total_tasks; task += taskDim) {
        int c = task / BN_PARTS;
        int part = task - c * BN_PARTS;
        int begin = part * count_per_channel / BN_PARTS;
        int end = (part + 1) * count_per_channel / BN_PARTS;

        float sum = 0.0f;
        float sumsq = 0.0f;

        for (int linear = begin; linear < end; ++linear) {
            int n = linear / spatial;
            int rem = linear - n * spatial;
            float v = x[(n * channel + c) * spatial + rem];
            sum += v;
            sumsq += v * v;
        }

        partial_sum[task] = sum;
        partial_sumsq[task] = sumsq;
    }
}

__mlu_entry__ void batchnorm_finalize_kernel(
    float *partial_sum,
    float *partial_sumsq,
    float *mean,
    float *inv_std,
    int batch,
    int channel,
    int height,
    int width) {

    int count_per_channel = batch * height * width;

    for (int c = taskId; c < channel; c += taskDim) {
        float sum = 0.0f;
        float sumsq = 0.0f;
        int base = c * BN_PARTS;

        for (int part = 0; part < BN_PARTS; ++part) {
            sum += partial_sum[base + part];
            sumsq += partial_sumsq[base + part];
        }

        float m = sum / (float)count_per_channel;
        float var = sumsq / (float)count_per_channel - m * m;
        if (var < 0.0f) {
            var = 0.0f;
        }

        mean[c] = m;
        inv_std[c] = 1.0f / sqrtf(var + BN_EPS);
    }
}

__mlu_entry__ void batchnorm_apply_kernel(
    float *x,
    float *output,
    float *mean,
    float *inv_std,
    int total,
    int channel,
    int height,
    int width) {

    int spatial = height * width;

    for (int idx = taskId; idx < total; idx += taskDim) {
        int nc = idx / spatial;
        int c = nc - (nc / channel) * channel;
        output[idx] = (x[idx] - mean[c]) * inv_std[c];
    }
}

torch::Tensor bang_func(torch::Tensor x, int num_features) {
    TORCH_CHECK(x.dim() == 4, "Input x must be a 4D NCHW tensor");
    TORCH_CHECK(x.size(1) == num_features, "num_features must match x.size(1)");

    auto original_dtype = x.scalar_type();
    torch::Tensor x_fp32 =
        original_dtype == torch::kFloat ? x.contiguous()
                                        : x.to(torch::kFloat).contiguous();

    int batch = x_fp32.size(0);
    int channel = x_fp32.size(1);
    int height = x_fp32.size(2);
    int width = x_fp32.size(3);
    TORCH_CHECK(batch > 0 && channel > 0 && height > 0 && width > 0,
                "BatchNorm dimensions must be non-empty");

    torch::Tensor output_fp32 = torch::empty_like(x_fp32);
    torch::Tensor partial_sum =
        torch::empty({channel, BN_PARTS}, x_fp32.options());
    torch::Tensor partial_sumsq =
        torch::empty({channel, BN_PARTS}, x_fp32.options());
    torch::Tensor mean = torch::empty({channel}, x_fp32.options());
    torch::Tensor inv_std = torch::empty({channel}, x_fp32.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t reduce_dim = {256, 1, 1};
    cnrtDim3_t channel_dim = {64, 1, 1};
    cnrtDim3_t apply_dim = {256, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    batchnorm_reduce_kernel<<<reduce_dim, ktype, queue>>>(
        x_fp32.data_ptr<float>(),
        partial_sum.data_ptr<float>(),
        partial_sumsq.data_ptr<float>(),
        batch,
        channel,
        height,
        width);

    batchnorm_finalize_kernel<<<channel_dim, ktype, queue>>>(
        partial_sum.data_ptr<float>(),
        partial_sumsq.data_ptr<float>(),
        mean.data_ptr<float>(),
        inv_std.data_ptr<float>(),
        batch,
        channel,
        height,
        width);

    int total = batch * channel * height * width;
    batchnorm_apply_kernel<<<apply_dim, ktype, queue>>>(
        x_fp32.data_ptr<float>(),
        output_fp32.data_ptr<float>(),
        mean.data_ptr<float>(),
        inv_std.data_ptr<float>(),
        total,
        channel,
        height,
        width);

    if (original_dtype != torch::kFloat) {
        return output_fp32.to(original_dtype);
    }

    return output_fp32;
}