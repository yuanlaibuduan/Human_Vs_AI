// BatchNorm.cpp
#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <cmath>

#define CHUNK_SIZE 4096
#define EPS 1e-5f

// MLU kernel: BatchNorm2d in training mode
//   Per-channel batch statistics over (N, H, W)
//   y = (x - mean) / sqrt(var + eps) * gamma + beta
//   With default init (gamma=1, beta=0):
//   y = (x - mean) / sqrt(var + eps)
__mlu_entry__ void batchnorm_kernel(
    float *input,
    float *output,
    int B,
    int CI,
    int HW)
{
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;

    // Distribute channels across cores
    int ci_per_core = CI / core_num;
    int ci_rem = CI % core_num;
    int ci_start = core_id * ci_per_core
                 + (core_id < (uint32_t)ci_rem ? core_id : ci_rem);
    int ci_count = ci_per_core
                 + (core_id < (uint32_t)ci_rem ? 1 : 0);

    __nram__ float buf[CHUNK_SIZE];
    int total_per_ch = B * HW;

    for (int ci_idx = 0; ci_idx < ci_count; ci_idx++) {
        int c = ci_start + ci_idx;

        // =========================================
        // Pass 1: accumulate sum and sum_sq for this channel
        // =========================================
        float sum = 0.0f;
        float sum_sq = 0.0f;

        for (int b = 0; b < B; b++) {
            float* src = input + b * CI * HW + c * HW;

            for (int off = 0; off < HW; off += CHUNK_SIZE) {
                int len = (off + CHUNK_SIZE <= HW) ? CHUNK_SIZE : (HW - off);

                __memcpy(buf, src + off, len * sizeof(float), GDRAM2NRAM);

                for (int i = 0; i < len; i++) {
                    float x = buf[i];
                    sum += x;
                    sum_sq += x * x;
                }
            }
        }

        float mean = sum / (float)total_per_ch;
        float var = sum_sq / (float)total_per_ch - mean * mean;
        if (var < 0.0f) var = 0.0f;
        float inv_std = 1.0f / sqrtf(var + EPS);

        // =========================================
        // Pass 2: normalize and write output
        // =========================================
        for (int b = 0; b < B; b++) {
            float* src = input + b * CI * HW + c * HW;
            float* dst = output + b * CI * HW + c * HW;

            for (int off = 0; off < HW; off += CHUNK_SIZE) {
                int len = (off + CHUNK_SIZE <= HW) ? CHUNK_SIZE : (HW - off);

                __memcpy(buf, src + off, len * sizeof(float), GDRAM2NRAM);

                for (int i = 0; i < len; i++) {
                    buf[i] = (buf[i] - mean) * inv_std;
                }

                __memcpy(dst + off, buf, len * sizeof(float), NRAM2GDRAM);
            }
        }
    }
}

// C++ wrapper called by PyTorch
torch::Tensor bang_func(torch::Tensor x, int num_features) {
    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");

    auto original_dtype = x.scalar_type();
    torch::Tensor input_fp32 = x;
    if (original_dtype != torch::kFloat) {
        input_fp32 = x.to(torch::kFloat);
    }

    int B  = input_fp32.size(0);
    int CI = input_fp32.size(1);
    int H  = input_fp32.size(2);
    int W  = input_fp32.size(3);
    int HW = H * W;

    auto output_fp32 = torch::empty_like(input_fp32);

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    cnrtDim3_t dim = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    batchnorm_kernel<<<dim, ktype, queue>>>(
        input_fp32.data_ptr<float>(),
        output_fp32.data_ptr<float>(),
        B, CI, HW
    );

    if (original_dtype != torch::kFloat) {
        return output_fp32.to(original_dtype);
    }
    return output_fp32;
}
