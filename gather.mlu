#include <bang.h>
#include <cnrt.h>
#include <torch/extension.h>

// 核函数：根据索引和分桶规则收集数据，可选加权，输出到目标缓冲区
__mlu_entry__ void gather_kernel(
    float* x_ptr,                // [tokens, hidden_size]
    int32_t* indices_ptr,        // [num_elements]
    int32_t* bin_ids_ptr,        // [num_elements]
    float* weights_ptr,          // [num_elements] or nullptr
    int32_t* bins_ptr,           // [num_bins]
    float* out_ptr,              // [tokens * top_k, hidden_size]
    int tokens,                  // x 的行数
    int hidden_size,             // x 的列数
    int num_elements,            // indices, bin_ids 的长度
    int top_k,                   // 每个 token 选 top_k 个专家
    int num_bins)                // 桶的个数
{
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;
    uint32_t per_core = num_elements / core_num;
    uint32_t remainder = num_elements % core_num;
    uint32_t start = core_id * per_core + (core_id < remainder ? core_id : remainder);
    uint32_t count = per_core + (core_id < remainder ? 1 : 0);

    for (uint32_t i = 0; i < count; ++i) {
        uint32_t idx = start + i;                  // 全局元素编号 (pid)
        int32_t bin_id = bin_ids_ptr[idx];         // 当前元素所属桶
        // 桶起始索引：bin_starts[0]=0, bin_starts[1]=bins[0], bin_starts[2]=bins[1], ...
        int32_t bin_start = (bin_id == 0) ? 0 : bins_ptr[bin_id - 1];
        int32_t out_idx = bin_start + (idx - bin_start);  // 等价于 idx，但保留了分桶语义

        int32_t src_row = indices_ptr[idx] / top_k;       // 原始行索引
        float scale = 1.0f;
        if (weights_ptr != nullptr) {
            int32_t weight_idx = indices_ptr[idx];
            scale = weights_ptr[weight_idx];              // 根据 indices 重排权重
        }

        // 逐元素复制并加权
        for (int32_t j = 0; j < hidden_size; ++j) {
            float val = x_ptr[src_row * hidden_size + j];
            val *= scale;
            out_ptr[out_idx * hidden_size + j] = val;
        }
    }
}

// 外部调用接口
torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor indices,
    torch::Tensor bin_ids,
    torch::Tensor weights,
    torch::Tensor bins,
    int top_k)
{
    // 输入合法性检查
    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
    TORCH_CHECK(indices.is_contiguous(), "indices must be contiguous");
    TORCH_CHECK(bin_ids.is_contiguous(), "bin_ids must be contiguous");
    TORCH_CHECK(bins.is_contiguous(), "bins must be contiguous");
    TORCH_CHECK(x.dim() == 2, "x must be 2D [tokens, hidden_size]");
    TORCH_CHECK(indices.dim() == 1, "indices must be 1D");
    TORCH_CHECK(bin_ids.dim() == 1, "bin_ids must be 1D");
    TORCH_CHECK(bins.dim() == 1, "bins must be 1D");
    TORCH_CHECK(weights.dim() == 1 || weights.numel() == 0,
                "weights must be 1D or empty");

    int64_t tokens = x.size(0);
    int64_t hidden_size = x.size(1);
    int64_t num_elements = indices.numel();
    int64_t num_bins = bins.numel();

    TORCH_CHECK(bin_ids.numel() == num_elements,
                "bin_ids must have same number of elements as indices");
    TORCH_CHECK(weights.numel() == 0 || weights.numel() == num_elements,
                "weights must have same number of elements as indices or be empty");
    TORCH_CHECK(top_k > 0, "top_k must be positive");

    // 保留原始数据类型，内部使用 float32 计算
    auto original_dtype = x.scalar_type();
    torch::Tensor x_fp32 = x.to(torch::kFloat);
    torch::Tensor weights_fp32;
    if (weights.numel() > 0) {
        weights_fp32 = weights.to(torch::kFloat);
    }

    // 输出形状 [tokens * top_k, hidden_size]
    int64_t out_rows = tokens * top_k;
    auto out_fp32 = torch::empty({out_rows, hidden_size},
                                 torch::dtype(torch::kFloat).device(x.device()));

    // 获取 MLU 队列
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    // 设置核函数启动维度（简单起见使用 4 个核）
    cnrtDim3_t dim = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    // 准备参数指针
    float* x_ptr = x_fp32.data_ptr<float>();
    int32_t* indices_ptr = indices.data_ptr<int32_t>();
    int32_t* bin_ids_ptr = bin_ids.data_ptr<int32_t>();
    float* weights_ptr = (weights.numel() > 0) ? weights_fp32.data_ptr<float>() : nullptr;
    int32_t* bins_ptr = bins.data_ptr<int32_t>();
    float* out_ptr = out_fp32.data_ptr<float>();

    // 调用核函数
    gather_kernel<<<dim, ktype, queue>>>(
        x_ptr, indices_ptr, bin_ids_ptr, weights_ptr, bins_ptr, out_ptr,
        (int)tokens, (int)hidden_size, (int)num_elements, top_k, (int)num_bins);

    // 将结果转换回原始数据类型
    if (original_dtype == torch::kFloat) {
        return out_fp32;
    } else if (original_dtype == torch::kHalf) {
        return out_fp32.to(torch::kHalf);
    } else {
        TORCH_CHECK(false, "Unsupported input dtype, only float16 and float32 are allowed");
    }
}