#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

#define TILE_W 256
#define ALIGN_UP_64(x) (((x) + 63) & ~63)

__mlu_entry__ void dilated_conv2d_kernel(
    float *x,
    float *kernel,
    float *output,
    int total_rows,
    int in_channels,
    int out_channels,
    int in_h,
    int in_w,
    int out_h,
    int out_w,
    int kernel_size,
    int dilation,
    int padding) {

    int task_id = taskId;
    int task_num = taskDim;

    __nram__ float nram_acc[TILE_W + 64];
    __nram__ float nram_input[TILE_W + 64];
    __nram__ float nram_prod[TILE_W + 64];

    for (int row = task_id; row < total_rows; row += task_num) {
        int row_tmp = row;
        int oh = row_tmp % out_h;
        row_tmp /= out_h;
        int oc = row_tmp % out_channels;
        int n = row_tmp / out_channels;

        for (int ow_base = 0; ow_base < out_w; ow_base += TILE_W) {
            int tile_len = out_w - ow_base;
            if (tile_len > TILE_W) {
                tile_len = TILE_W;
            }
            int aligned_tile = ALIGN_UP_64(tile_len);

            __bang_write_zero(nram_acc, aligned_tile);

            for (int ic = 0; ic < in_channels; ++ic) {
                for (int kh = 0; kh < kernel_size; ++kh) {
                    int ih = oh + kh * dilation - padding;
                    if (ih < 0 || ih >= in_h) {
                        continue;
                    }

                    for (int kw = 0; kw < kernel_size; ++kw) {
                        int iw_first = ow_base + kw * dilation - padding;
                        int valid_start = 0;
                        int valid_end = tile_len;

                        if (iw_first < 0) {
                            valid_start = -iw_first;
                        }
                        if (iw_first + valid_end > in_w) {
                            valid_end = in_w - iw_first;
                        }
                        if (valid_start >= valid_end) {
                            continue;
                        }

                        int valid_len = valid_end - valid_start;
                        int input_offset =
                            ((n * in_channels + ic) * in_h + ih) * in_w +
                            iw_first + valid_start;
                        int kernel_offset =
                            ((oc * in_channels + ic) * kernel_size + kh) *
                            kernel_size + kw;

                        __bang_write_zero(nram_input, aligned_tile);
                        __memcpy(
                            nram_input + valid_start,
                            x + input_offset,
                            valid_len * sizeof(float),
                            GDRAM2NRAM);

                        __bang_mul_scalar(
                            nram_prod,
                            nram_input,
                            kernel[kernel_offset],
                            aligned_tile);
                        __bang_add(
                            nram_acc,
                            nram_acc,
                            nram_prod,
                            aligned_tile);
                    }
                }
            }

            int output_offset =
                ((n * out_channels + oc) * out_h + oh) * out_w + ow_base;
            __memcpy(
                output + output_offset,
                nram_acc,
                tile_len * sizeof(float),
                NRAM2GDRAM);
        }
    }
}

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor kernel,
    int in_channels,
    int out_channels,
    int kernel_size,
    int dilation,
    int padding) {

    TORCH_CHECK(x.dim() == 4, "Input x must be a 4D NCHW tensor");
    TORCH_CHECK(kernel.dim() == 4, "Kernel must be a 4D OIHW tensor");
    TORCH_CHECK(x.size(1) == in_channels, "Input channel mismatch");
    TORCH_CHECK(kernel.size(0) == out_channels, "Output channel mismatch");
    TORCH_CHECK(kernel.size(1) == in_channels, "Kernel input channel mismatch");
    TORCH_CHECK(kernel.size(2) == kernel_size, "Kernel height mismatch");
    TORCH_CHECK(kernel.size(3) == kernel_size, "Kernel width mismatch");

    torch::Tensor x_fp32 =
        x.scalar_type() == torch::kFloat ? x.contiguous()
                                         : x.to(torch::kFloat).contiguous();
    torch::Tensor kernel_fp32 =
        kernel.scalar_type() == torch::kFloat
            ? kernel.contiguous()
            : kernel.to(torch::kFloat).contiguous();

    int batch = x_fp32.size(0);
    int in_h = x_fp32.size(2);
    int in_w = x_fp32.size(3);
    int out_h =
        (in_h + 2 * padding - dilation * (kernel_size - 1) - 1) + 1;
    int out_w =
        (in_w + 2 * padding - dilation * (kernel_size - 1) - 1) + 1;

    TORCH_CHECK(out_h > 0 && out_w > 0, "Invalid convolution output shape");

    auto output = torch::empty(
        {batch, out_channels, out_h, out_w},
        x_fp32.options());

    int total_rows = batch * out_channels * out_h;

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    dilated_conv2d_kernel<<<dim, ktype, queue>>>(
        x_fp32.data_ptr<float>(),
        kernel_fp32.data_ptr<float>(),
        output.data_ptr<float>(),
        total_rows,
        in_channels,
        out_channels,
        in_h,
        in_w,
        out_h,
        out_w,
        kernel_size,
        dilation,
        padding);

    return output;
}
