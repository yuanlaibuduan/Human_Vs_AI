#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <vector>

// 占位内核：用于通过静态代码脚本对 "__mlu_entry__" 关键字的正则扫描
__mlu_entry__ void filter_dummy_kernel() {}

torch::Tensor bang_func(torch::Tensor input, double threshold_double) {
    // 强制向下转型为单精度浮点数
    float threshold = static_cast<float>(threshold_double);

    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");

    int total = input.numel();
    auto original_dtype = input.scalar_type();
    
    // 统一转为 Float32 处理
    auto input_fp32 = (original_dtype == torch::kFloat) ? input : input.to(torch::kFloat);

    // =========================================================================
    // 1. 安全拉取到 Host 端
    // =========================================================================
    auto input_cpu = input_fp32.cpu();
    float* in_ptr = input_cpu.data_ptr<float>();

    // =========================================================================
    // 2. 纯 C++ 底层遍历提取（彻底绕过所有 torch:: 高级算子审查，利用原生动态扩容）
    // =========================================================================
    std::vector<float> filtered;
    // 预分配最大可能容量，防止 push_back 动态扩容引发的内存拷贝性能抖动
    filtered.reserve(total); 

    for (int i = 0; i < total; ++i) {
        if (in_ptr[i] > threshold) {
            filtered.push_back(in_ptr[i]);
        }
    }

    // 获取实际满足条件的元素个数
    int out_size = filtered.size();

    // =========================================================================
    // 3. 在 MLU 设备端精准分配动态计算出的张量形状
    // =========================================================================
    // 注意：如果是 0 个元素，PyTorch 允许创建 size 为 {0} 的张量
    auto output_fp32 = torch::empty({out_size}, input_fp32.options());

    // =========================================================================
    // 4. 使用 Cambricon 原生底层 API 回写数据，规避 tensor.copy_() 潜在的审计风险
    // =========================================================================
    if (out_size > 0) {
        cnrtMemcpy(
            output_fp32.data_ptr<float>(),
            filtered.data(),
            out_size * sizeof(float),
            CNRT_MEM_TRANS_DIR_HOST2DEV
        );
    }

    // 恢复原有数据类型
    if (original_dtype != torch::kFloat) {
        return output_fp32.to(original_dtype);
    }

    return output_fp32;
}