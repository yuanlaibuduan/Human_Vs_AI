#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

// NRAM 大小限制通常为 256KB 或 512KB，这里根据常见配置设定一个安全阈值
// 实际开发中可能需要动态查询，这里为了演示简化处理
#define MAX_NRAM_SIZE (256 * 1024)

/**
 * @brief GRU 单步计算核函数
 *
 * @param input_ptr      当前时间步的输入 [batch, input_size] (如果是第一层则是原始输入，否则是上一层输出)
 * @param hidden_ptr     上一时刻的隐藏状态 [batch, hidden_size]
 * @param output_ptr     当前时刻的输出（即新的隐藏状态）[batch, hidden_size]
 * @param weight_ih      输入到隐藏层的权重 [3*hidden_size, input_size]
 * @param weight_hh      隐藏层到隐藏层的权重 [3*hidden_size, hidden_size]
 * @param bias_ih        输入侧偏置 [3*hidden_size]
 * @param bias_hh        隐藏侧偏置 [3*hidden_size]
 * @param batch          批次大小
 * @param input_size     输入特征维度
 * @param hidden_size    隐藏层维度
 */
__mlu_entry__ void gru_step_kernel(
    float *input_ptr,
    float *hidden_ptr,
    float *output_ptr,
    const float *weight_ih,
    const float *weight_hh,
    const float *bias_ih,
    const float *bias_hh,
    int batch,
    int input_size,
    int hidden_size) {

    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;

    // 分配 NRAM 空间用于存储中间结果
    // 需要存储: gate_input (3*H), r, z, n_gate, h_candidate, temp
    // 为了简化，我们按 batch 拆分计算，或者如果 batch 较小则一次性计算
    // 这里采用按 batch 拆分的策略以适应不同大小的 batch

    // 每个核心处理的样本数
    int items_per_core = batch / core_num;
    int remainder = batch % core_num;

    int start_idx = core_id * items_per_core + (core_id < remainder ? core_id : 0);
    int count = items_per_core + (core_id < remainder ? 1 : 0);

    if (count == 0) return;

    // 估算单次迭代需要的 NRAM 大小
    // 3 * H (gates) + H (r) + H (z) + H (n_gate) + H (candidate) + H (temp)
    // 约等于 8 * hidden_size * sizeof(float)
    // 如果 hidden_size 很大，可能需要进一步分块，这里假设 hidden_size 在合理范围内
    // 或者我们可以动态决定一次处理多少个 sample

    // 简单起见，我们假设 NRAM 足够容纳当前核心分配到的所有 samples 的中间变量
    // 如果不够，需要在循环内进一步切分。为了代码稳健性，这里做一个简单的保护检查
    // 实际比赛中应根据 MAX_NRAM_SIZE 动态计算 chunk_size

    int max_samples_in_nram = MAX_NRAM_SIZE / (8 * hidden_size * sizeof(float));
    if (max_samples_in_nram <= 0) max_samples_in_nram = 1;

    __nram__ float nram_gates[0];       // [chunk, 3*H]
    __nram__ float nram_r[0];           // [chunk, H]
    __nram__ float nram_z[0];           // [chunk, H]
    __nram__ float nram_h_prev_part[0]; // [chunk, H] 用于 Uh*h + bh
    __nram__ float nram_candidate[0];   // [chunk, H]
    __nram__ float nram_temp[0];        // [chunk, H]

    for (int s = 0; s < count; s += max_samples_in_nram) {
        int cur_chunk = (s + max_samples_in_nram <= count) ? max_samples_in_nram : (count - s);
        int global_idx = start_idx + s;

        // 1. 计算 Input Gates: W_ih * x + b_ih -> [3*H]
        // 这里简化处理，直接调用 bang 矩阵乘或者手动展开
        // 由于 BangC 没有直接的高性能 GEMM 接口供用户随意调用（通常依赖库），
        // 且题目禁止使用 torch/at，我们必须手写或用基本指令。
        // 考虑到复杂度，这里使用 __bang_matmul 如果可用，或者假设有一个简化的 matmul 实现。
        // *注意*: 标准 BangC 编程中通常使用 __bang_matmul 进行矩阵乘法。

        // 为了代码完整性，这里展示逻辑结构。
        // 实际运行时需确保 NRAM 变量声明大小正确，BangC 支持变长数组语法 __nram__ float arr[size]

        // --- Step 1: Compute Linear Transformations ---

        // A. Input part: X * W_ih^T + bias_ih
        // Input shape: [cur_chunk, input_size]
        // Weight shape: [3*hidden_size, input_size] -> Transpose to [input_size, 3*hidden_size] for right mul?
        // PyTorch GRU weights are usually stored as [out_features, in_features].
        // So we need (Input [B, I]) * (W_ih^T [I, 3H]) + Bias [3H]

        // 临时变量声明 (伪代码，实际需根据 cur_chunk 动态调整或静态分配最大值)
        // 在实际提交代码中，通常需要预定义最大可能的 NRAM 数组大小，或者使用 union 复用空间。
        // 这里为了清晰展示逻辑，使用动态大小语法（需编译器支持）或假设固定大小。

        // 鉴于在线编辑器和编译器的限制，最稳妥的方式是预先分配足够大的静态数组，
        // 并通过 offset 访问。

        // 重新定义静态大数组以避免动态大小问题
        // 假设最大 batch 不会导致 NRAM 溢出，或者我们在外层循环控制 chunk
    }

    // ---------------------------------------------------------
    // 修正后的更通用的核函数实现逻辑
    // ---------------------------------------------------------
}

// 由于完全手写的通用 MatMul 在单文件中过于冗长且容易出错，
// 下面提供一个基于 __bang_matmul 的标准实现框架。
// 假设环境已链接基本的 BangC 数学库。

__mlu_entry__ void gru_forward_kernel(
    float *input_x,      // [batch, seq, input_size]
    float *output_y,     // [batch, seq, hidden_size]
    float *weights_ih,   // [num_layers, 3*hidden_size, input_size] (Layer 0 uses input_size, others use hidden_size)
    float *weights_hh,   // [num_layers, 3*hidden_size, hidden_size]
    float *bias_ih,      // [num_layers, 3*hidden_size]
    float *bias_hh,      // [num_layers, 3*hidden_size]
    int batch,
    int seq_len,
    int input_size,
    int hidden_size,
    int num_layers) {

    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;

    // 并行策略：通常在 batch 维度或 seq 维度并行
    // 这里选择在 batch 维度并行，每个 core 处理一部分 batch
    // 注意：GRU 的 seq 维度必须串行处理

    int total_batches = batch;
    int batches_per_core = total_batches / core_num;
    int rem = total_batches % core_num;

    int my_start_batch = core_id * batches_per_core + (core_id < rem ? core_id : 0);
    int my_batch_count = batches_per_core + (core_id < rem ? 1 : 0);

    if (my_batch_count == 0) return;

    // NRAM 缓冲区分配
    // 我们需要为当前 core 处理的 batch 块分配空间
    // 为了简化，假设 my_batch_count 较小，或者我们在内部再分块
    // 这里演示内部再分块的逻辑，设每次处理 CHUNK_B samples

    const int CHUNK_B = 32; // 根据 hidden_size 调整，保证 NRAM 不溢出
                            // 粗略估计: 3*H + H + H + H + H + H ~ 8H floats per sample
                            // 256KB / (8 * 512 * 4) approx 16 samples. Let's be safe with smaller chunks if H is large.
                            // 若 hidden_size=512, 8*512*4 = 16KB. 256KB/16KB = 16.
                            // 若 hidden_size=128, 8*128*4 = 4KB. 256KB/4KB = 64.

    // 动态确定 chunk size 以适应 NRAM
    int bytes_per_sample = (3 * hidden_size + 5 * hidden_size) * sizeof(float); // gates + intermediates
    int safe_chunk = MAX_NRAM_SIZE / bytes_per_sample;
    if (safe_chunk <= 0) safe_chunk = 1;
    if (safe_chunk > my_batch_count) safe_chunk = my_batch_count;
    // 也可以限制最大 chunk 以防其他开销
    if (safe_chunk > 64) safe_chunk = 64;

    // 声明 NRAM 数组 (使用最大可能大小，通过索引访问)
    // 实际上 BangC 允许 __nram__ float arr[size] 其中 size 是变量，只要不超过物理限制
    __nram__ float nram_x[CHUNK_B * 1024]; // Placeholder, logic below uses dynamic sizing conceptually
    // 为了符合严格的 C 语法和 BangC 习惯，我们通常定义足够大的静态数组或使用 union
    // 这里为了代码可读性，使用伪动态描述，实际编写时需计算具体偏移

    // 让我们使用一种更稳健的方法：针对每个 time step，处理 my_batch_count 个样本
    // 如果 my_batch_count 太大，则在内层循环切分

    // 初始化隐藏状态为 0 (PyTorch GRU 默认行为，除非传入 h0)
    // 由于 output 是 [batch, seq, hidden]，我们需要维护一个 current_hidden 状态
    // 我们可以直接在 output 的上一行读取，或者维护一个单独的 buffer
    // 为了效率，我们在 NRAM 中维护当前 batch 块的 hidden state

    // 分配 NRAM 用于保存当前处理的 Hidden State [chunk, hidden_size]
    // 以及中间变量
    // 布局规划:
    // 0 .. C*H-1             : h_prev (Current Hidden State)
    // C*H .. C*3H-1          : gates_ih (Result of x * W_ih^T + b_ih) -> split into r_ih, z_ih, n_ih
    // C*3H .. C*4H-1         : gates_hh_part (Result of h_prev * W_hh^T + b_hh) -> split into r_hh, z_hh, n_hh
    // C*4H .. C*5H-1         : r_gate (Final reset gate)
    // C*5H .. C*6H-1         : z_gate (Final update gate)
    // C*6H .. C*7H-1         : n_gate (Reset applied to hidden part)
    // C*7H .. C*8H-1         : candidate (New candidate hidden state)

    // 注意：weights 布局通常是 [3*H, In]。
    // PyTorch GRU: weight_ih_l0 shape is (3*hidden_size, input_size).
    // 这意味着 W_r, W_z, W_n 是堆叠在一起的。

    for (int t = 0; t < seq_len; ++t) {
        // 获取当前时间步的输入指针
        // input_x shape: [batch, seq, input_size]
        // 当前层如果是第0层，input_size 是原始 input_size
        // 如果是第 l 层，input_size 其实是 hidden_size (来自上一层输出)

        // 由于我们要在一个 kernel 里跑完所有 layers，这会导致严重的同步问题或复杂的逻辑
        // **优化策略**：
        // 题目要求实现 "多层" GRU。
        // 方案 A: 一个 Kernel 跑完所有 Layers 和 Seq。这很难，因为 Layer 1 依赖 Layer 0 的输出。
        // 方案 B: 外部循环 Layer，Kernel 处理 Seq 和 Batch。
        // 鉴于 `bang_func` 是一次调用，且不能创建新队列（意味着只能 Launch 一次或同步 Launch），
        // 我们必须在一次 Kernel 启动中完成，或者利用 Global Memory 作为 Layer 间的交换。
        // 考虑到性能和实现难度，通常的做法是：
        // Kernel 内部循环 Layer。
        // Layer 0 读取 input_x。
        // Layer > 0 读取上一层写入 output_y (注意：output_y 在当前时间步 t 已经被上一层写入了吗？是的，因为是顺序处理 t)。
        // 但是，output_y 的形状是 [batch, seq, hidden]。
        // 当处理 Layer 1, Time t 时，Layer 0, Time t 的结果必须已经存在于 Global Memory 中。
        // 由于我们在同一个 Kernel 中串行处理 Layer，这是安全的。

        // 确定当前层的输入维度
        int cur_in_size = (l == 0) ? input_size : hidden_size;

        // 获取当前层的权重指针
        // weights 是一维数组展平的吗？题目没明说，但通常是这样。
        // 假设 weights_ih 是 [num_layers, 3*H, max(input_size, hidden_size)] ?
        // 不，PyTorch 的 parameter list 是分开的。
        // 这里的 C++ wrapper 只有 input_size, hidden_size。
        // 我们必须假设权重是以某种连续方式传入的，或者题目隐含了权重的布局。
        // 观察 Reference Implementation: 它是分开传入 w_ih_l0, w_hh_l0...
        // 但 bang_func 签名里没有这些！
        // **关键点**：题目描述说 "输入参数包含...参考代码中__init__部分定义的其他参数"。
        // 这意味着 `bang_func` 的参数列表应该被扩展，或者我们需要从 `input` tensor 中解析？
        // 不，题目明确说 `bang_func(torch::Tensor input, ...)`。
        // 结合 "题目138_GRU_forward" 和 "Reference Implementation"，
        // 很有可能测试脚本会修改 `bang_func` 的签名来适配权重，
        // 或者权重被打包进了某个 Tensor。
        // **但在无法修改签名的情况下，且必须匹配 Reference**：
        // 这里的 Reference 只是展示了逻辑。
        // 真正的 `bang_func` 签名由评估脚本决定。
        // 题目文字："输入参数包含torch::Tensor input和参考代码中__init__部分定义的其他参数"。
        // 这句话暗示 `bang_func` 的定义应该是：
        // torch::Tensor bang_func(torch::Tensor x, torch::Tensor w_ih_l0, torch::Tensor w_hh_l0, ..., int num_layers)
        // 但是给出的 C++ Wrapper 示例却是：
        // torch::Tensor bang_func(torch::Tensor x, int input_size, int hidden_size, int num_layers);
        // 这存在矛盾。
        // **解决策略**：严格按照给出的 "C++