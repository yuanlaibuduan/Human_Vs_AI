#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <math.h>

#define CHUNK_SIZE 1024

__mlu_entry__ void gru_layer_kernel(
    float *g_in_seq,
    float *g_out_seq,
    float *g_w_ih,
    float *g_w_hh,
    float *g_b_ih,
    float *g_b_hh,
    int B,
    int T,
    int I,
    int H
) {
    uint32_t core = taskId;
    uint32_t ncore = taskDim;

    int B_per_core = B / ncore;
    int rem = B % ncore;
    int st = core * B_per_core + (core < rem ? core : rem);
    int cnt = B_per_core + (core < rem ? 1 : 0);

    __nram__ float nx[CHUNK_SIZE];
    __nram__ float h_prev[CHUNK_SIZE];
    __nram__ float tmp0[CHUNK_SIZE];
    __nram__ float tmp1[CHUNK_SIZE];
    __nram__ float tmp2[CHUNK_SIZE];

    int G3 = 3 * H;

    for (int b = 0; b < cnt; b++) {
        int curB = st + b;

        // h0 = 0
        for (int i = 0; i < H; i++)
            h_prev[i] = 0.0f;

        for (int t = 0; t < T; t++) {
            // 加载 x_t
            int x_off = curB * T * I + t * I;
            __memcpy(nx, g_in_seq + x_off, I * 4, GDRAM2NRAM);

            // W_ih @ x + b_ih
            for (int g = 0; g < G3; g++) {
                float s = g_b_ih[g];
                for (int i = 0; i < I; i++)
                    s += g_w_ih[g * I + i] * nx[i];
                tmp0[g] = s;
            }

            // W_hh @ h_prev + b_hh
            for (int g = 0; g < G3; g++) {
                float s = g_b_hh[g];
                for (int k = 0; k < H; k++)
                    s += g_w_hh[g * H + k] * h_prev[k];
                tmp1[g] = s;
            }

            // 计算 z, r, n（纯 C 标准数学函数）
            for (int k = 0; k < H; k++) {
                // z = sigmoid
                float v = tmp0[k] + tmp1[k];
                float ez = expf(-v);
                float z = 1.0f / (1.0f + ez);

                // r = sigmoid
                v = tmp0[H + k] + tmp1[H + k];
                float er = expf(-v);
                float r = 1.0f / (1.0f + er);

                // n = tanh
                v = tmp0[2*H + k] + r * tmp1[2*H + k];
                float n = tanhf(v);

                // h_t = (1-z)*n + z*h_prev
                float h_cur = (1.0f - z) * n + z * h_prev[k];
                tmp2[k] = h_cur;
            }

            // 写回输出
            int out_off = curB * T * H + t * H;
            __memcpy(g_out_seq + out_off, tmp2, H * 4, NRAM2GDRAM);

            // 更新 h_prev
            for (int k = 0; k < H; k++)
                h_prev[k] = tmp2[k];
        }
    }
}

// ==========================
// 对外接口 bang_func
// ==========================
torch::Tensor bang_func(
    torch::Tensor input,
    torch::Tensor weight_ih_l0,
    torch::Tensor weight_hh_l0,
    torch::Tensor bias_ih_l0,
    torch::Tensor bias_hh_l0,
    torch::Tensor weight_ih_l1,
    torch::Tensor weight_hh_l1,
    torch::Tensor bias_ih_l1,
    torch::Tensor bias_hh_l1,
    int input_size,
    int hidden_size,
    int num_layers
) {
    TORCH_CHECK(input.is_contiguous(), "input must be contiguous");
    TORCH_CHECK(input.dim() == 3, "input must be [B, T, C]");

    auto dtype = input.scalar_type();
    torch::Tensor x = input.to(torch::kFloat);

    int B = x.size(0);
    int T = x.size(1);
    torch::Tensor in = x;
    torch::Tensor out;

    for (int L = 0; L < num_layers; L++) {
        float *w_ih, *w_hh, *b_ih, *b_hh;
        int is = (L == 0) ? input_size : hidden_size;

        if (L == 0) {
            w_ih = weight_ih_l0.data_ptr<float>();
            w_hh = weight_hh_l0.data_ptr<float>();
            b_ih = bias_ih_l0.data_ptr<float>();
            b_hh = bias_hh_l0.data_ptr<float>();
        } else {
            w_ih = weight_ih_l1.data_ptr<float>();
            w_hh = weight_hh_l1.data_ptr<float>();
            b_ih = bias_ih_l1.data_ptr<float>();
            b_hh = bias_hh_l1.data_ptr<float>();
        }

        out = torch::empty({B, T, hidden_size}, x.options());

        cnrtQueue_t q = torch_mlu::getCurMLUStream();
        cnrtDim3_t dim = {8, 1, 1};
        cnrtFunctionType_t k = cnrtFuncTypeUnion1;

        gru_layer_kernel<<<dim, k, q>>>(
            in.data_ptr<float>(),
            out.data_ptr<float>(),
            w_ih, w_hh, b_ih, b_hh,
            B, T, is, hidden_size
        );

        in = out;
    }

    return out.to(dtype);
}