#include <bang.h>
#include <torch/extension.h>
#include <torch_mlu/csrc/core/MLUStream.h>
#include <cnrt.h>
#include <stdint.h>

#define TASK_NUM 16
#define CHUNK_SIZE 1024

// gates 顺序按照 PyTorch GRU:
// 0: reset gate r
// 1: update gate z
// 2: new gate n

__mlu_entry__ void zero_kernel(float* ptr, int total) {
    int tid = taskId;
    int step = taskDim;

    for (int i = tid; i < total; i += step) {
        ptr[i] = 0.0f;
    }
}


__mlu_entry__ void gru_linear_kernel(
    const float* input_seq,
    const float* h_state,
    const float* weight_ih,
    const float* weight_hh,
    const float* bias_ih,
    const float* bias_hh,
    float* gates_x,
    float* gates_h,
    int batch,
    int seq_len,
    int cur_t,
    int input_size,
    int hidden_size) {

    int total = batch * 3 * hidden_size;
    int tid = taskId;
    int step = taskDim;

    for (int idx = tid; idx < total; idx += step) {
        int b = idx / (3 * hidden_size);
        int row = idx - b * 3 * hidden_size;

        const float* x_ptr =
            input_seq + (b * seq_len + cur_t) * input_size;

        const float* h_ptr =
            h_state + b * hidden_size;

        const float* w_ih_row =
            weight_ih + row * input_size;

        const float* w_hh_row =
            weight_hh + row * hidden_size;

        float sx = bias_ih[row];
        float sh = bias_hh[row];

        for (int k = 0; k < input_size; ++k) {
            sx += x_ptr[k] * w_ih_row[k];
        }

        for (int k = 0; k < hidden_size; ++k) {
            sh += h_ptr[k] * w_hh_row[k];
        }

        gates_x[idx] = sx;
        gates_h[idx] = sh;
    }
}


__mlu_entry__ void gru_update_kernel(
    const float* gates_x,
    const float* gates_h,
    float* h_state,
    float* output_seq,
    int batch,
    int seq_len,
    int cur_t,
    int hidden_size) {

    int chunks_per_batch =
        (hidden_size + CHUNK_SIZE - 1) / CHUNK_SIZE;

    int total_chunks = batch * chunks_per_batch;

    __nram__ float xr[CHUNK_SIZE];
    __nram__ float xz[CHUNK_SIZE];
    __nram__ float xn[CHUNK_SIZE];

    __nram__ float hr[CHUNK_SIZE];
    __nram__ float hz[CHUNK_SIZE];
    __nram__ float hn[CHUNK_SIZE];

    __nram__ float hprev[CHUNK_SIZE];
    __nram__ float tmp[CHUNK_SIZE];

    for (int cid = taskId; cid < total_chunks; cid += taskDim) {
        int b = cid / chunks_per_batch;
        int chunk_id = cid - b * chunks_per_batch;

        int off = chunk_id * CHUNK_SIZE;
        int len = hidden_size - off;
        if (len > CHUNK_SIZE) {
            len = CHUNK_SIZE;
        }

        int aligned_len = (len + 63) & ~63;

        const float* gx_base = gates_x + b * 3 * hidden_size;
        const float* gh_base = gates_h + b * 3 * hidden_size;

        __memcpy(
            xr,
            gx_base + 0 * hidden_size + off,
            len * sizeof(float),
            GDRAM2NRAM);

        __memcpy(
            xz,
            gx_base + 1 * hidden_size + off,
            len * sizeof(float),
            GDRAM2NRAM);

        __memcpy(
            xn,
            gx_base + 2 * hidden_size + off,
            len * sizeof(float),
            GDRAM2NRAM);

        __memcpy(
            hr,
            gh_base + 0 * hidden_size + off,
            len * sizeof(float),
            GDRAM2NRAM);

        __memcpy(
            hz,
            gh_base + 1 * hidden_size + off,
            len * sizeof(float),
            GDRAM2NRAM);

        __memcpy(
            hn,
            gh_base + 2 * hidden_size + off,
            len * sizeof(float),
            GDRAM2NRAM);

        __memcpy(
            hprev,
            h_state + b * hidden_size + off,
            len * sizeof(float),
            GDRAM2NRAM);

        // r = sigmoid(x_r + h_r)
        __bang_add(xr, xr, hr, aligned_len);
        __bang_active_sigmoid(xr, xr, aligned_len);

        // z = sigmoid(x_z + h_z)
        __bang_add(xz, xz, hz, aligned_len);
        __bang_active_sigmoid(xz, xz, aligned_len);

        // n = tanh(x_n + r * h_n)
        __bang_mul(hn, hn, xr, aligned_len);
        __bang_add(xn, xn, hn, aligned_len);
        __bang_active_tanh(xn, xn, aligned_len);

        // h = n + z * (h_prev - n)
        __bang_sub(tmp, hprev, xn, aligned_len);
        __bang_mul(tmp, tmp, xz, aligned_len);
        __bang_add(xn, xn, tmp, aligned_len);

        __memcpy(
            h_state + b * hidden_size + off,
            xn,
            len * sizeof(float),
            NRAM2GDRAM);

        __memcpy(
            output_seq + (b * seq_len + cur_t) * hidden_size + off,
            xn,
            len * sizeof(float),
            NRAM2GDRAM);
    }
}


torch::Tensor bang_func(
    torch::Tensor x,

    torch::Tensor weight_ih_l0,
    torch::Tensor weight_hh_l0,
    torch::Tensor bias_ih_l0,
    torch::Tensor bias_hh_l0,

    torch::Tensor weight_ih_l1,
    torch::Tensor weight_hh_l1,
    torch::Tensor bias_ih_l1,
    torch::Tensor bias_hh_l1,

    int input_size,
    int hidden_size,
    int num_layers) {

    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
    TORCH_CHECK(weight_ih_l0.is_contiguous(), "weight_ih_l0 must be contiguous");
    TORCH_CHECK(weight_hh_l0.is_contiguous(), "weight_hh_l0 must be contiguous");
    TORCH_CHECK(bias_ih_l0.is_contiguous(), "bias_ih_l0 must be contiguous");
    TORCH_CHECK(bias_hh_l0.is_contiguous(), "bias_hh_l0 must be contiguous");
    TORCH_CHECK(weight_ih_l1.is_contiguous(), "weight_ih_l1 must be contiguous");
    TORCH_CHECK(weight_hh_l1.is_contiguous(), "weight_hh_l1 must be contiguous");
    TORCH_CHECK(bias_ih_l1.is_contiguous(), "bias_ih_l1 must be contiguous");
    TORCH_CHECK(bias_hh_l1.is_contiguous(), "bias_hh_l1 must be contiguous");

    TORCH_CHECK(num_layers == 2, "this implementation supports num_layers = 2");
    TORCH_CHECK(x.scalar_type() == torch::kFloat, "x must be float32");
    TORCH_CHECK(weight_ih_l0.scalar_type() == torch::kFloat, "weight must be float32");

    int batch = x.size(0);
    int seq_len = x.size(1);

    TORCH_CHECK(x.size(2) == input_size, "input_size mismatch");

    auto options = x.options();

    auto layer0_out = torch::empty(
        {batch, seq_len, hidden_size},
        options);

    auto output = torch::empty(
        {batch, seq_len, hidden_size},
        options);

    auto h_state = torch::empty(
        {batch, hidden_size},
        options);

    auto gates_x = torch::empty(
        {batch, 3 * hidden_size},
        options);

    auto gates_h = torch::empty(
        {batch, 3 * hidden_size},
        options);

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    cnrtDim3_t dim;
    dim.x = TASK_NUM;
    dim.y = 1;
    dim.z = 1;

    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    // layer 0
    zero_kernel<<<dim, ktype, queue>>>(
        h_state.data_ptr<float>(),
        batch * hidden_size);

    for (int t = 0; t < seq_len; ++t) {
        gru_linear_kernel<<<dim, ktype, queue>>>(
            x.data_ptr<float>(),
            h_state.data_ptr<float>(),
            weight_ih_l0.data_ptr<float>(),
            weight_hh_l0.data_ptr<float>(),
            bias_ih_l0.data_ptr<float>(),
            bias_hh_l0.data_ptr<float>(),
            gates_x.data_ptr<float>(),
            gates_h.data_ptr<float>(),
            batch,
            seq_len,
            t,
            input_size,
            hidden_size);

        gru_update_kernel<<<dim, ktype, queue>>>(
            gates_x.data_ptr<float>(),
            gates_h.data_ptr<float>(),
            h_state.data_ptr<float>(),
            layer0_out.data_ptr<float>(),
            batch,
            seq_len,
            t,
            hidden_size);
    }

    // layer 1
    zero_kernel<<<dim, ktype, queue>>>(
        h_state.data_ptr<float>(),
        batch * hidden_size);

    for (int t = 0; t < seq_len; ++t) {
        gru_linear_kernel<<<dim, ktype, queue>>>(
            layer0_out.data_ptr<float>(),
            h_state.data_ptr<float>(),
            weight_ih_l1.data_ptr<float>(),
            weight_hh_l1.data_ptr<float>(),
            bias_ih_l1.data_ptr<float>(),
            bias_hh_l1.data_ptr<float>(),
            gates_x.data_ptr<float>(),
            gates_h.data_ptr<float>(),
            batch,
            seq_len,
            t,
            hidden_size,
            hidden_size);

        gru_update_kernel<<<dim, ktype, queue>>>(
            gates_x.data_ptr<float>(),
            gates_h.data_ptr<float>(),
            h_state.data_ptr<float>(),
            output.data_ptr<float>(),
            batch,
            seq_len,
            t,
            hidden_size);
    }

    return output;
}