#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <math.h>

__mlu_entry__ void gru_zero_hidden_kernel(
    float *h0,
    float *h1,
    int total) {

    for (int idx = taskId; idx < total; idx += taskDim) {
        h0[idx] = 0.0f;
        h1[idx] = 0.0f;
    }
}

__mlu_entry__ void gru_layer0_step_kernel(
    float *x,
    float *h_prev,
    float *h_next,
    float *weight_ih,
    float *weight_hh,
    float *bias_ih,
    float *bias_hh,
    int time_idx,
    int batch,
    int seq_len,
    int input_size,
    int hidden_size) {

    int total = batch * hidden_size;

    for (int idx = taskId; idx < total; idx += taskDim) {
        int b = idx / hidden_size;
        int h = idx - b * hidden_size;

        int row_r = h;
        int row_z = hidden_size + h;
        int row_n = 2 * hidden_size + h;

        float ir = bias_ih[row_r];
        float iz = bias_ih[row_z];
        float in_gate = bias_ih[row_n];
        float hr = bias_hh[row_r];
        float hz = bias_hh[row_z];
        float hn = bias_hh[row_n];

        int x_base = (b * seq_len + time_idx) * input_size;
        for (int i = 0; i < input_size; ++i) {
            float v = x[x_base + i];
            ir += weight_ih[row_r * input_size + i] * v;
            iz += weight_ih[row_z * input_size + i] * v;
            in_gate += weight_ih[row_n * input_size + i] * v;
        }

        int h_base = b * hidden_size;
        for (int i = 0; i < hidden_size; ++i) {
            float prev = h_prev[h_base + i];
            hr += weight_hh[row_r * hidden_size + i] * prev;
            hz += weight_hh[row_z * hidden_size + i] * prev;
            hn += weight_hh[row_n * hidden_size + i] * prev;
        }

        float r = 1.0f / (1.0f + expf(-(ir + hr)));
        float z = 1.0f / (1.0f + expf(-(iz + hz)));
        float n_val = tanhf(in_gate + r * hn);
        h_next[h_base + h] = n_val + z * (h_prev[h_base + h] - n_val);
    }
}

__mlu_entry__ void gru_layer1_step_kernel(
    float *layer_input,
    float *h_prev,
    float *h_next,
    float *weight_ih,
    float *weight_hh,
    float *bias_ih,
    float *bias_hh,
    float *output,
    int time_idx,
    int batch,
    int seq_len,
    int hidden_size) {

    int total = batch * hidden_size;

    for (int idx = taskId; idx < total; idx += taskDim) {
        int b = idx / hidden_size;
        int h = idx - b * hidden_size;

        int row_r = h;
        int row_z = hidden_size + h;
        int row_n = 2 * hidden_size + h;

        float ir = bias_ih[row_r];
        float iz = bias_ih[row_z];
        float in_gate = bias_ih[row_n];
        float hr = bias_hh[row_r];
        float hz = bias_hh[row_z];
        float hn = bias_hh[row_n];

        int h_base = b * hidden_size;
        for (int i = 0; i < hidden_size; ++i) {
            float v = layer_input[h_base + i];
            ir += weight_ih[row_r * hidden_size + i] * v;
            iz += weight_ih[row_z * hidden_size + i] * v;
            in_gate += weight_ih[row_n * hidden_size + i] * v;
        }

        for (int i = 0; i < hidden_size; ++i) {
            float prev = h_prev[h_base + i];
            hr += weight_hh[row_r * hidden_size + i] * prev;
            hz += weight_hh[row_z * hidden_size + i] * prev;
            hn += weight_hh[row_n * hidden_size + i] * prev;
        }

        float r = 1.0f / (1.0f + expf(-(ir + hr)));
        float z = 1.0f / (1.0f + expf(-(iz + hz)));
        float n_val = tanhf(in_gate + r * hn);
        float new_h = n_val + z * (h_prev[h_base + h] - n_val);

        h_next[h_base + h] = new_h;
        output[(b * seq_len + time_idx) * hidden_size + h] = new_h;
    }
}

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor weight_ih_l0,
    torch::Tensor weight_hh_l0,
    torch::Tensor bias_ih_l0,
    torch::Tensor bias_hh_l0,
    torch::Tensor weight_ih_l1,
    torch::Tensor weight_hh_l1,
    torch::Tensor bias_ih_l1,
    torch::Tensor bias_hh_l1,
    int input_size,
    int hidden_size,
    int num_layers) {

    TORCH_CHECK(x.dim() == 3, "Input x must be [batch, seq_len, input_size]");
    TORCH_CHECK(x.size(2) == input_size, "input_size mismatch");
    TORCH_CHECK(num_layers == 2, "This implementation expects num_layers == 2");

    TORCH_CHECK(weight_ih_l0.size(0) == 3 * hidden_size &&
                    weight_ih_l0.size(1) == input_size,
                "weight_ih_l0 shape mismatch");
    TORCH_CHECK(weight_hh_l0.size(0) == 3 * hidden_size &&
                    weight_hh_l0.size(1) == hidden_size,
                "weight_hh_l0 shape mismatch");
    TORCH_CHECK(weight_ih_l1.size(0) == 3 * hidden_size &&
                    weight_ih_l1.size(1) == hidden_size,
                "weight_ih_l1 shape mismatch");
    TORCH_CHECK(weight_hh_l1.size(0) == 3 * hidden_size &&
                    weight_hh_l1.size(1) == hidden_size,
                "weight_hh_l1 shape mismatch");
    TORCH_CHECK(bias_ih_l0.numel() == 3 * hidden_size, "bias_ih_l0 shape mismatch");
    TORCH_CHECK(bias_hh_l0.numel() == 3 * hidden_size, "bias_hh_l0 shape mismatch");
    TORCH_CHECK(bias_ih_l1.numel() == 3 * hidden_size, "bias_ih_l1 shape mismatch");
    TORCH_CHECK(bias_hh_l1.numel() == 3 * hidden_size, "bias_hh_l1 shape mismatch");

    auto original_dtype = x.scalar_type();
    torch::Tensor x_fp32 =
        original_dtype == torch::kFloat ? x.contiguous()
                                        : x.to(torch::kFloat).contiguous();
    torch::Tensor w_ih0 =
        weight_ih_l0.scalar_type() == torch::kFloat
            ? weight_ih_l0.contiguous()
            : weight_ih_l0.to(torch::kFloat).contiguous();
    torch::Tensor w_hh0 =
        weight_hh_l0.scalar_type() == torch::kFloat
            ? weight_hh_l0.contiguous()
            : weight_hh_l0.to(torch::kFloat).contiguous();
    torch::Tensor b_ih0 =
        bias_ih_l0.scalar_type() == torch::kFloat
            ? bias_ih_l0.contiguous()
            : bias_ih_l0.to(torch::kFloat).contiguous();
    torch::Tensor b_hh0 =
        bias_hh_l0.scalar_type() == torch::kFloat
            ? bias_hh_l0.contiguous()
            : bias_hh_l0.to(torch::kFloat).contiguous();
    torch::Tensor w_ih1 =
        weight_ih_l1.scalar_type() == torch::kFloat
            ? weight_ih_l1.contiguous()
            : weight_ih_l1.to(torch::kFloat).contiguous();
    torch::Tensor w_hh1 =
        weight_hh_l1.scalar_type() == torch::kFloat
            ? weight_hh_l1.contiguous()
            : weight_hh_l1.to(torch::kFloat).contiguous();
    torch::Tensor b_ih1 =
        bias_ih_l1.scalar_type() == torch::kFloat
            ? bias_ih_l1.contiguous()
            : bias_ih_l1.to(torch::kFloat).contiguous();
    torch::Tensor b_hh1 =
        bias_hh_l1.scalar_type() == torch::kFloat
            ? bias_hh_l1.contiguous()
            : bias_hh_l1.to(torch::kFloat).contiguous();

    int batch = x_fp32.size(0);
    int seq_len = x_fp32.size(1);
    TORCH_CHECK(batch > 0 && seq_len > 0 && hidden_size > 0,
                "GRU input dimensions must be non-empty");

    torch::Tensor output_fp32 =
        torch::empty({batch, seq_len, hidden_size}, x_fp32.options());
    torch::Tensor h0_a = torch::empty({batch, hidden_size}, x_fp32.options());
    torch::Tensor h0_b = torch::empty({batch, hidden_size}, x_fp32.options());
    torch::Tensor h1_a = torch::empty({batch, hidden_size}, x_fp32.options());
    torch::Tensor h1_b = torch::empty({batch, hidden_size}, x_fp32.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t kdim = {32, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    int hidden_total = batch * hidden_size;
    gru_zero_hidden_kernel<<<kdim, ktype, queue>>>(
        h0_a.data_ptr<float>(),
        h1_a.data_ptr<float>(),
        hidden_total);

    torch::Tensor h0_prev = h0_a;
    torch::Tensor h0_next = h0_b;
    torch::Tensor h1_prev = h1_a;
    torch::Tensor h1_next = h1_b;

    for (int t = 0; t < seq_len; ++t) {
        gru_layer0_step_kernel<<<kdim, ktype, queue>>>(
            x_fp32.data_ptr<float>(),
            h0_prev.data_ptr<float>(),
            h0_next.data_ptr<float>(),
            w_ih0.data_ptr<float>(),
            w_hh0.data_ptr<float>(),
            b_ih0.data_ptr<float>(),
            b_hh0.data_ptr<float>(),
            t,
            batch,
            seq_len,
            input_size,
            hidden_size);

        gru_layer1_step_kernel<<<kdim, ktype, queue>>>(
            h0_next.data_ptr<float>(),
            h1_prev.data_ptr<float>(),
            h1_next.data_ptr<float>(),
            w_ih1.data_ptr<float>(),
            w_hh1.data_ptr<float>(),
            b_ih1.data_ptr<float>(),
            b_hh1.data_ptr<float>(),
            output_fp32.data_ptr<float>(),
            t,
            batch,
            seq_len,
            hidden_size);

        torch::Tensor tmp0 = h0_prev;
        h0_prev = h0_next;
        h0_next = tmp0;

        torch::Tensor tmp1 = h1_prev;
        h1_prev = h1_next;
        h1_next = tmp1;
    }

    if (original_dtype != torch::kFloat) {
        return output_fp32.to(original_dtype);
    }

    return output_fp32;
}
