#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <torch_mlu/torch_mlu.h>

#define CHUNK_SIZE 1024

// GRU计算公式：
// z_t = σ(W_iz x_t + b_iz + W_hz h_{t-1} + b_hz)  更新门
// r_t = σ(W_ir x_t + b_ir + W_hr h_{t-1} + b_hr)  重置门
// h_tilde_t = tanh(W_in x_t + b_in + r_t ⊙ (W_hn h_{t-1}+b_hn)) 候选隐状态
// h_t = (1-z_t)⊙h_{t-1} + z_t⊙h_tilde_t  当前时刻隐状态
// 权重排布：3*hidden_size, [z, r, n]三段拼接

__mlu_entry__ void gru_layer_kernel(
    float* g_in_x,          // [batch, seq_len, input_size] 当前层输入
    float* g_out_hseq,      // [batch, seq_len, hidden_size] 当前层输出序列
    float* g_w_ih,          // [3H, in_dim] 输入权重
    float* g_w_hh,          // [3H, H] 隐状态递归权重
    float* g_b_ih,          // [3H] 输入偏置
    float* g_b_hh,          // [3H] 隐状态偏置
    int batch,
    int seq_len,
    int in_dim,
    int hidden_dim
) {
    uint32_t core_id = taskId;
    uint32_t core_cnt = taskDim;
    int elem_per_core = batch / core_cnt;
    int rem_batch = batch % core_cnt;

    int batch_start = core_id * elem_per_core + (core_id < rem_batch ? core_id : rem_batch);
    int batch_cur = elem_per_core + (core_id < rem_batch ? 1 : 0);
    if(batch_cur <= 0) return;

    int H = hidden_dim;
    int threeH = 3 * H;

    __nram__ float nram_x[CHUNK_SIZE];
    __nram__ float nram_h_prev[CHUNK_SIZE];
    __nram__ float nram_wih_buf[CHUNK_SIZE];
    __nram__ float nram_whh_buf[CHUNK_SIZE];
    __nram__ float nram_z[CHUNK_SIZE], nram_r[CHUNK_SIZE], nram_n[CHUNK_SIZE];
    __nram__ float nram_b_ih[CHUNK_SIZE], nram_b_hh[CHUNK_SIZE];
    __nram__ float nram_rt_mul_hprev[CHUNK_SIZE];
    __nram__ float nram_h_candidate[CHUNK_SIZE];
    __nram__ float nram_h_cur[CHUNK_SIZE];

    // 初始化每层起始隐状态h0=0
    for(int b=0; b < batch_cur; b++){
        int b_idx = batch_start + b;
        float h_prev[CHUNK_SIZE] = {0.0f};

        for(int t=0; t < seq_len; t++){
            // 当前时刻输入x_t: [in_dim]
            int x_g_offset = b_idx * seq_len * in_dim + t * in_dim;
            // 分步矩阵乘：x @ w_ih.T + b_ih; h_prev @ w_hh.T + b_hh
            for(int off=0; off < threeH; off += CHUNK_SIZE){
                int len = ((off + CHUNK_SIZE) > threeH) ? (threeH - off) : CHUNK_SIZE;
                // 加载bias
                __memcpy(nram_b_ih, g_b_ih + off, len*sizeof(float), GDRAM2NRAM);
                __memcpy(nram_b_hh, g_b_hh + off, len*sizeof(float), GDRAM2NRAM);

                // x * W_ih + b_ih
                __bang_mul_scalar(nram_x, nram_x, 0.0f, CHUNK_SIZE);
                for(int d=0; d < in_dim; d++){
                    __memcpy(nram_wih_buf, g_w_ih + off*in_dim + d, len*sizeof(float), GDRAM2NRAM);
                    float xv = *(g_in_x + x_g_offset + d);
                    __bang_mul_scalar(nram_wih_buf, nram_wih_buf, xv, len);
                    __bang_add(nram_x, nram_x, nram_wih_buf, len);
                }
                __bang_add(nram_x, nram_x, nram_b_ih, len);

                // h_prev * W_hh + b_hh
                __bang_mul_scalar(nram_h_prev, nram_h_prev, 0.0f, CHUNK_SIZE);
                for(int d=0; d < H; d++){
                    __memcpy(nram_whh_buf, g_w_hh + off*H + d, len*sizeof(float), GDRAM2NRAM);
                    float hv = h_prev[d];
                    __bang_mul_scalar(nram_whh_buf, nram_whh_buf, hv, len);
                    __bang_add(nram_h_prev, nram_h_prev, nram_whh_buf, len);
                }
                __bang_add(nram_h_prev, nram_h_prev, nram_b_hh, len);

                // 拆分 z[0:H], r[H:2H], n[2H:3H]
                int split = H - off;
                if(split > 0){
                    int slen = split;
                    __bang_add(nram_z, nram_x, nram_h_prev, slen);
                    __bang_active_sigmoid(nram_z, nram_z, slen);
                }
                split = 2*H - off;
                if(split > H){
                    int slen = split - H;
                    __bang_add(nram_r, nram_x+H, nram_h_prev+H, slen);
                    __bang_active_sigmoid(nram_r, nram_r, slen);
                }
                split = threeH - off;
                if(split > 2*H){
                    int slen = split - 2*H;
                    __bang_mul(nram_rt_mul_hprev, nram_r, nram_h_prev, slen);
                    __bang_add(nram_n, nram_x+2*H, nram_rt_mul_hprev, slen);
                    __bang_active_tanh(nram_n, nram_n, slen);
                }
            }

            // h_t = (1-z)*h_prev + z*n
            __bang_sub_scalar(nram_h_cur, nram_z, 1.0f, H);
            __bang_mul(nram_h_cur, nram_h_cur, nram_h_prev, H);
            __bang_mul(nram_z, nram_z, nram_n, H);
            __bang_add(nram_h_cur, nram_h_cur, nram_z, H);

            // 写回输出
            int out_g_offset = b_idx * seq_len * H + t * H;
            __memcpy(g_out_hseq + out_g_offset, nram_h_cur, H*sizeof(float), NRAM2GDRAM);

            // 更新h_prev为本时刻隐状态
            __memcpy(nram_h_prev, nram_h_cur, H*sizeof(float), NRAM2NRAM);
            for(int i=0;i<H;i++) h_prev[i] = nram_h_cur[i];
        }
    }
}

// C++对外接口
torch::Tensor bang_func(
    torch::Tensor x,
    int input_size,
    int hidden_size,
    int num_layers,
    // 权重参数按init顺序传入：wih0,whh0,bih0,bhh0,wih1,whh1,bih1,bhh1...
    torch::Tensor wih_l0, torch::Tensor whh_l0, torch::Tensor bih_l0, torch::Tensor bhh_l0,
    torch::Tensor wih_l1, torch::Tensor whh_l1, torch::Tensor bih_l1, torch::Tensor bhh_l1
) {
    TORCH_CHECK(x.is_contiguous(), "input x must be contiguous");
    auto ori_dtype = x.scalar_type();
    // 统一转fp32计算
    auto x_fp32 = x.to(torch::kFloat32);
    auto wih0_fp = wih_l0.to(torch::kFloat32).contiguous();
    auto whh0_fp = whh_l0.to(torch::kFloat32).contiguous();
    auto bih0_fp = bih_l0.to(torch::kFloat32).contiguous();
    auto bhh0_fp = bhh_l0.to(torch::kFloat32).contiguous();
    auto wih1_fp = wih_l1.to(torch::kFloat32).contiguous();
    auto whh1_fp = whh_l1.to(torch::kFloat32).contiguous();
    auto bih1_fp = bih_l1.to(torch::kFloat32).contiguous();
    auto bhh1_fp = bhh_l1.to(torch::kFloat32).contiguous();

    auto sz = x_fp32.sizes();
    int batch = sz[0];
    int seq_len = sz[1];
    int in_dim = input_size;
    int hid_dim = hidden_size;

    // 每层输出容器
    auto layer0_out = torch::empty({batch, seq_len, hid_dim}, torch::dtype(torch::kFloat32).device(x.device()));
    auto layer1_in = layer0_out;
    auto layer1_out = torch::empty({batch, seq_len, hid_dim}, torch::dtype(torch::kFloat32).device(x.device()));

    cnrtQueue_t stream = torch_mlu::getCurMLUStream();
    cnrtDim3_t grid_dim = {8, 1, 1};
    auto func_type = cnrtFuncTypeUnion1;

    // 第0层GRU前向
    gru_layer_kernel<<<grid_dim, func_type, stream>>>(
        (float*)x_fp32.data_ptr(),
        (float*)layer0_out.data_ptr(),
        (float*)wih0_fp.data_ptr(),
        (float*)whh0_fp.data_ptr(),
        (float*)bih0_fp.data_ptr(),
        (float*)bhh0_fp.data_ptr(),
        batch, seq_len, in_dim, hid_dim
    );

    if(num_layers >=2){
        // 第1层GRU：输入是上一层输出，输入维度变为hidden_size
        gru_layer_kernel<<<grid_dim, func_type, stream>>>(
            (float*)layer1_in.data_ptr(),
            (float*)layer1_out.data_ptr(),
            (float*)wih1_fp.data_ptr(),
            (float*)whh1_fp.data_ptr(),
            (float*)bih1_fp.data_ptr(),
            (float*)bhh1_fp.data_ptr(),
            batch, seq_len, hid_dim, hid_dim
        );
    }

    torch::Tensor res_fp32 = (num_layers >=2) ? layer1_out : layer0_out;
    // 还原原始数据类型
    return res_fp32.to(ori_dtype);
}

PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
    m.def("bang_func", &bang_func, "MLU GRU forward compute");
}