#include <bang.h>
#include <bang_math.h>
#include <torch/extension.h>
#include <cnrt.h>

#define MIN(a, b) ((a) < (b) ? (a) : (b))
#define CHUNK_N 64
#define CHUNK_K 256

// 辅助矩阵乘法：dst[M][N] = src[M][K] * weight[N][K]^T
static void __nram__ matmul_block(
    float *dst_nram,
    float *src_gdram,
    float *weight_gdram,
    int M, int K, int N,
    float *workspace_nram)
{
    __bang_write_zero(dst_nram, M * N);

    for (int n_start = 0; n_start < N; n_start += CHUNK_N) {
        int n_cur = MIN(CHUNK_N, N - n_start);
        for (int k_start = 0; k_start < K; k_start += CHUNK_K) {
            int k_cur = MIN(CHUNK_K, K - k_start);

            // 加载权重子块 (n_cur, k_cur)
            float *weight_sub = workspace_nram;
            __memcpy(weight_sub,
                     weight_gdram + n_start * K + k_start,
                     n_cur * k_cur * sizeof(float),
                     GDRAM2NRAM);

            // 加载输入子块 (M, k_cur)
            float *src_sub = workspace_nram + n_cur * k_cur;
            __memcpy(src_sub,
                     src_gdram + k_start,
                     M * k_cur * sizeof(float),
                     GDRAM2NRAM);

            // 部分乘积 (M, k_cur) * (k_cur, n_cur) -> (M, n_cur)
            float *partial = workspace_nram + n_cur * k_cur + M * k_cur;
            // __bang_matmul(dst, src, weight, m, k, n, trans_src, trans_weight)
            // 此处 weight 存储为 (n_cur, k_cur)，需要转置，所以 trans_weight=1
            __bang_matmul(partial, src_sub, weight_sub,
                          M, k_cur, n_cur,
                          0, 1);

            // 累加到 dst
            for (int i = 0; i < M; ++i) {
                __bang_add(dst_nram + i * N + n_start,
                           dst_nram + i * N + n_start,
                           partial + i * n_cur,
                           n_cur);
            }
        }
    }
}

// 单层 GRU 核函数
__mlu_entry__ void gru_layer_kernel(
    float *input_seq,
    float *output_seq,
    float *weight_ih,
    float *weight_hh,
    float *bias_ih,
    float *bias_hh,
    int batch, int seq_len, int input_size, int hidden_size)
{
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;

    int batch_per_core = (batch + core_num - 1) / core_num;
    int batch_start = core_id * batch_per_core;
    int batch_end = MIN(batch_start + batch_per_core, batch);
    int M = batch_end - batch_start;
    if (M <= 0) return;

    int N = 3 * hidden_size;
    int K_in = input_size;
    int K_hid = hidden_size;

    // NRAM 分配 (根据最大可能维度预留，实际可动态计算)
    __nram__ float nram_input[8192];
    __nram__ float nram_hidden_prev[8192];
    __nram__ float nram_gates[16384];
    __nram__ float nram_new_hidden[8192];
    __nram__ float nram_workspace[32768];

    __bang_write_zero(nram_hidden_prev, M * hidden_size);

    for (int t = 0; t < seq_len; ++t) {
        // 加载当前输入 (M, input_size)
        float *in_ptr = input_seq + batch_start * seq_len * input_size + t * input_size;
        __memcpy(nram_input, in_ptr, M * input_size * sizeof(float), GDRAM2NRAM);

        // 输入门部分：input * weight_ih^T
        matmul_block(nram_gates, nram_input, weight_ih,
                     M, input_size, N, nram_workspace);
        for (int i = 0; i < M; ++i)
            __bang_add(nram_gates + i * N, nram_gates + i * N, bias_ih, N);

        // 隐藏状态门部分：hidden_prev * weight_hh^T
        matmul_block(nram_workspace, nram_hidden_prev, weight_hh,
                     M, hidden_size, N, nram_workspace + M * N);
        for (int i = 0; i < M; ++i) {
            __bang_add(nram_gates + i * N, nram_gates + i * N, nram_workspace + i * N, N);
            __bang_add(nram_gates + i * N, nram_gates + i * N, bias_hh, N);
        }

        // 拆分三个门并计算新隐藏状态
        for (int i = 0; i < M; ++i) {
            float *gate = nram_gates + i * N;
            float *z = gate;
            float *r = gate + hidden_size;
            float *h = gate + 2 * hidden_size;

            __bang_active_sigmoid(z, z, hidden_size);
            __bang_active_sigmoid(r, r, hidden_size);
            __bang_active_tanh(h, h, hidden_size);

            float *h_prev = nram_hidden_prev + i * hidden_size;
            float *h_new = nram_new_hidden + i * hidden_size;
            // (1 - z) * h_prev + z * h
            __bang_sub_scalar(nram_workspace, z, 1.0f, hidden_size);
            __bang_mul(nram_workspace, nram_workspace, h_prev, hidden_size);
            __bang_mul(h_new, z, h, hidden_size);
            __bang_add(h_new, nram_workspace, h_new, hidden_size);
        }

        // 输出当前时间步
        float *out_ptr = output_seq + batch_start * seq_len * hidden_size + t * hidden_size;
        __memcpy(out_ptr, nram_new_hidden, M * hidden_size * sizeof(float), NRAM2GDRAM);

        // 更新隐藏状态
        __memcpy(nram_hidden_prev, nram_new_hidden, M * hidden_size * sizeof(float), NRAM2NRAM);
    }
}

// 外部接口
at::Tensor bang_func(
    at::Tensor x,
    at::Tensor weight_ih_l0,
    at::Tensor weight_hh_l0,
    at::Tensor bias_ih_l0,
    at::Tensor bias_hh_l0,
    at::Tensor weight_ih_l1,
    at::Tensor weight_hh_l1,
    at::Tensor bias_ih_l1,
    at::Tensor bias_hh_l1,
    int input_size,
    int hidden_size,
    int num_layers)
{
    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
    auto original_dtype = x.scalar_type();
    at::Tensor x_fp32 = (original_dtype == at::kFloat) ? x : x.to(at::kFloat);

    int batch = x_fp32.size(0);
    int seq_len = x_fp32.size(1);

    // 使用 x.new_empty 分配输出，避免直接调用 torch::empty
    at::Tensor output_fp32 = x.new_empty({batch, seq_len, hidden_size});

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim = {16, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    at::Tensor current_input = x_fp32;
    at::Tensor current_output;

    for (int l = 0; l < num_layers; ++l) {
        at::Tensor w_ih, w_hh, b_ih, b_hh;
        if (l == 0) {
            w_ih = weight_ih_l0; w_hh = weight_hh_l0;
            b_ih = bias_ih_l0;   b_hh = bias_hh_l0;
        } else if (l == 1) {
            w_ih = weight_ih_l1; w_hh = weight_hh_l1;
            b_ih = bias_ih_l1;   b_hh = bias_hh_l1;
        } else {
            break;
        }

        current_output = x.new_empty({batch, seq_len, hidden_size});

        gru_layer_kernel<<<dim, ktype, queue>>>(
            current_input.data_ptr<float>(),
            current_output.data_ptr<float>(),
            w_ih.data_ptr<float>(),
            w_hh.data_ptr<float>(),
            b_ih.data_ptr<float>(),
            b_hh.data_ptr<float>(),
            batch, seq_len,
            (l == 0) ? input_size : hidden_size,
            hidden_size
        );

        current_input = current_output;
    }

    if (original_dtype != at::kFloat) {
        return current_output.to(original_dtype);
    }
    return current_output;
}