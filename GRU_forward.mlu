#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <string>

// 常量定义
#define CHUNK_SIZE 1024
#define GRU_GATE_NUM 3    // 更新门z、重置门r、候选隐态n
#define ALIGN_BOUND 64

/*
GRU标准计算公式：
z_t = σ(W_iz·x_t + b_iz + W_hz·h_{t-1}+b_hz)
r_t = σ(W_ir·x_t + b_ir + W_hr·h_{t-1}+b_hr)
n_t = tanh(W_in·x_t + b_in + r_t⊙(W_hn·h_{t-1}+b_hn))
h_t = (1-z_t)⊙n_t + z_t⊙h_{t-1}
*/

// GRU单层单Batch核函数 (纯BangC实现，无任何torch/at调用)
__mlu_entry__ void gru_layer_kernel(
    float* g_in_seq,
    float* g_out_hseq,
    float* g_w_ih,
    float* g_w_hh,
    float* g_b_ih,
    float* g_b_hh,
    int batch,
    int seq_len,
    int in_size,
    int hid_size
) {
    uint32_t core_id = taskId;
    uint32_t core_cnt = taskDim;

    // 按Batch维度拆分多核任务
    uint32_t per_core_batch = batch / core_cnt;
    uint32_t batch_remain = batch % core_cnt;
    uint32_t start_b = core_id * per_core_batch + (core_id < batch_remain ? core_id : batch_remain);
    uint32_t core_b_cnt = per_core_batch + (core_id < batch_remain ? 1 : 0);

    // NRAM 高速缓存
    __nram__ float n_x[CHUNK_SIZE];
    __nram__ float n_h_prev[CHUNK_SIZE];
    __nram__ float n_ih_out[3 * CHUNK_SIZE];
    __nram__ float n_hh_out[3 * CHUNK_SIZE];
    __nram__ float n_z[CHUNK_SIZE];
    __nram__ float n_r[CHUNK_SIZE];
    __nram__ float n_n[CHUNK_SIZE];
    __nram__ float n_h_cur[CHUNK_SIZE];

    int gate3 = 3 * hid_size;

    // 遍历当前核心负责的Batch样本
    for (int b_idx = 0; b_idx < core_b_cnt; b_idx++) {
        int cur_b = start_b + b_idx;
        __bang_set_constant(n_h_prev, 0.0f, hid_size);

        // 逐时间步计算
        for (int t = 0; t < seq_len; t++) {
            // 读取当前时刻输入 x_t
            int x_offset = cur_b * seq_len * in_size + t * in_size;
            __memcpy(n_x, g_in_seq + x_offset, in_size * sizeof(float), GDRAM2NRAM);

            // W_ih @ x + bias_ih
            __bang_gemm(n_ih_out, g_w_ih, n_x, gate3, in_size, 1, false, true);
            __bang_add_bias(n_ih_out, n_ih_out, g_b_ih, gate3);

            // W_hh @ h_prev + bias_hh
            __bang_gemm(n_hh_out, g_w_hh, n_h_prev, gate3, hid_size, 1, false, true);
            __bang_add_bias(n_hh_out, n_hh_out, g_b_hh, gate3);

            // 拆分三个门：z / r / n
            float* n_iz = n_ih_out;
            float* n_ir = n_ih_out + hid_size;
            float* n_in = n_ih_out + 2 * hid_size;

            float* n_hz = n_hh_out;
            float* n_hr = n_hh_out + hid_size;
            float* n_hn = n_hh_out + 2 * hid_size;

            // 更新门 z
            __bang_add(n_z, n_iz, n_hz, hid_size);
            __bang_active_sigmoid(n_z, n_z, hid_size);

            // 重置门 r
            __bang_add(n_r, n_ir, n_hr, hid_size);
            __bang_active_sigmoid(n_r, n_r, hid_size);

            // 候选隐状态 n
            __bang_mul(n_hn, n_r, n_hn, hid_size);
            __bang_add(n_n, n_in, n_hn, hid_size);
            __bang_active_tanh(n_n, n_n, hid_size);

            // 计算当前隐状态 h_t
            __bang_sub_scalar(n_h_cur, n_z, 1.0f, hid_size);
            __bang_mul(n_h_cur, n_h_cur, n_n, hid_size);
            __bang_mul(n_z, n_z, n_h_prev, hid_size);
            __bang_add(n_h_cur, n_h_cur, n_z, hid_size);

            // 写回输出
            int out_offset = cur_b * seq_len * hid_size + t * hid_size;
            __memcpy(g_out_hseq + out_offset, n_h_cur, hid_size * sizeof(float), NRAM2GDRAM);

            // 更新上一时刻隐状态
            __bang_copy(n_h_prev, n_h_cur, hid_size);
        }
    }
}

// ===================== 对外接口：bang_func 严格合规 =====================
// 入参包含所有权重 + 输入张量，完全移除 torch::get_parameter 等高阶API
torch::Tensor bang_func(
    // 输入特征
    torch::Tensor input,
    // 第0层权重
    torch::Tensor weight_ih_l0,
    torch::Tensor weight_hh_l0,
    torch::Tensor bias_ih_l0,
    torch::Tensor bias_hh_l0,
    // 第1层权重
    torch::Tensor weight_ih_l1,
    torch::Tensor weight_hh_l1,
    torch::Tensor bias_ih_l1,
    torch::Tensor bias_hh_l1,
    // 结构参数
    int input_size,
    int hidden_size,
    int num_layers
) {
    // 输入校验（仅使用基础检查，无torch算子计算）
    TORCH_CHECK(input.is_contiguous(), "GRU input must be contiguous");
    TORCH_CHECK(input.dim() == 3, "Input shape: [batch, seq_len, input_size]");

    // 统一转为 FP32 计算（题目强制要求）
    auto dtype = input.scalar_type();
    torch::Tensor x = (dtype != torch::kFloat) ? input.to(torch::kFloat) : input;

    int batch = x.size(0);
    int seq_len = x.size(1);
    torch::Tensor layer_in = x;
    torch::Tensor layer_out;

    // 逐层执行GRU
    for (int layer = 0; layer < num_layers; ++layer) {
        float* w_ih_ptr;
        float* w_hh_ptr;
        float* b_ih_ptr;
        float* b_hh_ptr;
        int cur_in_dim;

        // 按层选择权重指针（直接取data_ptr，无torch算子调用）
        if (layer == 0) {
            w_ih_ptr = weight_ih_l0.data_ptr<float>();
            w_hh_ptr = weight_hh_l0.data_ptr<float>();
            b_ih_ptr = bias_ih_l0.data_ptr<float>();
            b_hh_ptr = bias_hh_l0.data_ptr<float>();
            cur_in_dim = input_size;
        } else {
            w_ih_ptr = weight_ih_l1.data_ptr<float>();
            w_hh_ptr = weight_hh_l1.data_ptr<float>();
            b_ih_ptr = bias_ih_l1.data_ptr<float>();
            b_hh_ptr = bias_hh_l1.data_ptr<float>();
            cur_in_dim = hidden_size;
        }

        // 分配输出空间
        layer_out = torch::empty({batch, seq_len, hidden_size}, x.options());

        // 获取MLU流（不新建队列，严格遵守约束）
        cnrtQueue_t queue = torch_mlu::getCurMLUStream();
        cnrtDim3_t dim = {8, 1, 1};
        cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

        // 启动核函数（纯指针传递，无torch算子）
        gru_layer_kernel<<<dim, ktype, queue>>>(
            layer_in.data_ptr<float>(),
            layer_out.data_ptr<float>(),
            w_ih_ptr,
            w_hh_ptr,
            b_ih_ptr,
            b_hh_ptr,
            batch,
            seq_len,
            cur_in_dim,
            hidden_size
        );

        layer_in = layer_out;
    }

    // 转回原始精度返回
    return (dtype != torch::kFloat) ? layer_out.to(dtype) : layer_out;
}