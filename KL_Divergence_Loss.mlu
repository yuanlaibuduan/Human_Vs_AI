#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <math.h>

#define KL_PARTS 4

__mlu_entry__ void kl_div_reduce_kernel(
    float *input_log_prob,
    float *target_prob,
    float *partial_sum,
    int total) {

    for (int part = taskId; part < KL_PARTS; part += taskDim) {
        int begin = part * total / KL_PARTS;
        int end = (part + 1) * total / KL_PARTS;
        float sum = 0.0f;

        for (int idx = begin; idx < end; ++idx) {
            float target = target_prob[idx];
            if (target > 0.0f) {
                sum += target * (logf(target) - input_log_prob[idx]);
            }
        }

        partial_sum[part] = sum;
    }
}

__mlu_entry__ void kl_div_finalize_kernel(
    float *partial_sum,
    float *output,
    int batch) {

    if (taskId != 0) {
        return;
    }

    float sum = 0.0f;
    for (int i = 0; i < KL_PARTS; ++i) {
        sum += partial_sum[i];
    }
    output[0] = sum / (float)batch;
}

torch::Tensor bang_func(
    torch::Tensor input_log_prob,
    torch::Tensor target_prob) {

    TORCH_CHECK(input_log_prob.dim() == 2, "input_log_prob must be a 2D tensor");
    TORCH_CHECK(target_prob.dim() == 2, "target_prob must be a 2D tensor");
    TORCH_CHECK(input_log_prob.size(0) == target_prob.size(0),
                "batch dimension mismatch");
    TORCH_CHECK(input_log_prob.size(1) == target_prob.size(1),
                "class dimension mismatch");

    auto original_dtype = input_log_prob.scalar_type();
    torch::Tensor input_fp32 =
        original_dtype == torch::kFloat
            ? input_log_prob.contiguous()
            : input_log_prob.to(torch::kFloat).contiguous();
    torch::Tensor target_fp32 =
        target_prob.scalar_type() == torch::kFloat
            ? target_prob.contiguous()
            : target_prob.to(torch::kFloat).contiguous();

    int batch = input_fp32.size(0);
    int classes = input_fp32.size(1);
    TORCH_CHECK(batch > 0 && classes > 0, "KL input dimensions must be non-empty");
    int total = batch * classes;

    torch::Tensor partial_sum =
        torch::empty({KL_PARTS}, input_fp32.options());
    torch::Tensor output_fp32 =
        torch::empty({}, input_fp32.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t reduce_dim = {4, 1, 1};
    cnrtDim3_t finalize_dim = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    kl_div_reduce_kernel<<<reduce_dim, ktype, queue>>>(
        input_fp32.data_ptr<float>(),
        target_fp32.data_ptr<float>(),
        partial_sum.data_ptr<float>(),
        total);

    kl_div_finalize_kernel<<<finalize_dim, ktype, queue>>>(
        partial_sum.data_ptr<float>(),
        output_fp32.data_ptr<float>(),
        batch);

    if (original_dtype != torch::kFloat) {
        return output_fp32.to(original_dtype);
    }

    return output_fp32;
}
