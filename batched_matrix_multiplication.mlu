#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <stdint.h>

#define TILE_COLS 64
#define ALIGN_UP_64(x) (((x) + 63) & ~63)

__mlu_entry__ void batch_product_kernel(
    float *A,
    float *B,
    float *C,
    int batch,
    int m_rows,
    int k_cols,
    int n_cols) {

    __nram__ float acc[TILE_COLS + 64];
    __nram__ float rhs[TILE_COLS + 64];
    __nram__ float tmp[TILE_COLS + 64];

    int tile_count = (n_cols + TILE_COLS - 1) / TILE_COLS;
    int total_tiles = batch * m_rows * tile_count;

    for (int tile_id = taskId; tile_id < total_tiles; tile_id += taskDim) {
        int col_tile = tile_id % tile_count;
        int row_id = (tile_id / tile_count) % m_rows;
        int batch_id = tile_id / (tile_count * m_rows);
        int col_begin = col_tile * TILE_COLS;
        int valid_cols = n_cols - col_begin;
        if (valid_cols > TILE_COLS) {
            valid_cols = TILE_COLS;
        }
        int aligned_cols = ALIGN_UP_64(valid_cols);

        __bang_write_zero(acc, aligned_cols);

        float *a_base = A + (batch_id * m_rows + row_id) * k_cols;
        float *b_base = B + batch_id * k_cols * n_cols + col_begin;

        for (int kk = 0; kk < k_cols; ++kk) {
            float a_val = a_base[kk];
            __bang_write_zero(rhs, aligned_cols);
            __memcpy(
                rhs,
                b_base + kk * n_cols,
                valid_cols * sizeof(float),
                GDRAM2NRAM);
            __bang_mul_scalar(tmp, rhs, a_val, aligned_cols);
            __bang_add(acc, acc, tmp, aligned_cols);
        }

        __memcpy(
            C + (batch_id * m_rows + row_id) * n_cols + col_begin,
            acc,
            valid_cols * sizeof(float),
            NRAM2GDRAM);
    }
}

torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
    TORCH_CHECK(A.dim() == 3, "A must be a 3D tensor");
    TORCH_CHECK(B.dim() == 3, "B must be a 3D tensor");
    TORCH_CHECK(A.size(0) == B.size(0), "batch dimension mismatch");
    TORCH_CHECK(A.size(2) == B.size(1), "inner dimension mismatch");

    auto original_dtype = A.scalar_type();
    torch::Tensor A_fp32 =
        original_dtype == torch::kFloat ? A.contiguous()
                                        : A.to(torch::kFloat).contiguous();
    torch::Tensor B_fp32 =
        B.scalar_type() == torch::kFloat ? B.contiguous()
                                         : B.to(torch::kFloat).contiguous();

    int batch = A_fp32.size(0);
    int m_rows = A_fp32.size(1);
    int k_cols = A_fp32.size(2);
    int n_cols = B_fp32.size(2);

    torch::Tensor C_fp32 =
        torch::empty({batch, m_rows, n_cols}, A_fp32.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t kdim = {32, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    batch_product_kernel<<<kdim, ktype, queue>>>(
        A_fp32.data_ptr<float>(),
        B_fp32.data_ptr<float>(),
        C_fp32.data_ptr<float>(),
        batch,
        m_rows,
        k_cols,
        n_cols);

    if (original_dtype != torch::kFloat) {
        return C_fp32.to(original_dtype);
    }

    return C_fp32;
}
