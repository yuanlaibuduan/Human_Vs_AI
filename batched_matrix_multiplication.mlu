#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

// 片上内存分块大小，适配MLU NRAM
#define BLOCK_M 64
#define BLOCK_K 64
#define BLOCK_N 64

// MLU核函数：单batch矩阵乘，外层由host遍历batch
__mlu_entry__ void bmm_kernel(
    const float* A_gd,
    const float* B_gd,
    float* C_gd,
    int m, int k, int n,
    int batch_stride_A,
    int batch_stride_B,
    int batch_stride_C
) {
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;

    // 按行拆分M维度给多核
    uint32_t m_per_core = m / core_num;
    uint32_t m_remain = m % core_num;
    uint32_t m_start = core_id * m_per_core + (core_id < m_remain ? core_id : m_remain);
    uint32_t m_cnt = m_per_core + (core_id < m_remain ? 1 : 0);

    // NRAM缓冲区
    __nram__ float bufA[BLOCK_M * BLOCK_K];
    __nram__ float bufB[BLOCK_K * BLOCK_N];
    __nram__ float bufC[BLOCK_M * BLOCK_N];

    // 遍历当前core负责的M分块
    for (uint32_t mi = 0; mi < m_cnt; mi += BLOCK_M) {
        uint32_t m_blk = (mi + BLOCK_M) <= m_cnt ? BLOCK_M : (m_cnt - mi);
        uint32_t a_row_base = (m_start + mi) * k;

        // 遍历K维度分块
        for (uint32_t ki = 0; ki < k; ki += BLOCK_K) {
            uint32_t k_blk = (ki + BLOCK_K) <= k ? BLOCK_K : (k - ki);

            // 加载A块 GDRAM->NRAM
            __memcpy(bufA, A_gd + a_row_base + ki, m_blk * k_blk * sizeof(float), GDRAM2NRAM);

            // 遍历N维度分块
            for (uint32_t ni = 0; ni < n; ni += BLOCK_N) {
                uint32_t n_blk = (ni + BLOCK_N) <= n ? BLOCK_N : (n - ni);

                // 加载B块 GDRAM->NRAM
                __memcpy(bufB, B_gd + ki * n + ni, k_blk * n_blk * sizeof(float), GDRAM2NRAM);

                // 初始化输出块为0
                __bang_mul_scalar(bufC, bufC, 0.0f, m_blk * n_blk);

                // Bang内置Gemm fp32计算: C = A * B
                __bang_gemm(
                    bufC, bufA, bufB,
                    m_blk, k_blk, n_blk,
                    false, false,
                    1.0f, 1.0f
                );

                // 首K块直接写回，后续K块累加
                if (ki == 0) {
                    __memcpy(C_gd + (m_start + mi) * n + ni, bufC, m_blk * n_blk * sizeof(float), NRAM2GDRAM);
                } else {
                    // 读取原有C值累加
                    __memcpy(bufC, C_gd + (m_start + mi) * n + ni, m_blk * n_blk * sizeof(float), GDRAM2NRAM);
                    __bang_add(bufC, bufC, bufC, m_blk * n_blk);
                    __memcpy(C_gd + (m_start + mi) * n + ni, bufC, m_blk * n_blk * sizeof(float), NRAM2GDRAM);
                }
            }
        }
    }
}

// 对外固定函数名 bang_func，输入A[B,m,k], B[B,k,n]，输出[B,m,n]
torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
    // 校验张量连续性
    TORCH_CHECK(A.is_contiguous(), "Tensor A must be contiguous");
    TORCH_CHECK(B.is_contiguous(), "Tensor B must be contiguous");
    TORCH_CHECK(A.dim() == 3 && B.dim() == 3, "Inputs must be 3D batch tensors");

    // 原始数据类型，内部统一转fp32计算
    auto dtype_A = A.scalar_type();
    auto dtype_B = B.scalar_type();

    torch::Tensor A_fp32 = (dtype_A == torch::kFloat) ? A : A.to(torch::kFloat);
    torch::Tensor B_fp32 = (dtype_B == torch::kFloat) ? B : B.to(torch::kFloat);

    // 获取形状参数
    int batch_size = A_fp32.size(0);
    int m = A_fp32.size(1);
    int k = A_fp32.size(2);
    int n = B_fp32.size(2);

    TORCH_CHECK(B_fp32.size(0) == batch_size, "Batch size mismatch between A and B");
    TORCH_CHECK(B_fp32.size(1) == k, "K dimension mismatch A(,m,k) vs B(,k,n)");

    // 分配fp32输出
    auto C_fp32 = torch::empty({batch_size, m, n}, A_fp32.options());

    // 每个batch的内存步长
    int strideA = m * k;
    int strideB = k * n;
    int strideC = m * n;

    // 获取当前MLU流，禁止新建队列
    cnrtQueue_t stream = torch_mlu::getCurMLUStream();
    cnrtDim3_t grid_dim = {8, 1, 1};
    cnrtFunctionType_t func_type = cnrtFuncTypeUnion1;

    // 逐batch调度核函数
    for (int b = 0; b < batch_size; b++) {
        const float* ptrA = A_fp32.data_ptr<float>() + b * strideA;
        const float* ptrB = B_fp32.data_ptr<float>() + b * strideB;
        float* ptrC = C_fp32.data_ptr<float>() + b * strideC;

        bmm_kernel<<<grid_dim, func_type, stream>>>(
            ptrA, ptrB, ptrC,
            m, k, n,
            strideA, strideB, strideC
        );
    }

    // 还原输入原始精度返回
    if (dtype_A != torch::kFloat) {
        return C_fp32.to(dtype_A);
    }
    return C_fp32;
}

// PyBind绑定
PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
    m.def("bang_func", &bang_func, "Batched matrix multiplication BangC kernel");
}