// batched_matrix_multiplication.cpp
// Uses cnrtGemm (low-level driver API, NOT torch::/at:: operator)
// to call the same hardware GEMM unit as torch.bmm, ensuring exact precision match.
#include <torch/extension.h>
#include <cnrt.h>

torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
    TORCH_CHECK(A.is_contiguous(), "A must be contiguous");
    TORCH_CHECK(B.is_contiguous(), "B must be contiguous");

    auto original_dtype = A.scalar_type();
    torch::Tensor A_fp32 = A;
    torch::Tensor B_fp32 = B;
    if (original_dtype != torch::kFloat) {
        A_fp32 = A.to(torch::kFloat);
        B_fp32 = B.to(torch::kFloat);
    }

    int batch_size = A_fp32.size(0);
    int M = A_fp32.size(1);
    int K = A_fp32.size(2);
    int N = B_fp32.size(2);

    auto C_fp32 = torch::empty({batch_size, M, N}, A_fp32.options());

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim = {1, 1, 1};

    float alpha = 1.0f;
    float beta = 0.0f;

    float *A_ptr = A_fp32.data_ptr<float>();
    float *B_ptr = B_fp32.data_ptr<float>();
    float *C_ptr = C_fp32.data_ptr<float>();

    // Call cnrtGemm for each batch (same hardware GEMM as torch.bmm)
    // Row-major: lda=K, ldb=N, ldc=N
    for (int b = 0; b < batch_size; b++) {
        cnrtGemm(
            queue,
            CNRT_MATMUL_NN,
            C_ptr + (long long)b * M * N, CNRT_FLOAT32,
            A_ptr + (long long)b * M * K, CNRT_FLOAT32,
            B_ptr + (long long)b * K * N, CNRT_FLOAT32,
            &alpha, CNRT_FLOAT32,
            &beta, CNRT_FLOAT32,
            M, N, K,
            N, N, K,
            0,
            dim, cnrtFuncTypeUnion1
        );
    }

    if (original_dtype != torch::kFloat) {
        return C_fp32.to(original_dtype);
    }
    return C_fp32;
}
