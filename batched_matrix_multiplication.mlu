#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

#define CHUNK_SIZE 512
#define TILE_SIZE 32

__mlu_entry__ void batch_matmul_kernel(
    float *A,
    float *B,
    float *C,
    int batch_size,
    int m,
    int k,
    int n) {

    // 多核拆分 - 按batch维度拆分
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;
    
    // 计算每个核心处理的batch范围
    uint32_t batches_per_core = batch_size / core_num;
    uint32_t remainder = batch_size % core_num;
    
    uint32_t batch_start = core_id * batches_per_core + 
                          (core_id < remainder ? core_id : remainder);
    uint32_t batch_count = batches_per_core + 
                          (core_id < remainder ? 1 : 0);

    // NRAM分配
    __nram__ float nram_A[TILE_SIZE * TILE_SIZE];
    __nram__ float nram_B[TILE_SIZE * TILE_SIZE];
    __nram__ float nram_C[TILE_SIZE * TILE_SIZE];
    __nram__ float nram_temp[TILE_SIZE * TILE_SIZE];

    // 计算单个矩阵的大小
    int matrix_size_A = m * k;
    int matrix_size_B = k * n;
    int matrix_size_C = m * n;

    // 处理当前核心分配的每个batch
    for (int batch_idx = 0; batch_idx < batch_count; batch_idx++) {
        int current_batch = batch_start + batch_idx;
        
        // 指向当前batch的矩阵
        float *batch_A = A + current_batch * matrix_size_A;
        float *batch_B = B + current_batch * matrix_size_B;
        float *batch_C = C + current_batch * matrix_size_C;

        // 分块矩阵乘法
        for (int i = 0; i < m; i += TILE_SIZE) {
            for (int j = 0; j < n; j += TILE_SIZE) {
                
                // 初始化累加器
                int tile_m = ((i + TILE_SIZE) <= m) ? TILE_SIZE : (m - i);
                int tile_n = ((j + TILE_SIZE) <= n) ? TILE_SIZE : (n - j);
                
                int c_size = tile_m * tile_n;
                for (int idx = 0; idx < c_size; idx++) {
                    nram_C[idx] = 0.0f;
                }

                for (int p = 0; p < k; p += TILE_SIZE) {
                    int tile_k = ((p + TILE_SIZE) <= k) ? TILE_SIZE : (k - p);
                    
                    // 加载A的分块到NRAM
                    for (int r = 0; r < tile_m; r++) {
                        __memcpy(
                            nram_A + r * tile_k,
                            batch_A + (i + r) * k + p,
                            tile_k * sizeof(float),
                            GDRAM2NRAM
                        );
                    }
                    
                    // 加载B的分块到NRAM
                    for (int r = 0; r < tile_k; r++) {
                        __memcpy(
                            nram_B + r * tile_n,
                            batch_B + (p + r) * n + j,
                            tile_n * sizeof(float),
                            GDRAM2NRAM
                        );
                    }
                    
                    // 执行分块矩阵乘法
                    for (int r = 0; r < tile_m; r++) {
                        for (int c = 0; c < tile_n; c++) {
                            float sum = 0.0f;
                            for (int s = 0; s < tile_k; s++) {
                                sum += nram_A[r * tile_k + s] * nram_B[s * tile_n + c];
                            }
                            nram_C[r * tile_n + c] += sum;
                        }
                    }
                }
                
                // 写回结果到GDRAM
                for (int r = 0; r < tile_m; r++) {
                    __memcpy(
                        batch_C + (i + r) * n + j,
                        nram_C + r * tile_n,
                        tile_n * sizeof(float),
                        NRAM2GDRAM
                    );
                }
            }
        }
    }
}

torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
    TORCH_CHECK(A.is_contiguous(), "A must be contiguous");
    TORCH_CHECK(B.is_contiguous(), "B must be contiguous");
    
    // 获取维度信息
    auto shape_A = A.sizes();
    auto shape_B = B.sizes();
    
    TORCH_CHECK(shape_A.size() == 3, "A must be 3D tensor");
    TORCH_CHECK(shape_B.size() == 3, "B must be 3D tensor");
    
    int batch_size = shape_A[0];
    int m = shape_A[1];
    int k = shape_A[2];
    int n = shape_B[2];
    
    TORCH_CHECK(shape_B[0] == batch_size, "Batch sizes must match");
    TORCH_CHECK(shape_B[1] == k, "Inner dimensions must match");
    
    // 保留原始数据类型
    auto original_dtype = A.scalar_type();
    
    // 转换为fp32进行计算
    torch::Tensor A_fp32 = A;
    torch::Tensor B_fp32 = B;
    
    if (original_dtype != torch::kFloat) {
        A_fp32 = A.to(torch::kFloat);
        B_fp32 = B.to(torch::kFloat);
    }
    
    // 创建输出张量 - 使用new_empty避免使用torch::empty
    auto C_fp32 = A_fp32.new_empty({batch_size, m, n});
    
    // 获取MLU stream
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    
    // 设置并行参数
    cnrtDim3_t dim = {4, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;
    
    // 启动kernel
    batch_matmul_kernel<<<dim, ktype, queue>>>(
        A_fp32.data_ptr<float>(),
        B_fp32.data_ptr<float>(),
        C_fp32.data_ptr<float>(),
        batch_size,
        m,
        k,
        n
    );
    
    // 转换回原始数据类型
    if (original_dtype != torch::kFloat) {
        return C_fp32.to(original_dtype);
    }
    
    return C_fp32;
}