#include <bang.h>
#include <cnrt.h>
#include <torch/extension.h>

#define M_BLOCK 64
#define N_BLOCK 64
#define K_BLOCK 64

__mlu_entry__ void bmm_kernel(float *A, float *B, float *C, int m, int k, int n) {
    int batch = taskId;
    float *A_batch = A + batch * m * k;
    float *B_batch = B + batch * k * n;
    float *C_batch = C + batch * m * n;

    __nram__ float nram_A[M_BLOCK * K_BLOCK];
    __nram__ float nram_B[K_BLOCK * N_BLOCK];
    __nram__ float nram_tmp[M_BLOCK * N_BLOCK];
    __nram__ float nram_acc[M_BLOCK * N_BLOCK];

    for (int i = 0; i < m; i += M_BLOCK) {
        int M_cur = (i + M_BLOCK <= m) ? M_BLOCK : (m - i);
        for (int j = 0; j < n; j += N_BLOCK) {
            int N_cur = (j + N_BLOCK <= n) ? N_BLOCK : (n - j);

            __bang_write_zero(nram_acc, M_BLOCK * N_BLOCK);

            for (int p = 0; p < k; p += K_BLOCK) {
                int K_cur = (p + K_BLOCK <= k) ? K_BLOCK : (k - p);

                // Load A block (M_cur x K_cur) into nram_A
                __bang_write_zero(nram_A, M_BLOCK * K_BLOCK);
                __memcpy_2d(nram_A, K_BLOCK * sizeof(float),
                            A_batch + i * k + p, k * sizeof(float),
                            K_cur * sizeof(float), M_cur, GDRAM2NRAM);

                // Load B block (K_cur x N_cur) into nram_B
                __bang_write_zero(nram_B, K_BLOCK * N_BLOCK);
                __memcpy_2d(nram_B, N_BLOCK * sizeof(float),
                            B_batch + p * n + j, n * sizeof(float),
                            N_cur * sizeof(float), K_cur, GDRAM2NRAM);

                // C_tmp = A_block * B_block
                __bang_matmul(nram_tmp, nram_A, nram_B,
                              M_BLOCK, K_BLOCK, N_BLOCK,
                              0, 0, 0);

                // acc += tmp
                __bang_add(nram_acc, nram_acc, nram_tmp,
                           M_BLOCK * N_BLOCK);
            }

            // Write back valid part of acc (M_cur x N_cur)
            __memcpy_2d(C_batch + i * n + j, n * sizeof(float),
                        nram_acc, N_BLOCK * sizeof(float),
                        N_cur * sizeof(float), M_cur, NRAM2GDRAM);
        }
    }
}

torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
    TORCH_CHECK(A.is_contiguous(), "A must be contiguous");
    TORCH_CHECK(B.is_contiguous(), "B must be contiguous");
    TORCH_CHECK(A.dim() == 3, "A must be 3D");
    TORCH_CHECK(B.dim() == 3, "B must be 3D");
    TORCH_CHECK(A.size(0) == B.size(0), "Batch size mismatch");
    TORCH_CHECK(A.size(2) == B.size(1), "k dimension mismatch");

    auto original_dtype = A.scalar_type();
    torch::Tensor A_fp32 = A;
    torch::Tensor B_fp32 = B;
    if (original_dtype != torch::kFloat) {
        A_fp32 = A.to(torch::kFloat);
        B_fp32 = B.to(torch::kFloat);
    }

    int batch_size = A_fp32.size(0);
    int m = A_fp32.size(1);
    int k = A_fp32.size(2);
    int n = B_fp32.size(2);

    auto C_fp32 = torch::empty({batch_size, m, n}, torch::kFloat);

    if (batch_size == 0) {
        return C_fp32;
    }

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim = {static_cast<uint32_t>(batch_size), 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    bmm_kernel<<<dim, ktype, queue>>>(
        A_fp32.data_ptr<float>(),
        B_fp32.data_ptr<float>(),
        C_fp32.data_ptr<float>(),
        m, k, n
    );

    if (original_dtype != torch::kFloat) {
        return C_fp32.to(original_dtype);
    }
    return C_fp32;
}