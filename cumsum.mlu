#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <vector>

#define NRAM_SIZE 8192
#define VECTOR_SIZE 64  // MLU370 向量化宽度

// 优化的核函数：使用向量化加载和双缓冲
__mlu_entry__ void cumsum_kernel_optimized(
    float *input,
    float *output,
    int outer_size,
    int dim_size,
    int inner_size) {
    
    __nram__ float nram_a[NRAM_SIZE];
    __nram__ float nram_b[NRAM_SIZE];
    
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;
    
    int total_sequences = outer_size * inner_size;
    int seq_per_core = (total_sequences + core_num - 1) / core_num;
    int start_seq = core_id * seq_per_core;
    int end_seq = min(start_seq + seq_per_core, total_sequences);
    
    for (int seq_id = start_seq; seq_id < end_seq; seq_id++) {
        int outer_idx = seq_id / inner_size;
        int inner_idx = seq_id % inner_size;
        
        int base_offset = outer_idx * dim_size * inner_size + inner_idx;
        
        float running_sum = 0.0f;
        int processed = 0;
        
        // 处理对齐的部分（使用向量化）
        int aligned_dim = (dim_size / VECTOR_SIZE) * VECTOR_SIZE;
        
        // 处理向量化部分
        for (int i = 0; i < aligned_dim; i += VECTOR_SIZE) {
            // 加载 VECTOR_SIZE 个元素
            __memcpy(
                nram_a,
                input + base_offset + i * inner_size,
                VECTOR_SIZE * sizeof(float),
                GDRAM2NRAM
            );
            
            // 串行计算前缀和（保持简单稳定）
            for (int j = 0; j < VECTOR_SIZE; j++) {
                running_sum += nram_a[j];
                nram_a[j] = running_sum;
            }
            
            __memcpy(
                output + base_offset + i * inner_size,
                nram_a,
                VECTOR_SIZE * sizeof(float),
                NRAM2GDRAM
            );
        }
        
        // 处理剩余元素
        int remaining = dim_size - aligned_dim;
        if (remaining > 0) {
            __memcpy(
                nram_a,
                input + base_offset + aligned_dim * inner_size,
                remaining * sizeof(float),
                GDRAM2NRAM
            );
            
            for (int j = 0; j < remaining; j++) {
                running_sum += nram_a[j];
                nram_a[j] = running_sum;
            }
            
            __memcpy(
                output + base_offset + aligned_dim * inner_size,
                nram_a,
                remaining * sizeof(float),
                NRAM2GDRAM
            );
        }
    }
}

torch::Tensor bang_func(torch::Tensor x, int dim) {
    TORCH_CHECK(x.is_contiguous(), "Input must be contiguous");
    
    int ndim = x.dim();
    if (dim < 0) dim += ndim;
    TORCH_CHECK(dim >= 0 && dim < ndim, "Dimension out of range");
    
    auto original_dtype = x.scalar_type();
    torch::Tensor input_fp32 = (original_dtype == torch::kFloat) ? 
                                x : x.to(torch::kFloat);
    
    auto sizes = input_fp32.sizes();
    std::vector<int64_t> shape(sizes.begin(), sizes.end());
    
    int64_t outer_size = 1;
    for (int i = 0; i < dim; i++) outer_size *= shape[i];
    
    int64_t dim_size = shape[dim];
    
    int64_t inner_size = 1;
    for (int i = dim + 1; i < ndim; i++) inner_size *= shape[i];
    
    auto output_fp32 = torch::empty_like(input_fp32);
    
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    
    // 根据问题规模动态调整
    int total_sequences = outer_size * inner_size;
    int cores = 16;
    if (total_sequences < 32) cores = 4;
    else if (total_sequences < 128) cores = 8;
    
    cnrtDim3_t dim_grid = {cores, 1, 1};
    cnrtFunctionType_t kernel_type = cnrtFuncTypeUnion1;
    
    cumsum_kernel_optimized<<<dim_grid, kernel_type, queue>>>(
        input_fp32.data_ptr<float>(),
        output_fp32.data_ptr<float>(),
        outer_size,
        dim_size,
        inner_size
    );
    
    cnrtQueueSync(queue);
    
    if (original_dtype != torch::kFloat) {
        return output_fp32.to(original_dtype);
    }
    return output_fp32;
}