#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <vector>

__mlu_entry__ void cumsum_kernel(float* input, float* output,
                                 const int64_t* offsets,
                                 int dim_size, int64_t stride_dim,
                                 int num_seqs) {
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;
    int seqs_per_core = (num_seqs + core_num - 1) / core_num;
    int start_seq = core_id * seqs_per_core;
    int end_seq = start_seq + seqs_per_core;
    if (end_seq > num_seqs) end_seq = num_seqs;

    for (int s = start_seq; s < end_seq; ++s) {
        int64_t base = offsets[s];
        float prefix = 0.0f;
        for (int i = 0; i < dim_size; ++i) {
            int64_t idx = base + i * stride_dim;
            prefix += input[idx];
            output[idx] = prefix;
        }
    }
}

torch::Tensor bang_func(torch::Tensor x, int dim) {
    int ndim = x.dim();
    if (dim < 0) dim += ndim;
    TORCH_CHECK(dim >= 0 && dim < ndim, "Invalid dim");
    x = x.contiguous();
    auto original_dtype = x.scalar_type();
    torch::Tensor input_fp32 = (original_dtype == torch::kFloat) ? x : x.to(torch::kFloat);
    torch::Tensor output_fp32 = torch::empty_like(input_fp32);

    int64_t dim_size = input_fp32.size(dim);
    int64_t stride_dim = input_fp32.stride(dim);
    int64_t total_elements = input_fp32.numel();
    int64_t num_seqs = total_elements / dim_size;

    // 计算偏移量：枚举其他维度
    std::vector<int64_t> other_dims, other_strides;
    for (int d = 0; d < ndim; ++d) {
        if (d != dim) {
            other_dims.push_back(input_fp32.size(d));
            other_strides.push_back(input_fp32.stride(d));
        }
    }
    int other_rank = other_dims.size();
    std::vector<int64_t> host_offsets(num_seqs);
    if (other_rank == 0) {
        host_offsets[0] = 0;
    } else {
        std::vector<int64_t> idx(other_rank, 0);
        for (int64_t s = 0; s < num_seqs; ++s) {
            int64_t offset = 0;
            for (int i = 0; i < other_rank; ++i)
                offset += idx[i] * other_strides[i];
            host_offsets[s] = offset;
            // 进位
            for (int i = other_rank - 1; i >= 0; --i) {
                if (++idx[i] < other_dims[i]) break;
                idx[i] = 0;
            }
        }
    }

    int64_t* dev_offsets = nullptr;
    size_t offsets_bytes = num_seqs * sizeof(int64_t);
    cnrtMalloc((void**)&dev_offsets, offsets_bytes);
    cnrtMemcpy(dev_offsets, host_offsets.data(), offsets_bytes, CNRT_MEM_TRANS_DIR_HOST2DEV);

    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim3 = {1024, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;
    cumsum_kernel<<<dim3, ktype, queue>>>(
        input_fp32.data_ptr<float>(),
        output_fp32.data_ptr<float>(),
        dev_offsets,
        static_cast<int>(dim_size),
        stride_dim,
        static_cast<int>(num_seqs)
    );
    cnrtQueueSync(queue);
    cnrtFree(dev_offsets);

    if (original_dtype != torch::kFloat)
        return output_fp32.to(original_dtype);
    return output_fp32;
}