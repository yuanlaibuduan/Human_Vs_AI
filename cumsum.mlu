// 051_cumsum.cpp
#include <bang.h>
#include <cnrt.h>
#include <torch/extension.h>

#define BLOCK_SIZE 1024  // 必须为 64 的倍数，且不超过 NRAM 容量（128KB / 4B = 32768）

/**
 * BangC 核函数：沿指定维度计算累加前缀和（FP32）
 * 
 * @param input        输入张量指针（FP32，连续内存）
 * @param output       输出张量指针（FP32，连续内存）
 * @param size_dim     扫描维度的大小
 * @param inner_stride 扫描维度上相邻元素的步长（以元素个数计）
 * @param outer_size   扫描维度之前各维度元素数的乘积（即外循环次数）
 */
__mlu_entry__ void cumsum_kernel(
    float* input,
    float* output,
    int size_dim,
    int inner_stride,
    int outer_size) {
    
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;

    // 总序列数 = outer_size * inner_stride
    int total_sequences = outer_size * inner_stride;
    
    // 将序列均匀分配给各核
    uint32_t per_core = total_sequences / core_num;
    uint32_t rem = total_sequences % core_num;
    uint32_t seq_start = core_id * per_core + (core_id < rem ? core_id : rem);
    uint32_t seq_count = per_core + (core_id < rem ? 1 : 0);

    // 固定大小的 NRAM 缓冲区
    __nram__ float nram_data[BLOCK_SIZE];
    __nram__ float nram_scan[BLOCK_SIZE];

    for (uint32_t s = 0; s < seq_count; ++s) {
        uint32_t seq_idx = seq_start + s;
        // 分解 seq_idx 为 outer 和 inner 索引
        int outer = seq_idx / inner_stride;
        int inner = seq_idx % inner_stride;
        
        // 计算当前序列的起始偏移（元素索引）
        int base_offset = outer * size_dim * inner_stride + inner;
        
        float global_acc = 0.0f;
        int offset = 0;
        int remaining = size_dim;
        
        while (remaining > 0) {
            int len = (remaining < BLOCK_SIZE) ? remaining : BLOCK_SIZE;
            int aligned_len = (len + 63) & ~63;  // 对齐到 64 的倍数
            
            // 从全局内存 gather 数据到 NRAM（步长加载）
            __memcpy_stride(
                nram_data,                           // dst (连续)
                input + base_offset + offset * inner_stride,  // src
                sizeof(float),                      // dst_stride (连续)
                inner_stride * sizeof(float),       // src_stride
                len,                                // 元素个数
                GDRAM2NRAM
            );
            
            if (len == aligned_len) {
                // 满块：使用向量扫描指令
                __bang_scan_add(nram_scan, nram_data, aligned_len, 1);
            } else {
                // 最后一个不足对齐的块：使用标量循环
                float acc = 0.0f;
                for (int i = 0; i < len; ++i) {
                    acc += nram_data[i];
                    nram_scan[i] = acc;
                }
                // 剩余元素（对齐填充部分）无需处理
            }
            
            // 加上全局累加值（向量化加标量）
            __bang_add_scalar(nram_scan, nram_scan, global_acc, aligned_len);
            
            // 将结果 scatter 回全局内存
            __memcpy_stride(
                output + base_offset + offset * inner_stride,
                nram_scan,
                inner_stride * sizeof(float),
                sizeof(float),
                len,
                NRAM2GDRAM
            );
            
            // 更新全局累加值（取当前块最后一个元素）
            global_acc = nram_scan[len - 1];
            
            // 推进到下一个块
            remaining -= len;
            offset += len;
        }
    }
}

/**
 * 外部调用接口：对输入张量沿指定维度计算累加前缀和
 * 
 * @param x    输入张量（支持任意类型，内部转为 FP32 计算）
 * @param dim  需要扫描的维度（支持负数索引）
 * @return     与 x 形状相同的输出张量
 */
torch::Tensor bang_func(torch::Tensor x, int dim) {
    // 确保输入在 MLU 上且连续
    x = x.contiguous();
    auto original_dtype = x.scalar_type();
    
    // 转换为 FP32 计算（保持精度）
    torch::Tensor input_fp32 = (original_dtype == torch::kFloat) ? x : x.to(torch::kFloat);
    
    auto sizes = input_fp32.sizes();
    int64_t ndim = sizes.size();
    
    // 处理负数维度
    if (dim < 0) dim += ndim;
    TORCH_CHECK(dim >= 0 && dim < ndim, "Invalid dim");
    
    // 计算 outer_size（dim 之前所有维度的乘积）
    int64_t outer_size = 1;
    for (int i = 0; i < dim; ++i) outer_size *= sizes[i];
    
    // 计算 inner_stride（dim 之后所有维度的乘积）
    int64_t inner_stride = 1;
    for (size_t i = dim + 1; i < sizes.size(); ++i) inner_stride *= sizes[i];
    
    int64_t size_dim = sizes[dim];
    
    // 分配输出张量（与输入形状相同）
    auto output_fp32 = torch::empty_like(input_fp32);
    
    // 获取当前 MLU 流（队列）
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    
    // 启动核函数（使用 128 个核，可根据硬件调整）
    uint32_t core_num = 128;
    cnrtDim3_t dim_grid = {core_num, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;
    
    cumsum_kernel<<<dim_grid, ktype, queue>>>(
        input_fp32.data_ptr<float>(),
        output_fp32.data_ptr<float>(),
        static_cast<int>(size_dim),
        static_cast<int>(inner_stride),
        static_cast<int>(outer_size)
    );
    
    // 将结果转换回原始数据类型
    if (original_dtype != torch::kFloat) {
        return output_fp32.to(original_dtype);
    }
    return output_fp32;
}