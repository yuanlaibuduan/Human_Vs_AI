#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <vector>

#define BLOCK_SIZE 4096   // NRAM 块大小（元素个数）

// 核函数：使用 NRAM 缓存，对每个序列执行前缀和
// input, output: 设备端指针
// offsets: 每个序列首元素的线性索引（int）
// dim_size: 序列长度
// stride_dim: 沿 dim 维度的步长（元素个数）
// num_seqs: 序列总数
__mlu_entry__ void cumsum_kernel(float* input,
                                 float* output,
                                 const int* offsets,
                                 int dim_size,
                                 int stride_dim,
                                 int num_seqs) {
    __nram__ float nram_in[BLOCK_SIZE];
    __nram__ float nram_out[BLOCK_SIZE];

    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;
    int seqs_per_core = (num_seqs + core_num - 1) / core_num;
    int start_seq = core_id * seqs_per_core;
    int end_seq = start_seq + seqs_per_core;
    if (end_seq > num_seqs) end_seq = num_seqs;

    for (int seq = start_seq; seq < end_seq; ++seq) {
        int base = offsets[seq];
        float prefix = 0.0f;

        // 按块处理序列
        for (int block_start = 0; block_start < dim_size; block_start += BLOCK_SIZE) {
            int len = dim_size - block_start;
            if (len > BLOCK_SIZE) len = BLOCK_SIZE;

            // 从 GDRAM 加载数据到 NRAM
            int64_t src_addr = base + block_start * stride_dim;
            __memcpy(nram_in, input + src_addr, len * sizeof(float), GDRAM2NRAM);

            // 在 NRAM 内执行前缀和（标量循环，但访存已优化）
            float running = prefix;
            for (int i = 0; i < len; ++i) {
                running += nram_in[i];
                nram_out[i] = running;
            }
            prefix = running;  // 保存块末尾的累加值，用于下一个块

            // 写回结果到 GDRAM
            __memcpy(output + src_addr, nram_out, len * sizeof(float), NRAM2GDRAM);
        }
    }
}

// 主机端函数：计算每个序列的起始线性索引
static std::vector<int> compute_offsets(const torch::Tensor& t, int dim) {
    int ndim = t.dim();
    std::vector<int64_t> shape = t.sizes();
    std::vector<int64_t> strides = t.strides();

    // 收集除 dim 以外的维度索引
    std::vector<int> other_dims;
    for (int d = 0; d < ndim; ++d) {
        if (d != dim) other_dims.push_back(d);
    }
    int other_rank = other_dims.size();

    // 如果 only dim, 则只有一个序列
    if (other_rank == 0) {
        return std::vector<int>(1, 0);
    }

    // 计算每个 other 维度的长度和步长
    std::vector<int64_t> other_shape(other_rank);
    std::vector<int64_t> other_stride(other_rank);
    for (int i = 0; i < other_rank; ++i) {
        other_shape[i] = shape[other_dims[i]];
        other_stride[i] = strides[other_dims[i]];
    }

    // 计算总的序列数量
    int64_t num_seqs = 1;
    for (auto s : other_shape) num_seqs *= s;

    // 构建每个序列的线性偏移
    std::vector<int> offsets(num_seqs);
    std::vector<int64_t> indices(other_rank, 0);

    for (int64_t seq = 0; seq < num_seqs; ++seq) {
        int64_t offset = 0;
        for (int i = 0; i < other_rank; ++i) {
            offset += indices[i] * other_stride[i];
        }
        offsets[seq] = static_cast<int>(offset);  // 线性索引，假设小于 2^31

        // 更新 indices (多进制加法)
        for (int i = other_rank - 1; i >= 0; --i) {
            if (++indices[i] < other_shape[i]) break;
            indices[i] = 0;
        }
    }
    return offsets;
}

// PyTorch 入口函数
torch::Tensor bang_func(torch::Tensor x, int dim) {
    int ndim = x.dim();
    if (dim < 0) dim += ndim;
    TORCH_CHECK(dim >= 0 && dim < ndim, "Invalid dim");

    x = x.contiguous();
    torch::Tensor input_fp32 = x;
    auto original_dtype = x.scalar_type();
    if (original_dtype != torch::kFloat) {
        input_fp32 = x.to(torch::kFloat);
    }

    auto output_fp32 = torch::empty_like(input_fp32);

    // 获取基本信息
    int64_t dim_size = input_fp32.size(dim);
    int64_t stride_dim = input_fp32.stride(dim);
    int64_t total_elements = input_fp32.numel();
    int64_t num_seqs = total_elements / dim_size;

    // 计算每个序列的起始偏移量（32位整数）
    std::vector<int> host_offsets = compute_offsets(input_fp32, dim);
    TORCH_CHECK(host_offsets.size() == static_cast<size_t>(num_seqs), "Offset count mismatch");

    // 拷贝偏移量到设备
    int* dev_offsets = nullptr;
    size_t offsets_bytes = num_seqs * sizeof(int);
    cnrtMalloc((void**)&dev_offsets, offsets_bytes);
    cnrtMemcpy(dev_offsets, host_offsets.data(), offsets_bytes, CNRT_MEM_TRANS_DIR_HOST2DEV);

    // 获取 MLU 队列
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    // 启动核函数：使用 1024 个核，Union1 类型
    cnrtDim3_t dim3 = {1024, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    cumsum_kernel<<<dim3, ktype, queue>>>(
        input_fp32.data_ptr<float>(),
        output_fp32.data_ptr<float>(),
        dev_offsets,
        static_cast<int>(dim_size),
        static_cast<int>(stride_dim),
        static_cast<int>(num_seqs)
    );

    cnrtFree(dev_offsets);

    if (original_dtype != torch::kFloat) {
        return output_fp32.to(original_dtype);
    }
    return output_fp32;
}