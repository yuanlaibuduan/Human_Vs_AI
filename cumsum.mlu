#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <vector>

#define BLOCK_SIZE 4096

// 核函数：处理2D张量的每一行，沿列方向计算前缀和
// input: [batch, dim_size] 连续的行主序
// output: [batch, dim_size]
// dim_size: 列数
__mlu_entry__ void cumsum_2d_kernel(float* input, float* output,
                                    int batch, int dim_size) {
    __nram__ float nram_buf[BLOCK_SIZE];
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;
    int rows_per_core = (batch + core_num - 1) / core_num;
    int start_row = core_id * rows_per_core;
    int end_row = start_row + rows_per_core;
    if (end_row > batch) end_row = batch;

    for (int r = start_row; r < end_row; ++r) {
        float* row_in = input + r * dim_size;
        float* row_out = output + r * dim_size;
        float prefix = 0.0f;
        for (int blk = 0; blk < dim_size; blk += BLOCK_SIZE) {
            int len = dim_size - blk;
            if (len > BLOCK_SIZE) len = BLOCK_SIZE;
            // 拷贝到 NRAM
            __memcpy(nram_buf, row_in + blk, len * sizeof(float), GDRAM2NRAM);
            // 前缀和累加（标量循环）
            for (int i = 0; i < len; ++i) {
                prefix += nram_buf[i];
                nram_buf[i] = prefix;
            }
            // 写回
            __memcpy(row_out + blk, nram_buf, len * sizeof(float), NRAM2GDRAM);
        }
    }
}

torch::Tensor bang_func(torch::Tensor x, int dim) {
    int ndim = x.dim();
    if (dim < 0) dim += ndim;
    TORCH_CHECK(dim >= 0 && dim < ndim, "Invalid dim");

    x = x.contiguous();
    auto original_dtype = x.scalar_type();
    torch::Tensor input_fp32 = (original_dtype == torch::kFloat) ? x : x.to(torch::kFloat);

    // 将输入重排为2D: [batch, dim_size]
    // 首先将除dim以外的所有维度合并为 batch 维度
    std::vector<int64_t> shape = input_fp32.sizes().vec();
    int64_t dim_size = shape[dim];
    int64_t batch = 1;
    for (int d = 0; d < ndim; ++d) {
        if (d != dim) batch *= shape[d];
    }

    // 重排内存布局：将dim维移到最后一维，其他维合并到第一维
    // 使用 permute + flatten 的方式
    std::vector<int64_t> perm(ndim);
    for (int d = 0, idx = 0; d < ndim; ++d) {
        if (d == dim) continue;
        perm[idx++] = d;
    }
    perm.push_back(dim);
    auto input_perm = input_fp32.permute(perm);
    auto input_2d = input_perm.reshape({batch, dim_size});

    auto output_2d = torch::empty_like(input_2d);

    // 获取 MLU 队列
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim3 = {256, 1, 1};   // 256个核
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    cumsum_2d_kernel<<<dim3, ktype, queue>>>(
        input_2d.data_ptr<float>(),
        output_2d.data_ptr<float>(),
        static_cast<int>(batch),
        static_cast<int>(dim_size)
    );

    cnrtQueueSync(queue);

    // 将输出重排回原始形状
    auto output_perm = output_2d.reshape(input_perm.sizes());
    std::vector<int64_t> inv_perm(ndim);
    for (int d = 0; d < ndim; ++d) inv_perm[perm[d]] = d;
    auto output = output_perm.permute(inv_perm);

    if (original_dtype != torch::kFloat) {
        return output.to(original_dtype);
    }
    return output;
}