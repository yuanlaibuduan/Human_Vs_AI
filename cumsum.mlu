#include <bang.h>
#include <cnrt.h>
#include <torch/extension.h>

#define MAX_DIM 8

// 核函数：沿指定维度计算累加前缀和（fp32版本）
// 参数：
//   input   : 输入张量指针（fp32）
//   output  : 输出张量指针（fp32）
//   seq_len : 指定维度的长度（每个序列的元素个数）
//   post_size : 指定维度之后所有维度的元素个数乘积，同时也是相邻元素在内存中的步长
//   num_seqs : 序列总数（= total_elements / seq_len）
//   total_elements : 总元素个数（用于边界检查，可选）
__mlu_entry__ void cumsum_kernel(float *input, float *output, int seq_len,
                                 int post_size, int num_seqs, int total_elements) {
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;

    // 将序列均匀分配给各个 core
    uint32_t per_core = num_seqs / core_num;
    uint32_t remainder = num_seqs % core_num;
    uint32_t start_seq = core_id * per_core + (core_id < remainder ? core_id : remainder);
    uint32_t local_seq_num = per_core + (core_id < remainder ? 1 : 0);

    // 处理分配给当前 core 的每一个序列
    for (uint32_t s = 0; s < local_seq_num; ++s) {
        uint32_t seq_idx = start_seq + s;               // 当前序列的全局编号
        // 计算当前序列第一个元素在内存中的偏移量
        // 公式：offset0 = (seq_idx / post_size) * (seq_len * post_size) + (seq_idx % post_size)
        uint32_t pre_idx = seq_idx / post_size;          // 前缀维度索引
        uint32_t post_idx = seq_idx % post_size;         // 后缀维度索引
        uint32_t base_offset = pre_idx * (seq_len * post_size) + post_idx;

        float running_sum = 0.0f;
        // 遍历序列中的每一个元素
        for (int i = 0; i < seq_len; ++i) {
            uint32_t offset = base_offset + i * post_size;
            // 边界检查（可选，确保不越界）
            if (offset >= (uint32_t)total_elements) break;
            float val = input[offset];
            running_sum += val;
            output[offset] = running_sum;
        }
    }
}

// 对外暴露的接口函数
torch::Tensor bang_func(torch::Tensor x, int dim) {
    // 处理负数维度
    int ndim = x.dim();
    if (dim < 0) dim += ndim;
    TORCH_CHECK(dim >= 0 && dim < ndim, "Invalid dim ", dim, " for tensor with ", ndim, " dimensions");

    // 确保输入是 contiguous 的，或者我们自己处理 stride（简化起见，要求 contiguous）
    TORCH_CHECK(x.is_contiguous(), "Input tensor must be contiguous");

    // 保留原始数据类型
    auto original_dtype = x.scalar_type();

    // 转换为 fp32 进行计算
    torch::Tensor x_fp32 = x;
    if (original_dtype != torch::kFloat) {
        x_fp32 = x.to(torch::kFloat);
    }

    // 分配输出张量
    torch::Tensor out_fp32 = torch::empty_like(x_fp32);

    // 获取张量形状信息
    auto sizes = x_fp32.sizes();
    int64_t seq_len = sizes[dim];                     // 指定维度的长度
    int64_t post_size = 1;                            // 后缀维度的总元素个数
    for (int d = dim + 1; d < ndim; ++d) {
        post_size *= sizes[d];
    }
    int64_t num_seqs = x_fp32.numel() / seq_len;      // 序列总数
    int64_t total = x_fp32.numel();

    // 获取当前 MLU 流对应的队列
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    // 设置核函数启动参数（使用 16 个 core，可根据实际情况调整）
    cnrtDim3_t dim_core = {16, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    // 启动核函数
    cumsum_kernel<<<dim_core, ktype, queue>>>(
        x_fp32.data_ptr<float>(),
        out_fp32.data_ptr<float>(),
        (int)seq_len,
        (int)post_size,
        (int)num_seqs,
        (int)total
    );

    // 将输出转换回原始数据类型
    if (original_dtype != torch::kFloat) {
        return out_fp32.to(original_dtype);
    }
    return out_fp32;
}