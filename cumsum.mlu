#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <vector>
#include <cstdint>

// 核函数：对多个序列进行累加前缀和
// input: 输入张量指针 (float)
// output: 输出张量指针 (float)
// offsets: 每个序列首元素相对于张量起始的偏移量 (元素个数)
// num_seqs: 该核需要处理的序列数量
// dim_size: 每个序列的长度
// stride_dim: 沿 dim 维度的步长 (元素个数)
__mlu_entry__ void cumsum_kernel(float* input,
                                 float* output,
                                 const int64_t* offsets,
                                 int num_seqs,
                                 int dim_size,
                                 int64_t stride_dim) {
    // 获取当前核的 ID 和总核数
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;

    // 计算每个核处理的序列范围
    int seqs_per_core = (num_seqs + core_num - 1) / core_num;
    int start_seq = core_id * seqs_per_core;
    int end_seq = start_seq + seqs_per_core;
    if (end_seq > num_seqs) end_seq = num_seqs;

    // 处理分配给当前核的序列
    for (int seq = start_seq; seq < end_seq; ++seq) {
        int64_t base_offset = offsets[seq];   // 序列首元素偏移
        float prefix = 0.0f;

        // 沿 dim 维度顺序累加
        for (int i = 0; i < dim_size; ++i) {
            int64_t idx = base_offset + i * stride_dim;
            float val = input[idx];
            prefix += val;
            output[idx] = prefix;
        }
    }
}

// 主机端封装函数
torch::Tensor bang_func(torch::Tensor x, int dim) {
    // 维度合法性检查
    int ndim = x.dim();
    if (dim < 0) dim += ndim;
    TORCH_CHECK(dim >= 0 && dim < ndim, "Invalid dim");
    // 要求输入连续
    x = x.contiguous();

    // 转换为 fp32 进行计算
    torch::Tensor input_fp32 = x;
    auto original_dtype = x.scalar_type();
    if (original_dtype != torch::kFloat) {
        input_fp32 = x.to(torch::kFloat);
    }

    // 输出张量
    torch::Tensor output_fp32 = torch::empty_like(input_fp32);

    // 获取张量形状、步长等信息
    auto shape = input_fp32.sizes();          // 各维度长度
    auto strides = input_fp32.strides();     // 各维度步长 (元素个数)
    int64_t dim_size = shape[dim];            // 指定维度的长度
    int64_t stride_dim = strides[dim];        // 指定维度的步长
    int64_t total_elements = input_fp32.numel();
    int64_t num_seqs = total_elements / dim_size;  // 序列总数

    // ---------- 计算每个序列首元素的偏移量 ----------
    std::vector<int64_t> host_offsets(num_seqs);
    // 构建除 dim 以外的维度信息
    std::vector<int64_t> other_dims;
    std::vector<int64_t> other_strides;
    for (int d = 0; d < ndim; ++d) {
        if (d == dim) continue;
        other_dims.push_back(shape[d]);
        other_strides.push_back(strides[d]);
    }
    int other_rank = other_dims.size();

    // 计算 each_other_stride 用于分解线性索引
    std::vector<int64_t> mult(other_rank, 1);
    for (int i = other_rank - 1; i > 0; --i) {
        mult[i-1] = mult[i] * other_dims[i];
    }
    // 遍历每一个序列
    for (int64_t seq = 0; seq < num_seqs; ++seq) {
        int64_t tmp = seq;
        int64_t offset = 0;
        // 将线性索引 seq 分解为各 other 维度的索引
        for (int d = 0; d < other_rank; ++d) {
            int64_t idx = tmp / mult[d];
            tmp %= mult[d];
            offset += idx * other_strides[d];
        }
        host_offsets[seq] = offset;
    }

    // 将偏移量数组拷贝到设备端
    int64_t* dev_offsets = nullptr;
    size_t offsets_bytes = num_seqs * sizeof(int64_t);
    cnrtMalloc(&dev_offsets, offsets_bytes);
    cnrtMemcpy(dev_offsets, host_offsets.data(), offsets_bytes, CNRT_MEMCPY_HOST_TO_DEVICE);

    // 获取 MLU 队列
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    // 设置核函数启动参数 (使用 Union1 类型，taskDim 暂定为 256)
    cnrtDim3_t dim3 = {256, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    cumsum_kernel<<<dim3, ktype, queue>>>(
        input_fp32.data_ptr<float>(),
        output_fp32.data_ptr<float>(),
        dev_offsets,
        num_seqs,
        dim_size,
        stride_dim
    );

    // 释放设备端偏移数组
    cnrtFree(dev_offsets);

    // 将结果转回原始数据类型
    if (original_dtype != torch::kFloat) {
        return output_fp32.to(original_dtype);
    }
    return output_fp32;
}