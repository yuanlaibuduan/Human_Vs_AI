#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <vector>

#define BLOCK_SIZE 4096

__mlu_entry__ void cumsum_kernel(float* input,
                                 float* output,
                                 const int64_t* offsets,
                                 int dim_size,
                                 int64_t stride_dim,
                                 int num_seqs) {
    __nram__ float nram_buf[BLOCK_SIZE];
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;
    int seqs_per_core = (num_seqs + core_num - 1) / core_num;
    int start = core_id * seqs_per_core;
    int end = start + seqs_per_core;
    if (end > num_seqs) end = num_seqs;

    for (int s = start; s < end; ++s) {
        int64_t base = offsets[s];
        float prefix = 0.0f;
        for (int blk = 0; blk < dim_size; blk += BLOCK_SIZE) {
            int len = dim_size - blk;
            if (len > BLOCK_SIZE) len = BLOCK_SIZE;
            int64_t addr = base + blk * stride_dim;
            __memcpy(nram_buf, input + addr, len * sizeof(float), GDRAM2NRAM);
            for (int i = 0; i < len; ++i) {
                prefix += nram_buf[i];
                nram_buf[i] = prefix;
            }
            __memcpy(output + addr, nram_buf, len * sizeof(float), NRAM2GDRAM);
        }
    }
}

static std::vector<int64_t> compute_offsets(const torch::Tensor& t, int dim) {
    int ndim = t.dim();
    auto sizes = t.sizes();
    auto strides = t.strides();
    std::vector<int64_t> other_dims, other_strides;
    for (int d = 0; d < ndim; ++d) {
        if (d != dim) {
            other_dims.push_back(sizes[d]);
            other_strides.push_back(strides[d]);
        }
    }
    int rank = other_dims.size();
    if (rank == 0) return {0};
    int64_t num_seqs = 1;
    for (auto s : other_dims) num_seqs *= s;
    std::vector<int64_t> offsets(num_seqs);
    std::vector<int64_t> idx(rank, 0);
    for (int64_t seq = 0; seq < num_seqs; ++seq) {
        int64_t off = 0;
        for (int i = 0; i < rank; ++i) off += idx[i] * other_strides[i];
        offsets[seq] = off;
        for (int i = rank-1; i >= 0; --i) {
            if (++idx[i] < other_dims[i]) break;
            idx[i] = 0;
        }
    }
    return offsets;
}

torch::Tensor bang_func(torch::Tensor x, int dim) {
    int ndim = x.dim();
    if (dim < 0) dim += ndim;
    TORCH_CHECK(dim >= 0 && dim < ndim);
    x = x.contiguous();
    auto orig_dtype = x.scalar_type();
    torch::Tensor inp = (orig_dtype == torch::kFloat) ? x : x.to(torch::kFloat);
    auto out = torch::empty_like(inp);
    int64_t dim_size = inp.size(dim);
    int64_t stride_dim = inp.stride(dim);
    int64_t total = inp.numel();
    int64_t num_seqs = total / dim_size;
    auto offsets = compute_offsets(inp, dim);
    TORCH_CHECK(offsets.size() == (size_t)num_seqs);
    int64_t* dev_offsets = nullptr;
    cnrtMalloc((void**)&dev_offsets, num_seqs * sizeof(int64_t));
    cnrtMemcpy(dev_offsets, offsets.data(), num_seqs * sizeof(int64_t), CNRT_MEM_TRANS_DIR_HOST2DEV);
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim3 = {256, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;
    cumsum_kernel<<<dim3, ktype, queue>>>(
        inp.data_ptr<float>(),
        out.data_ptr<float>(),
        dev_offsets,
        (int)dim_size,
        stride_dim,
        (int)num_seqs
    );
    cnrtQueueSync(queue);  // 确保完成
    cnrtFree(dev_offsets);
    if (orig_dtype != torch::kFloat) return out.to(orig_dtype);
    return out;
}