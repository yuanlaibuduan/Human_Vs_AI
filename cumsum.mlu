#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>
#include <vector>

#define NRAM_SIZE 4096  // NRAM 大小（元素数量）

// 核函数：计算一维数组的前缀和
__mlu_entry__ void cumsum_kernel(
    float *input,
    float *output,
    int outer_size,      // 外部维度大小（dim 之前的维度乘积）
    int inner_size,      // 内部维度大小（dim 之后的维度乘积）
    int dim_size) {      // dim 维度的大小
    
    __nram__ float nram_data[NRAM_SIZE];
    __nram__ float nram_prefix[NRAM_SIZE];
    
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;
    
    // 总共有 outer_size * inner_size 个独立的序列需要处理
    int total_sequences = outer_size * inner_size;
    
    // 分配任务给不同的核
    int seq_per_core = total_sequences / core_num;
    int remainder = total_sequences % core_num;
    
    int start_seq = core_id * seq_per_core + (core_id < remainder ? core_id : remainder);
    int seq_count = seq_per_core + (core_id < remainder ? 1 : 0);
    
    for (int seq_idx = 0; seq_idx < seq_count; seq_idx++) {
        int seq_id = start_seq + seq_idx;
        
        // 计算当前序列在输入张量中的起始位置
        int outer_idx = seq_id / inner_size;
        int inner_idx = seq_id % inner_size;
        
        int base_idx = outer_idx * (dim_size * inner_size) + inner_idx;
        
        // 处理当前序列：对长度为 dim_size 的序列计算前缀和
        int remaining = dim_size;
        int offset = 0;
        float prefix_sum = 0.0f;
        
        while (remaining > 0) {
            int chunk_size = (remaining < NRAM_SIZE) ? remaining : NRAM_SIZE;
            int aligned_chunk_size = (chunk_size + 63) & ~63;
            
            // 从 GDRAM 读取数据到 NRAM
            __memcpy(
                nram_data,
                input + base_idx + offset * inner_size,
                chunk_size * sizeof(float),
                GDRAM2NRAM
            );
            
            // 计算前缀和
            float running_sum = prefix_sum;
            for (int i = 0; i < chunk_size; i++) {
                running_sum += nram_data[i];
                nram_prefix[i] = running_sum;
            }
            prefix_sum = running_sum;
            
            // 将结果写回 GDRAM
            __memcpy(
                output + base_idx + offset * inner_size,
                nram_prefix,
                chunk_size * sizeof(float),
                NRAM2GDRAM
            );
            
            remaining -= chunk_size;
            offset += chunk_size;
        }
    }
}

torch::Tensor bang_func(torch::Tensor x, int dim) {
    // 检查输入张量是否连续
    TORCH_CHECK(
        x.is_contiguous(),
        "Input tensor must be contiguous"
    );
    
    // 处理负数维度
    int ndim = x.dim();
    if (dim < 0) {
        dim += ndim;
    }
    TORCH_CHECK(
        dim >= 0 && dim < ndim,
        "Dimension out of range"
    );
    
    // 转换为 FP32
    auto original_dtype = x.scalar_type();
    torch::Tensor input_fp32 = x;
    if (original_dtype != torch::kFloat) {
        input_fp32 = x.to(torch::kFloat);
    }
    
    // 计算 outer_size, dim_size, inner_size
    auto sizes = input_fp32.sizes();
    std::vector<int64_t> shape(sizes.begin(), sizes.end());
    
    int64_t outer_size = 1;
    for (int i = 0; i < dim; i++) {
        outer_size *= shape[i];
    }
    
    int64_t dim_size = shape[dim];
    
    int64_t inner_size = 1;
    for (int i = dim + 1; i < ndim; i++) {
        inner_size *= shape[i];
    }
    
    // 创建输出张量
    auto output_fp32 = torch::empty_like(input_fp32);
    
    // 获取队列
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    
    // 配置核函数启动参数
    cnrtDim3_t dim_grid = {4, 1, 1};  // 使用4个核
    cnrtFunctionType_t kernel_type = cnrtFuncTypeUnion1;
    
    // 启动核函数
    cumsum_kernel<<<dim_grid, kernel_type, queue>>>(
        input_fp32.data_ptr<float>(),
        output_fp32.data_ptr<float>(),
        outer_size,
        inner_size,
        dim_size
    );
    
    // 同步等待完成
    cnrtQueueSync(queue);
    
    // 转换回原始数据类型
    if (original_dtype != torch::kFloat) {
        return output_fp32.to(original_dtype);
    }
    
    return output_fp32;
}