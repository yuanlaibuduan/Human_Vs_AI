#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

#define CHUNK_SIZE 1024

__mlu_entry__ void cumsum_kernel(
    const float* src,
    float* dst,
    int64_t outer,
    int64_t dim_len,
    int64_t inner
) {
    uint32_t core_id = taskId;
    uint32_t core_num = taskDim;

    int64_t task_per_core = outer / core_num;
    int64_t rem = outer % core_num;
    int64_t beg = core_id * task_per_core + (core_id < rem ? core_id : rem);
    int64_t end = beg + task_per_core + (core_id < rem ? 1 : 0);

    __nram__ float n_in[CHUNK_SIZE];
    __nram__ float n_acc[CHUNK_SIZE];
    __nram__ float n_out[CHUNK_SIZE];

    for (int64_t o = beg; o < end; ++o) {
        for (int64_t ib = 0; ib < inner; ib += CHUNK_SIZE) {
            int64_t cur_inner = inner - ib;
            cur_inner = cur_inner > CHUNK_SIZE ? CHUNK_SIZE : cur_inner;
            int64_t align_len = (cur_inner + 63) & ~63;

            for (int i = 0; i < align_len; ++i)
                n_acc[i] = 0.0f;

            for (int64_t d = 0; d < dim_len; ++d) {
                int64_t g_off = o * dim_len * inner + d * inner + ib;

                __memcpy(n_in, src + g_off, cur_inner * sizeof(float), GDRAM2NRAM);
                __bang_add(n_out, n_acc, n_in, align_len);
                __bang_move(n_acc, n_out, align_len);
                __memcpy(dst + g_off, n_out, cur_inner * sizeof(float), NRAM2GDRAM);
            }
        }
    }
}

torch::Tensor bang_func(torch::Tensor x, int dim) {
    TORCH_CHECK(x.is_contiguous(), "input must be contiguous");
    auto sizes = x.sizes();
    int ndim = sizes.size();
    if (dim < 0) dim += ndim;

    torch::Tensor x_fp32 = x.to(torch::kFloat);
    torch::Tensor out = torch::empty_like(x_fp32);

    int64_t outer = 1;
    for (int i = 0; i < dim; i++) outer *= sizes[i];
    int64_t dim_l = sizes[dim];
    int64_t inner = 1;
    for (int i = dim + 1; i < ndim; i++) inner *= sizes[i];

    cnrtQueue_t q = torch_mlu::getCurMLUStream();
    cnrtDim3_t grid = {16, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;

    cumsum_kernel<<<grid, ktype, q>>>(
        x_fp32.data_ptr<float>(),
        out.data_ptr<float>(),
        outer, dim_l, inner
    );

    return out.to(x.scalar_type());
}