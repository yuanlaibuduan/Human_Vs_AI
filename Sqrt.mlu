#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

#define CHUNK_SIZE 4096

// BangC核函数：逐元素 abs后开平方，全部FP32计算
__mlu_entry__ void sqrt_abs_kernel(
    float* input,
    float* output,
    int total_elem)
{
    // 多核任务切分
    uint32_t core_id = taskId;
    uint32_t core_cnt = taskDim;
    uint32_t per_core = total_elem / core_cnt;
    uint32_t remain_elem = total_elem % core_cnt;

    // 计算当前core负责的数据起始位置与元素数量
    uint32_t start_idx = core_id * per_core + (core_id < remain_elem ? core_id : remain_elem);
    uint32_t elem_cnt = per_core + (core_id < remain_elem ? 1 : 0);

    // NRAM缓冲区
    __nram__ float nram_in[CHUNK_SIZE];
    __nram__ float nram_abs[CHUNK_SIZE];
    __nram__ float nram_out[CHUNK_SIZE];

    for(uint32_t off = 0; off < elem_cnt; off += CHUNK_SIZE)
    {
        uint32_t cur_len = (off + CHUNK_SIZE <= elem_cnt) ? CHUNK_SIZE : (elem_cnt - off);
        uint32_t align_len = (cur_len + 63) & (~63); // 64字节对齐适配bang算子

        // GDRAM->NRAM拷贝输入数据
        __memcpy(nram_in, input + start_idx + off, cur_len * sizeof(float), GDRAM2NRAM);

        // 1.逐元素求绝对值
        __bang_abs(nram_abs, nram_in, align_len);
        // 2.对绝对值结果逐元素开平方根
        __bang_sqrt(nram_out, nram_abs, align_len);

        // NRAM->GDRAM回写结果
        __memcpy(output + start_idx + off, nram_out, cur_len * sizeof(float), NRAM2GDRAM);
    }
}

// 对外接口函数：固定名称bang_func，入参仅input，无额外初始化参数
torch::Tensor bang_func(torch::Tensor input)
{
    TORCH_CHECK(input.is_contiguous(), "Input tensor must be contiguous!");
    auto ori_dtype = input.scalar_type();

    // 统一转为FP32做算子内部计算
    torch::Tensor in_fp32 = (ori_dtype == torch::kFloat) ? input : input.to(torch::kFloat);
    torch::Tensor out_fp32 = torch::empty_like(in_fp32);

    int total_num = in_fp32.numel();
    cnrtQueue_t mlu_queue = torch_mlu::getCurMLUStream();

    // MLU核调用配置
    cnrtDim3_t kernel_dim = {4, 1, 1};
    cnrtFunctionType_t func_type = cnrtFuncTypeUnion1;

    // 启动BangC核函数
    sqrt_abs_kernel<<<kernel_dim, func_type, mlu_queue>>>(
        in_fp32.data_ptr<float>(),
        out_fp32.data_ptr<float>(),
        total_num
    );

    // 还原原始输入数据类型
    if(ori_dtype != torch::kFloat)
        return out_fp32.to(ori_dtype);
    return out_fp32;
}