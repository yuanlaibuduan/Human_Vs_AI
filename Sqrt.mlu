#include <bang.h>
#include <torch/extension.h>
#include <cnrt.h>

#define CHUNK_SIZE 4096

__mlu_entry__ void sqrt_abs_kernel(float *input, float *output, int total) {
    __nram__ float nram_data[CHUNK_SIZE];
    
    for (int offset = 0; offset < total; offset += CHUNK_SIZE) {
        int len = (offset + CHUNK_SIZE <= total) ? CHUNK_SIZE : (total - offset);
        int aligned_len = (len + 63) & ~63;  // 对齐到64字节
        
        __memcpy(nram_data, input + offset, len * sizeof(float), GDRAM2NRAM);
        __bang_active_abs(nram_data, nram_data, aligned_len);
        __bang_active_sqrt(nram_data, nram_data, aligned_len);
        __memcpy(output + offset, nram_data, len * sizeof(float), NRAM2GDRAM);
    }
}

torch::Tensor bang_func(torch::Tensor input) {
    TORCH_CHECK(input.is_contiguous(), "Input must be contiguous");
    
    auto original_dtype = input.scalar_type();
    torch::Tensor input_fp32 = input;
    if (original_dtype != torch::kFloat) {
        input_fp32 = input.to(torch::kFloat);
    }
    
    auto output_fp32 = torch::empty_like(input_fp32);
    int total = input_fp32.numel();
    
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();
    cnrtDim3_t dim = {1, 1, 1};          // 单核，避免划分错误
    cnrtFunctionType_t ktype = cnrtFuncTypeUnion1;
    
    sqrt_abs_kernel<<<dim, ktype, queue>>>(
        input_fp32.data_ptr<float>(),
        output_fp32.data_ptr<float>(),
        total
    );
    
    cnrtQueueSync(queue);  // 关键：等待核函数完成
    
    if (original_dtype != torch::kFloat) {
        return output_fp32.to(original_dtype);
    }
    return output_fp32;
}