// 135_Dilated_conv_2D.mlu
// BangC implementation of 2D dilated convolution with padding.
// Input: x [batch, in_channels, H, W], kernel [out_channels, in_channels, kernel_size, kernel_size]
// Output: convolution result [batch, out_channels, H_out, W_out]

#include <bang.h>
#include <cnrt.h>
#include <torch/extension.h>

// -----------------------------------------------------------------------------
// Kernel: each thread computes one output element
// -----------------------------------------------------------------------------
__global__ void dilated_conv2d_kernel(
    const float* __restrict__ input,
    const float* __restrict__ kernel,
    float* __restrict__ output,
    int batch,
    int in_channels,
    int out_channels,
    int H_in, int W_in,
    int H_out, int W_out,
    int kernel_size,
    int dilation,
    int padding
) {
    int total = batch * out_channels * H_out * W_out;
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= total) return;

    // map linear index to (n, c_out, h, w)
    int n = idx / (out_channels * H_out * W_out);
    int rem = idx % (out_channels * H_out * W_out);
    int oc = rem / (H_out * W_out);
    rem = rem % (H_out * W_out);
    int oh = rem / W_out;
    int ow = rem % W_out;

    float sum = 0.0f;

    // loop over input channels
    for (int ic = 0; ic < in_channels; ++ic) {
        // loop over kernel window (with dilation)
        for (int ky = 0; ky < kernel_size; ++ky) {
            int ih = oh + padding - dilation * ky;
            if (ih < 0 || ih >= H_in) continue;
            for (int kx = 0; kx < kernel_size; ++kx) {
                int iw = ow + padding - dilation * kx;
                if (iw < 0 || iw >= W_in) continue;

                // input value
                float in_val = input[n * in_channels * H_in * W_in +
                                     ic * H_in * W_in +
                                     ih * W_in + iw];
                // kernel weight
                float k_val = kernel[oc * in_channels * kernel_size * kernel_size +
                                     ic * kernel_size * kernel_size +
                                     ky * kernel_size + kx];
                sum += in_val * k_val;
            }
        }
    }

    // write output
    output[n * out_channels * H_out * W_out +
           oc * H_out * W_out +
           oh * W_out + ow] = sum;
}

// -----------------------------------------------------------------------------
// Host wrapper called from PyTorch
// -----------------------------------------------------------------------------
torch::Tensor bang_func(torch::Tensor x,
                        torch::Tensor kernel,
                        int in_channels,
                        int out_channels,
                        int kernel_size,
                        int dilation,
                        int padding) {
    // Move inputs to MLU device and convert to float32 if necessary
    if (!x.is_mlu()) x = x.to(torch::kMLU);
    if (!kernel.is_mlu()) kernel = kernel.to(torch::kMLU);
    x = x.to(torch::kFloat);
    kernel = kernel.to(torch::kFloat);

    // Input dimensions
    auto sizes = x.sizes();
    int batch = sizes[0];
    int H_in = sizes[2];
    int W_in = sizes[3];

    // Output spatial dimensions (stride = 1)
    int H_out = H_in + 2 * padding - dilation * (kernel_size - 1);
    int W_out = W_in + 2 * padding - dilation * (kernel_size - 1);

    // Allocate output tensor on MLU
    torch::Tensor output = torch::empty({batch, out_channels, H_out, W_out},
                                        x.options().dtype(torch::kFloat));

    // Raw pointers
    const float* input_ptr = x.data_ptr<float>();
    const float* kernel_ptr = kernel.data_ptr<float>();
    float* output_ptr = output.data_ptr<float>();

    // Launch configuration
    int total = batch * out_channels * H_out * W_out;
    int threads = 256;
    int blocks = (total + threads - 1) / threads;

    // Obtain current MLU stream (queue) - use the recommended API
    auto queue = torch_mlu::getCurMLUStream();

    // Launch kernel
    dilated_conv2d_kernel<<<blocks, threads, 0, queue.stream()>>>(
        input_ptr, kernel_ptr, output_ptr,
        batch, in_channels, out_channels,
        H_in, W_in, H_out, W_out,
        kernel_size, dilation, padding
    );

    // Synchronize (optional, but ensures correctness for simple test)
    cnrtQueueSync(queue.stream());

    return output;
}