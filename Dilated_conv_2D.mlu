// 135_Dilated_conv_2D.mlu
// BangC implementation of 2D dilated convolution with padding.
// Input: x [batch, in_channels, H, W], kernel [out_channels, in_channels, kernel_size, kernel_size]
// Output: convolution result [batch, out_channels, H_out, W_out]

#include <bang.h>
#include <cnrt.h>
#include <torch/extension.h>

// -----------------------------------------------------------------------------
// MLU kernel: each task computes one output element
// -----------------------------------------------------------------------------
__mlu_global__ void dilated_conv2d_kernel(
    const float* input,
    const float* kernel,
    float* output,
    int batch,
    int in_channels,
    int out_channels,
    int H_in, int W_in,
    int H_out, int W_out,
    int kernel_size,
    int dilation,
    int padding
) {
    int total = batch * out_channels * H_out * W_out;
    int idx = taskId;   // BangC built-in variable for global task index
    if (idx >= total) return;

    // map linear index to (n, c_out, h, w)
    int n = idx / (out_channels * H_out * W_out);
    int rem = idx % (out_channels * H_out * W_out);
    int oc = rem / (H_out * W_out);
    rem = rem % (H_out * W_out);
    int oh = rem / W_out;
    int ow = rem % W_out;

    float sum = 0.0f;

    // loop over input channels
    for (int ic = 0; ic < in_channels; ++ic) {
        // loop over kernel window with dilation
        for (int ky = 0; ky < kernel_size; ++ky) {
            int ih = oh + padding - dilation * ky;
            if (ih < 0 || ih >= H_in) continue;
            for (int kx = 0; kx < kernel_size; ++kx) {
                int iw = ow + padding - dilation * kx;
                if (iw < 0 || iw >= W_in) continue;

                // input value
                float in_val = input[n * in_channels * H_in * W_in +
                                     ic * H_in * W_in +
                                     ih * W_in + iw];
                // kernel weight
                float k_val = kernel[oc * in_channels * kernel_size * kernel_size +
                                     ic * kernel_size * kernel_size +
                                     ky * kernel_size + kx];
                sum += in_val * k_val;
            }
        }
    }

    // write output
    output[n * out_channels * H_out * W_out +
           oc * H_out * W_out +
           oh * W_out + ow] = sum;
}

// -----------------------------------------------------------------------------
// Host wrapper
// -----------------------------------------------------------------------------
torch::Tensor bang_func(torch::Tensor x,
                        torch::Tensor kernel,
                        int in_channels,
                        int out_channels,
                        int kernel_size,
                        int dilation,
                        int padding) {
    // Ensure inputs are on MLU and float32
    x = x.contiguous();
    kernel = kernel.contiguous();
    if (x.device().type() != torch::kMLU) x = x.to(torch::kMLU);
    if (kernel.device().type() != torch::kMLU) kernel = kernel.to(torch::kMLU);
    x = x.to(torch::kFloat);
    kernel = kernel.to(torch::kFloat);

    // Input dimensions
    int batch = x.size(0);
    int H_in = x.size(2);
    int W_in = x.size(3);

    // Output spatial dimensions (stride = 1)
    int H_out = H_in + 2 * padding - dilation * (kernel_size - 1);
    int W_out = W_in + 2 * padding - dilation * (kernel_size - 1);

    // Allocate output tensor on MLU
    torch::Tensor output = torch::empty({batch, out_channels, H_out, W_out},
                                        x.options().dtype(torch::kFloat));

    // Get raw pointers
    const float* input_ptr = x.data_ptr<float>();
    const float* kernel_ptr = kernel.data_ptr<float>();
    float* output_ptr = output.data_ptr<float>();

    // Compute grid size: one task per output element
    int total_tasks = batch * out_channels * H_out * W_out;
    int tasks_per_cluster = 1024;  // typical value for MLU
    cnrtDim3_t dim;
    dim.x = (total_tasks + tasks_per_cluster - 1) / tasks_per_cluster;
    dim.y = 1;
    dim.z = 1;
    cnrtFunctionType_t func_type = CNRT_FUNC_TYPE_BLOCK;
    cnrtQueue_t queue = torch_mlu::getCurMLUStream().stream();

    // Prepare kernel arguments
    void* args[] = {
        (void*)&input_ptr,
        (void*)&kernel_ptr,
        (void*)&output_ptr,
        (void*)&batch,
        (void*)&in_channels,
        (void*)&out_channels,
        (void*)&H_in,
        (void*)&W_in,
        (void*)&H_out,
        (void*)&W_out,
        (void*)&kernel_size,
        (void*)&dilation,
        (void*)&padding
    };

    // Launch kernel
    CNRT_CHECK(cnrtInvokeKernel_V2(
        (void*)&dilated_conv2d_kernel,
        func_type,
        dim,
        tasks_per_cluster,
        args,
        13,          // number of arguments
        nullptr,
        queue));

    // Optional: synchronize (usually caller handles)
    cnrtQueueSync(queue);

    return output;
}